#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

if (($# != 4)); then
  printf '%s\n' \
    'Usage: verify-denial-published-repositories SIGNED_ROOT FINGERPRINT VERSION RELEASE' \
    >&2
  exit 2
fi

"$SCRIPT_DIR/verify-denial-published-repositories-common" "$@"
"$SCRIPT_DIR/verify-denial-published-rpm-repository" "$@"

printf 'Verified Pacman, APT, DNF, and direct-download publication: %s\n' \
  "$1"
