#!/usr/bin/env bash
set -euo pipefail

fail() {
  printf 'verify-denial-published-repositories: %s\n' "$*" >&2
  exit 1
}

if (($# != 4)); then
  printf '%s\n' \
    'Usage: verify-denial-published-repositories SIGNED_ROOT FINGERPRINT VERSION RELEASE' \
    >&2
  exit 2
fi

for command_name in \
  apt-cache apt-get awk basename bsdtar cat cmp dnf dpkg-deb find gpg \
  gpgconf grep install mktemp paste realpath rm rpm rpmkeys sha256sum sort wc; do
  command -v "$command_name" >/dev/null 2>&1 \
    || fail "$command_name is required"
done

SIGNED_ROOT="$(realpath -e -- "$1")"
FINGERPRINT="${2^^}"
VERSION="$3"
RELEASE="$4"
readonly SIGNED_ROOT FINGERPRINT VERSION RELEASE

[[ "$FINGERPRINT" =~ ^[0-9A-F]{40,64}$ ]] \
  || fail 'fingerprint must be a complete OpenPGP fingerprint'
[[ "$VERSION" =~ ^[0-9][0-9A-Za-z.+~]*$ && "$VERSION" != *-* ]] \
  || fail 'version is not valid for both Debian and RPM metadata'
[[ "$RELEASE" =~ ^[0-9]+$ ]] \
  || fail 'release must be numeric'
[[ -f "$SIGNED_ROOT/denial-repo-key.asc" ]] \
  || fail 'repository public key is missing'
[[ -f "$SIGNED_ROOT/SHA256SUMS" \
  && -f "$SIGNED_ROOT/SHA256SUMS.sig" ]] \
  || fail 'signed repository checksum manifest is incomplete'

work_root="$(
  mktemp -d "${TMPDIR:-/tmp}/denial-publish-verify.XXXXXX"
)"
cleanup() {
  gpgconf --homedir "$work_root/gnupg" --kill all >/dev/null 2>&1 || true
  if [[ "$work_root" == \
    "${TMPDIR:-/tmp}"/denial-publish-verify.* ]]; then
    rm -rf --one-file-system -- "$work_root"
  fi
}
trap cleanup EXIT

export GNUPGHOME="$work_root/gnupg"
install -d -m 0700 "$GNUPGHOME"
actual_fingerprint="$(
  gpg \
    --batch \
    --show-keys \
    --with-colons \
    --fingerprint \
    "$SIGNED_ROOT/denial-repo-key.asc" \
    | awk -F: '$1 == "fpr" { print toupper($10); exit }'
)"
[[ "$actual_fingerprint" == "$FINGERPRINT" ]] \
  || fail "public key fingerprint is $actual_fingerprint"
gpg --batch --import "$SIGNED_ROOT/denial-repo-key.asc"
if gpg --batch --list-secret-keys 2>/dev/null | grep -q .; then
  fail 'verification keyring unexpectedly contains a secret key'
fi

(
  cd "$SIGNED_ROOT"
  sha256sum --check --strict SHA256SUMS
  gpg --batch --verify SHA256SUMS.sig SHA256SUMS
)

mapfile -d '' direct_packages < <(
  find \
    "$SIGNED_ROOT/x86_64" \
    "$SIGNED_ROOT/downloads/x86_64" \
    -maxdepth 1 \
    -type f \
    \( -name '*.pkg.tar.zst' -o -name '*.deb' -o -name '*.rpm' \) \
    -print0 \
    | sort -z
)
((${#direct_packages[@]} == 7)) \
  || fail "expected seven direct packages, found ${#direct_packages[@]}"
for signed_file in \
  "${direct_packages[@]}" \
  "$SIGNED_ROOT/x86_64/denial.db.tar.zst" \
  "$SIGNED_ROOT/x86_64/denial.files.tar.zst"; do
  [[ -f "$signed_file" && -f "${signed_file}.sig" ]] \
    || fail "detached signature is missing for $signed_file"
  gpg --batch --verify "${signed_file}.sig" "$signed_file"
done

mapfile -d '' apt_packages < <(
  find "$SIGNED_ROOT/apt/pool/main/d/denial" \
    -maxdepth 1 -type f -name '*.deb' -print0 | sort -z
)
((${#apt_packages[@]} == 2)) \
  || fail "expected two APT pool packages, found ${#apt_packages[@]}"
for package in "${apt_packages[@]}"; do
  direct="$SIGNED_ROOT/downloads/x86_64/$(basename -- "$package")"
  [[ -f "$direct" ]] || fail "direct Debian download is missing: $direct"
  cmp -- "$package" "$direct"
  [[ "$(dpkg-deb --field "$package" Version)" == "$VERSION-$RELEASE" ]] \
    || fail "APT pool package has the wrong version: $package"
  [[ "$(dpkg-deb --field "$package" Architecture)" == amd64 ]] \
    || fail "APT pool package has the wrong architecture: $package"
done

for suite in trixie noble; do
  release_root="$SIGNED_ROOT/apt/dists/$suite"
  [[ -f "$release_root/Release" \
    && -f "$release_root/InRelease" \
    && -f "$release_root/Release.gpg" ]] \
    || fail "$suite signed Release metadata is incomplete"
  gpg --batch --verify "$release_root/InRelease"
  gpg --batch --verify "$release_root/Release.gpg" "$release_root/Release"
  awk '
    $0 == "SHA256:" { in_sha256 = 1; next }
    in_sha256 && /^[A-Za-z0-9]/ { exit }
    in_sha256 && NF == 3 { print $1 "  " $3 }
  ' "$release_root/Release" >"$work_root/$suite.SHA256SUMS"
  [[ "$(wc -l <"$work_root/$suite.SHA256SUMS")" == 3 ]] \
    || fail "$suite Release metadata has an unexpected SHA256 file set"
  (
    cd "$release_root"
    sha256sum --check --strict "$work_root/$suite.SHA256SUMS"
  )

  packages_index="$release_root/main/binary-amd64/Packages"
  [[ "$(grep -c '^Package: ' "$packages_index")" == 2 ]] \
    || fail "$suite Packages index does not contain exactly two packages"
  for package in "${apt_packages[@]}"; do
    relative="pool/main/d/denial/$(basename -- "$package")"
    checksum="$(sha256sum "$package" | awk '{ print $1 }')"
    grep -Fxq "Filename: $relative" "$packages_index" \
      || fail "$suite Packages index omits $relative"
    grep -Fxq "SHA256: $checksum" "$packages_index" \
      || fail "$suite Packages index has the wrong checksum for $relative"
  done
done
cmp -- \
  "$SIGNED_ROOT/apt/dists/trixie/main/binary-amd64/Packages" \
  "$SIGNED_ROOT/apt/dists/noble/main/binary-amd64/Packages"

apt_root="$work_root/apt-client"
install -d -m 0755 \
  "$apt_root/state/lists/partial" \
  "$apt_root/cache/archives/partial" \
  "$apt_root/etc"
install -m 0644 "$SIGNED_ROOT/denial-repo-key.asc" "$apt_root/key.asc"
cat >"$apt_root/etc/sources.list" <<EOF
deb [arch=amd64 signed-by=$apt_root/key.asc] file:$SIGNED_ROOT/apt trixie main
deb [arch=amd64 signed-by=$apt_root/key.asc] file:$SIGNED_ROOT/apt noble main
EOF
apt_options=(
  -o Debug::NoLocking=true
  -o "Dir::Etc::sourcelist=$apt_root/etc/sources.list"
  -o 'Dir::Etc::sourceparts=-'
  -o "Dir::State=$apt_root/state"
  -o 'Dir::State::status=/dev/null'
  -o "Dir::Cache=$apt_root/cache"
  -o 'Acquire::Languages=none'
)
apt-get "${apt_options[@]}" update
apt_names="$(
  apt-cache "${apt_options[@]}" show denial denial-flutter-engine \
    | awk '/^Package: / { print $2 }' \
    | sort -u \
    | paste -sd' ' -
)"
[[ "$apt_names" == 'denial denial-flutter-engine' ]] \
  || fail "APT client resolved the wrong package set: $apt_names"

rpm_repository="$SIGNED_ROOT/rpm/fedora/44/x86_64"
repomd="$rpm_repository/repodata/repomd.xml"
[[ -f "$repomd" && -f "$repomd.asc" ]] \
  || fail 'signed DNF repomd.xml is incomplete'
gpg --batch --verify "$repomd.asc" "$repomd"

rpm_db="$work_root/rpm-db"
install -d -m 0700 "$rpm_db"
rpmkeys --dbpath "$rpm_db" --import "$SIGNED_ROOT/denial-repo-key.asc"
mapfile -d '' repository_rpms < <(
  find "$rpm_repository/Packages" \
    -maxdepth 1 -type f -name '*.rpm' -print0 | sort -z
)
((${#repository_rpms[@]} == 2)) \
  || fail "expected two DNF packages, found ${#repository_rpms[@]}"
for package in "${repository_rpms[@]}"; do
  direct="$SIGNED_ROOT/downloads/x86_64/$(basename -- "$package")"
  [[ -f "$direct" ]] || fail "direct RPM download is missing: $direct"
  cmp -- "$package" "$direct"
  rpmkeys --dbpath "$rpm_db" --checksig --verbose "$package" \
    | grep -Eiq 'signature.*: OK'
  [[ "$(rpm --dbpath "$rpm_db" -qp --qf '%{VERSION}-%{RELEASE}' "$package")" \
    == "$VERSION-$RELEASE" ]] \
    || fail "DNF package has the wrong version: $package"
done

dnf_root="$work_root/dnf-client"
install -d -m 0755 "$dnf_root"
dnf \
  --assumeyes \
  --installroot "$dnf_root" \
  --releasever 44 \
  --forcearch x86_64 \
  --setopt "cachedir=$work_root/dnf-cache" \
  --setopt "persistdir=$work_root/dnf-persist" \
  --setopt reposdir=/dev/null \
  --setopt plugins=0 \
  --repofrompath "denial,file://$rpm_repository" \
  --setopt denial.gpgcheck=1 \
  --setopt denial.repo_gpgcheck=1 \
  --setopt "denial.gpgkey=file://$SIGNED_ROOT/denial-repo-key.asc" \
  --repo denial \
  makecache
dnf_names="$(
  dnf \
    --quiet \
    --installroot "$dnf_root" \
    --releasever 44 \
    --forcearch x86_64 \
    --setopt "cachedir=$work_root/dnf-cache" \
    --setopt "persistdir=$work_root/dnf-persist" \
    --setopt reposdir=/dev/null \
    --setopt plugins=0 \
    --repofrompath "denial,file://$rpm_repository" \
    --setopt denial.gpgcheck=1 \
    --setopt denial.repo_gpgcheck=1 \
    --setopt "denial.gpgkey=file://$SIGNED_ROOT/denial-repo-key.asc" \
    --repo denial \
    repoquery \
    --available \
    --qf '%{name}' \
    denial denial-flutter-engine \
    | sort -u \
    | paste -sd' ' -
)"
[[ "$dnf_names" == 'denial denial-flutter-engine' ]] \
  || fail "DNF client resolved the wrong package set: $dnf_names"

unexpected_entry="$(find "$SIGNED_ROOT" ! -type d ! -type f -print -quit)"
[[ -z "$unexpected_entry" ]] \
  || fail "repository contains an unsupported entry: $unexpected_entry"

printf 'Verified Pacman, APT, DNF, and direct-download publication: %s\n' \
  "$SIGNED_ROOT"
