#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
DESTINATION="$ROOT/packages/denial_flutter_sdk/assets/cursors/bibata_modern_ice"
MANIFEST="$ROOT/packages/denial_flutter_sdk/assets/cursors/bibata_modern_ice.sha256"

LINUX_SHA256='a68cae60c4dc706350e194ebc91c5fe48bc7bc9d59e119555834a2a7ee5078ef'
WINDOWS_SHA256='0045e40324da5b540b3bee260f53d0792df62be9cdef91655a024ae9f151bd04'

usage() {
  printf 'Usage: %s BIBATA_MODERN_ICE_TAR_XZ BIBATA_MODERN_ICE_WINDOWS_ZIP\n' \
    "$0" >&2
}

if [[ "$#" -ne 2 ]]; then
  usage
  exit 2
fi

for command in \
  awk bsdtar find icotool install realpath sha256sum sort wc xargs xcur2png
do
  command -v "$command" >/dev/null 2>&1 \
    || {
      printf 'import-bibata-cursor: missing command: %s\n' "$command" >&2
      exit 1
    }
done

LINUX_ARCHIVE="$(realpath -e -- "$1")"
WINDOWS_ARCHIVE="$(realpath -e -- "$2")"

verify_sha256() {
  local archive="$1"
  local expected="$2"
  local actual

  actual="$(sha256sum -- "$archive" | awk '{print $1}')"
  [[ "$actual" == "$expected" ]] \
    || {
      printf 'import-bibata-cursor: SHA-256 mismatch for %s\n' "$archive" >&2
      printf '  expected: %s\n  actual:   %s\n' "$expected" "$actual" >&2
      exit 1
    }
}

verify_sha256 "$LINUX_ARCHIVE" "$LINUX_SHA256"
verify_sha256 "$WINDOWS_ARCHIVE" "$WINDOWS_SHA256"

WORK="$(mktemp -d)"
trap 'rm -rf -- "$WORK"' EXIT
install -d -- "$WORK/linux" "$WORK/windows" "$WORK/stage"
bsdtar -xf "$LINUX_ARCHIVE" -C "$WORK/linux"
bsdtar -xf "$WINDOWS_ARCHIVE" -C "$WORK/windows"

XCURSOR_ROOT="$WORK/linux/Bibata-Modern-Ice/cursors"
WINDOWS_ROOT="$WORK/windows/Bibata-Modern-Ice-Regular-Windows"
[[ -d "$XCURSOR_ROOT" && -d "$WINDOWS_ROOT" ]] \
  || {
    printf 'import-bibata-cursor: unexpected upstream archive layout\n' >&2
    exit 1
  }

# Every role is imported at 32 px, its native size, and at the larger sizes
# below. A larger size lands in ROLE/SIZE/ beside the 32 px frame, and its
# hotspot is checked against the one cursor_themes.dart declares for it.
LARGER_SIZES=(48 64 96)

extract_xcursor_frame() {
  local role="$1"
  local source_name="$2"
  shift 2
  local extraction_root="$WORK/extracted/$role"
  local config="$WORK/$role.conf"
  local wanted
  local size
  local hotspot_x
  local hotspot_y
  local image_name
  local target

  install -d -- "$extraction_root" "$WORK/stage/$role"
  xcur2png \
    --quiet \
    --directory "$extraction_root" \
    --conf "$config" \
    "$XCURSOR_ROOT/$source_name" >/dev/null 2>&1
  for wanted in 32 "${LARGER_SIZES[@]}"; do
    # The first frame of each size: animated upstream cursors stay static.
    read -r size hotspot_x hotspot_y image_name < <(
      awk -v wanted="$wanted" '$1 == wanted { print $1, $2, $3, $4; exit }' \
        "$config"
    )
    [[ "$size" == "$wanted" \
      && "$hotspot_x,$hotspot_y" == "$1" \
      && -f "$image_name" ]] \
      || {
        printf 'import-bibata-cursor: unexpected %s %spx frame metadata\n' \
          "$role" "$wanted" >&2
        exit 1
      }
    shift
    target="$WORK/stage/$role"
    [[ "$wanted" == 32 ]] || target="$target/$wanted"
    install -d -- "$target"
    install -m644 -- "$image_name" "$target/00.png"
  done
}

# Role, XCursor name, then the hotspot at 32, 48, 64 and 96 px.
while read -r role source_name hotspots; do
  # shellcheck disable=SC2086
  extract_xcursor_frame "$role" "$source_name" $hotspots
done <<'ROLE_MAP'
normal left_ptr 6,2 10,3 13,4 20,6
help question_arrow 5,10 7,16 10,21 15,32
working left_ptr_watch 6,2 10,3 13,4 20,6
text xterm 16,16 24,24 32,32 48,48
link hand2 14,2 21,3 28,4 42,6
busy wait 16,16 24,24 32,32 48,48
precision crosshair 16,16 24,24 32,32 48,48
handwriting pencil 5,26 8,39 11,52 17,79
unavailable crossed_circle 16,16 24,24 32,32 48,48
vertical_resize sb_v_double_arrow 16,16 24,24 32,32 48,48
horizontal_resize sb_h_double_arrow 16,16 24,24 32,32 48,48
diagonal_nwse bd_double_arrow 16,16 24,24 32,32 48,48
diagonal_nesw fd_double_arrow 16,16 24,24 32,32 48,48
move move 16,16 24,24 32,32 48,48
alternate dnd-link 12,8 18,12 25,16 37,24
ROLE_MAP

# The Linux release has no person or pin cursor; the regular Windows release
# carries them at 32, 48, 64 and 96 px as its first four images.
extract_windows_frame() {
  local role="$1"
  local source_name="$2"
  local index=1
  local wanted
  local hotspot
  local listing
  local target
  local extraction_root="$WORK/extracted/$role"

  install -d -- "$extraction_root"
  icotool --extract --output="$extraction_root" "$WINDOWS_ROOT/$source_name"
  for wanted in 32 "${LARGER_SIZES[@]}"; do
    case "$wanted" in
      32) hotspot='--hotspot-x=4 --hotspot-y=1' ;;
      48) hotspot='--hotspot-x=6 --hotspot-y=2' ;;
      64) hotspot='--hotspot-x=9 --hotspot-y=2' ;;
      96) hotspot='--hotspot-x=13 --hotspot-y=4' ;;
    esac
    # icotool --list ignores --index, so read this image's own line.
    listing="$(
      icotool --list "$WINDOWS_ROOT/$source_name" \
        | grep -F -- "--index=$index "
    )"
    [[ "$listing" == *"--width=$wanted --height=$wanted"* \
      && "$listing" == *"$hotspot"* ]] \
      || {
        printf 'import-bibata-cursor: unexpected %s %spx frame metadata\n' \
          "$role" "$wanted" >&2
        exit 1
      }
    target="$WORK/stage/$role"
    [[ "$wanted" == 32 ]] || target="$target/$wanted"
    install -d -- "$target"
    # --extract ignores --index too: extract them all, take this one.
    install -m644 -- \
      "$extraction_root/${source_name%.cur}_${index}_${wanted}x${wanted}x32.png" \
      "$target/00.png"
    index=$((index + 1))
  done
}

extract_windows_frame person Person.cur
extract_windows_frame pin Pin.cur

frame_count="$(find "$WORK/stage" -type f -name '*.png' | wc -l)"
[[ "$frame_count" == 68 ]] \
  || {
    printf 'import-bibata-cursor: expected 68 frames, found %s\n' \
      "$frame_count" >&2
    exit 1
  }

rm -rf -- "$DESTINATION"
install -d -- "$(dirname -- "$DESTINATION")"
cp -a -- "$WORK/stage" "$DESTINATION"
(
  cd "$ROOT"
  find packages/denial_flutter_sdk/assets/cursors/bibata_modern_ice \
    -type f \
    -name '*.png' \
    -print0 \
    | LC_ALL=C sort -z \
    | xargs -0 sha256sum
) > "$MANIFEST"

printf 'Imported 17 unchanged Bibata Modern Ice roles at 32, 48, 64 and 96 px into %s\n' \
  "$DESTINATION"
printf 'Wrote frame manifest: %s\n' "$MANIFEST"
