#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"

fail() {
  printf 'test-denial-repository-generators: %s\n' "$*" >&2
  exit 1
}

if (($# < 3)); then
  printf '%s\n' \
    'Usage: test-denial-repository-generators VERSION RELEASE PACKAGE_ROOT...' \
    '' \
    'Each PACKAGE_ROOT holds the Debian and RPM packages of one architecture.' \
    >&2
  exit 2
fi

for command_name in \
  apt-cache apt-get awk cat cp gpg gpgconf grep install mktemp paste \
  realpath rm sort; do
  command -v "$command_name" >/dev/null 2>&1 \
    || fail "$command_name is required"
done

VERSION="$1"
RELEASE="$2"
readonly VERSION RELEASE
shift 2
package_roots=()
for package_root in "$@"; do
  package_roots+=("$(realpath -e -- "$package_root")")
done

work_root="$(mktemp -d "${TMPDIR:-/tmp}/drt.XXXXXX")"
cleanup() {
  gpgconf --homedir "$work_root/gnupg" --kill all >/dev/null 2>&1 || true
  if [[ "$work_root" == \
    "${TMPDIR:-/tmp}"/drt.* ]]; then
    rm -rf --one-file-system -- "$work_root"
  fi
}
trap cleanup EXIT

export GNUPGHOME="$work_root/gnupg"
install -d -m 0700 "$GNUPGHOME"
gpg \
  --batch \
  --passphrase '' \
  --quick-generate-key \
  'Denial disposable repository generator test' \
  ed25519 \
  sign \
  1d
fingerprint="$(
  gpg --batch --with-colons --fingerprint --list-secret-keys \
    | awk -F: '$1 == "fpr" { print toupper($10); exit }'
)"
[[ "$fingerprint" =~ ^[0-9A-F]{40,64}$ ]] \
  || fail 'disposable signing key has no complete fingerprint'
gpg --batch --armor --export "$fingerprint" >"$work_root/key.asc"

"$ROOT/tools/generate-denial-apt-repository" \
  "$work_root/apt" \
  "$fingerprint" \
  "$VERSION" \
  "$RELEASE" \
  "${package_roots[@]}"
"$ROOT/tools/generate-denial-dnf-repository" \
  "$work_root/rpm" \
  "$fingerprint" \
  "$work_root/key.asc" \
  "$VERSION" \
  "$RELEASE" \
  "${package_roots[@]}"

for suite in trixie noble; do
  release_root="$work_root/apt/dists/$suite"
  gpg --batch --verify "$release_root/InRelease"
  gpg --batch --verify "$release_root/Release.gpg" "$release_root/Release"
done

for rpm_repository in "$work_root"/rpm/fedora/44/*; do
  architecture="$(basename -- "$rpm_repository")"
  rpm_direct="$work_root/rpm-direct/$architecture"
  install -d -m 0755 "$rpm_direct"
  cp -a -- "$rpm_repository/Packages/." "$rpm_direct/"
  "$ROOT/tools/verify-denial-rpm-repository" \
    "$rpm_repository" \
    "$rpm_direct" \
    "$work_root/key.asc" \
    "$fingerprint" \
    "$VERSION" \
    "$RELEASE"
done

for binary_root in "$work_root"/apt/dists/trixie/main/binary-*; do
  architecture="${binary_root##*/binary-}"
  apt_root="$work_root/apt-client-$architecture"
  install -d -m 0755 \
    "$apt_root/state/lists/partial" \
    "$apt_root/cache/archives/partial" \
    "$apt_root/etc"
  install -m 0644 "$work_root/key.asc" "$apt_root/key.asc"
  printf '%s\n' \
    "deb [arch=$architecture signed-by=$apt_root/key.asc] file:$work_root/apt trixie main" \
    "deb [arch=$architecture signed-by=$apt_root/key.asc] file:$work_root/apt noble main" \
    >"$apt_root/etc/sources.list"
  apt_options=(
    -o Debug::NoLocking=true
    -o "APT::Architecture=$architecture"
    -o "APT::Architectures=$architecture"
    -o "Dir::Etc::sourcelist=$apt_root/etc/sources.list"
    -o 'Dir::Etc::sourceparts=-'
    -o "Dir::State=$apt_root/state"
    -o 'Dir::State::status=/dev/null'
    -o "Dir::Cache=$apt_root/cache"
    -o 'Acquire::Languages=none'
  )
  apt-get "${apt_options[@]}" update
  apt_names="$(
    apt-cache "${apt_options[@]}" show \
      denial denial-flutter-engine denial-plugin-manager \
      | awk '/^Package: / { print $2 }' \
      | sort -u \
      | paste -sd' ' -
  )"
  [[ "$apt_names" == 'denial denial-flutter-engine denial-plugin-manager' ]] \
    || fail "$architecture APT client resolved the wrong package set: $apt_names"
done

printf '\n' >>"$work_root/apt/dists/trixie/Release"
if gpg --batch --verify \
    "$work_root/apt/dists/trixie/Release.gpg" \
    "$work_root/apt/dists/trixie/Release" \
    >/dev/null 2>&1; then
  fail 'tampered APT Release metadata retained a valid signature'
fi
printf '\n' >>"$work_root/rpm/fedora/44/x86_64/repodata/repomd.xml"
if gpg --batch --verify \
    "$work_root/rpm/fedora/44/x86_64/repodata/repomd.xml.asc" \
    "$work_root/rpm/fedora/44/x86_64/repodata/repomd.xml" \
    >/dev/null 2>&1; then
  fail 'tampered DNF repository metadata retained a valid signature'
fi

printf 'APT and DNF repository generator tests passed.\n'
