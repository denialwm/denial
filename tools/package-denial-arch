#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"

CACHE_ROOT="${XDG_CACHE_HOME:-${HOME:?HOME is required}/.cache}"
BUILD_ROOT="${DENIAL_PC_BUILD_ROOT:-$CACHE_ROOT/denial/pc-build}"
RUST_TARGET="${DENIAL_PC_RUST_TARGET:-$BUILD_ROOT/rust}"
BINARY="${DENIAL_PC_BINARY:-$RUST_TARGET/release/deniald}"
CONTROL_BINARY="${DENIAL_PC_CONTROL_BINARY:-$RUST_TARGET/release/denialctl}"
PORTAL_BINARY="${DENIAL_PC_PORTAL_BINARY:-$RUST_TARGET/release/denial-portal}"
PACKAGE_ROOT="${DENIAL_PC_PACKAGE_ROOT:-$BUILD_ROOT/packages}"
MAKEPKG_ROOT="${DENIAL_PC_MAKEPKG_ROOT:-$BUILD_ROOT/makepkg}"
PACKAGE_INPUT_ROOT="${DENIAL_PC_PACKAGE_INPUT_ROOT:-$BUILD_ROOT/package-input}"
BUNDLE="${DENIAL_PC_BUNDLE:-$PACKAGE_INPUT_ROOT/bundle}"
BUNDLE_ASSEMBLY="${DENIAL_PC_BUNDLE_ASSEMBLY:-$PACKAGE_INPUT_ROOT/flutter-release}"
SETTINGS_BUNDLE="${DENIAL_PC_SETTINGS_BUNDLE:-$ROOT/settings_app/build/linux/x64/release/bundle}"
PACKAGE_RELEASE="${DENIAL_PACKAGE_RELEASE:-1}"
PACKAGE_PACKAGER="${DENIAL_PACKAGE_PACKAGER:-Doctor Logix <doctor.logix@gmail.com>}"
REBUILD_ENGINE_PACKAGE="${DENIAL_REBUILD_ENGINE_PACKAGE:-0}"
RELEASE_TAG="${DENIAL_RELEASE_TAG:-}"
REQUESTED_PACKAGE_VERSION="${DENIAL_PACKAGE_VERSION:-}"
REQUESTED_BUILD_IDENTITY="${DENIAL_BUILD_IDENTITY:-}"
RUNTIME_VERSION_FILE="${DENIAL_PACKAGE_RUNTIME_VERSION_FILE:-}"
ENGINE_PACKAGE_DIR="$ROOT/packaging/arch/flutter-engine"
DENIAL_PACKAGE_DIR="$ROOT/packaging/arch"

for required_command in bsdtar find makepkg mktemp rm; do
  command -v "$required_command" >/dev/null 2>&1 \
    || {
      printf 'package-denial-arch: %s is required\n' \
        "$required_command" >&2
      exit 1
    }
done
[[ "$REBUILD_ENGINE_PACKAGE" == 0 || "$REBUILD_ENGINE_PACKAGE" == 1 ]] \
  || {
    printf 'package-denial-arch: DENIAL_REBUILD_ENGINE_PACKAGE must be 0 or 1\n' >&2
    exit 1
  }

if [[ -n "$RELEASE_TAG" ]]; then
  [[ "$RELEASE_TAG" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] \
    || {
      printf \
        'package-denial-arch: release tag must have the form vMAJOR.MINOR.PATCH\n' \
        >&2
      exit 1
    }
  [[ "$(git -C "$ROOT" rev-parse "${RELEASE_TAG}^{commit}")" \
    == "$(git -C "$ROOT" rev-parse HEAD)" ]] \
    || {
      printf 'package-denial-arch: %s does not resolve to HEAD\n' \
        "$RELEASE_TAG" >&2
      exit 1
    }
  [[ -z "$(git -C "$ROOT" status --porcelain --untracked-files=normal)" ]] \
    || {
      printf 'package-denial-arch: release checkout is dirty\n' >&2
      exit 1
    }
  package_version="${RELEASE_TAG#v}"
  if [[ -n "$REQUESTED_PACKAGE_VERSION" \
    && "$REQUESTED_PACKAGE_VERSION" != "$package_version" ]]; then
    printf \
      'package-denial-arch: requested package version %s does not match tag version %s\n' \
      "$REQUESTED_PACKAGE_VERSION" "$package_version" >&2
    exit 1
  fi
  [[ "$PACKAGE_RELEASE" == 1 ]] \
    || {
      printf \
        'package-denial-arch: a version-tag release must use package release 1\n' \
        >&2
      exit 1
    }
else
  latest_release_tag=''
  while IFS= read -r candidate; do
    if [[ "$candidate" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
      latest_release_tag="$candidate"
      break
    fi
  done < <(
    git -C "$ROOT" tag \
      --merged HEAD \
      --list 'v*' \
      --sort=-v:refname
  )
  if [[ -n "$latest_release_tag" ]]; then
    development_base="${latest_release_tag#v}"
    revision_count="$(
      git -C "$ROOT" rev-list --count "${latest_release_tag}..HEAD"
    )"
  else
    development_base='0.0.0'
    revision_count="$(git -C "$ROOT" rev-list --count HEAD)"
  fi
  revision="$(git -C "$ROOT" rev-parse --short=8 HEAD)"
  package_version="$development_base.r$revision_count.g$revision"
  if [[ -n "$(git -C "$ROOT" status --porcelain --untracked-files=normal)" ]]; then
    package_version="$package_version.dirty"
  fi
fi

build_identity="${REQUESTED_BUILD_IDENTITY:-$package_version}"

DENIAL_BUILD_VERSION="$build_identity" \
DENIAL_PC_BUNDLE="$BUNDLE" \
DENIAL_PC_BUNDLE_ASSEMBLY="$BUNDLE_ASSEMBLY" \
  "$ROOT/tools/denial-pc" build

[[ -x "$BINARY" ]] \
  || {
    printf 'package-denial-arch: missing compositor: %s\n' "$BINARY" >&2
    exit 1
  }
[[ -x "$CONTROL_BINARY" ]] \
  || {
    printf 'package-denial-arch: missing control client: %s\n' \
      "$CONTROL_BINARY" >&2
    exit 1
  }
[[ -x "$PORTAL_BINARY" ]] \
  || {
    printf 'package-denial-arch: missing portal backend: %s\n' \
      "$PORTAL_BINARY" >&2
    exit 1
  }
[[ -f "$BUNDLE/data/icudtl.dat" \
  && -f "$BUNDLE/lib/libapp.so" \
  && -f "$BUNDLE/lib/libflutter_engine.so" ]] \
  || {
    printf 'package-denial-arch: incomplete Flutter bundle: %s\n' "$BUNDLE" >&2
    exit 1
  }
[[ -x "$SETTINGS_BUNDLE/denial-settings" \
  && -f "$SETTINGS_BUNDLE/data/flutter_assets/AssetManifest.bin" \
  && -f "$SETTINGS_BUNDLE/lib/libapp.so" \
  && -f "$SETTINGS_BUNDLE/lib/libflutter_linux_gtk.so" ]] \
  || {
    printf 'package-denial-arch: incomplete Settings bundle: %s\n' \
      "$SETTINGS_BUNDLE" >&2
    exit 1
  }

mkdir -p -- "$PACKAGE_ROOT" "$MAKEPKG_ROOT" "$MAKEPKG_ROOT/sources"

if [[ -z "$RUNTIME_VERSION_FILE" && -n "$RELEASE_TAG" ]]; then
  RUNTIME_VERSION_FILE="$PACKAGE_INPUT_ROOT/release-version"
  install -d -m 0755 "$(dirname -- "$RUNTIME_VERSION_FILE")"
  printf '%s\n' "$package_version" >"$RUNTIME_VERSION_FILE"
fi

export DENIAL_PACKAGE_SOURCE_ROOT="$ROOT"
export DENIAL_PACKAGE_BINARY="$BINARY"
export DENIAL_PACKAGE_CONTROL_BINARY="$CONTROL_BINARY"
export DENIAL_PACKAGE_PORTAL_BINARY="$PORTAL_BINARY"
export DENIAL_PACKAGE_BUNDLE="$BUNDLE"
export DENIAL_PACKAGE_SETTINGS_BUNDLE="$SETTINGS_BUNDLE"
export DENIAL_PACKAGE_ENGINE_SOURCE="$BUNDLE/lib/libflutter_engine.so"
export DENIAL_PACKAGE_VERSION="$package_version"
export DENIAL_PACKAGE_RELEASE="$PACKAGE_RELEASE"
if [[ -n "$RUNTIME_VERSION_FILE" ]]; then
  export DENIAL_PACKAGE_RUNTIME_VERSION_FILE="$RUNTIME_VERSION_FILE"
fi
export PKGDEST="$PACKAGE_ROOT"
export BUILDDIR="$MAKEPKG_ROOT"
export SRCDEST="$MAKEPKG_ROOT/sources"
export PACKAGER="$PACKAGE_PACKAGER"

engine_package="$(makepkg --dir "$ENGINE_PACKAGE_DIR" --packagelist)"
expected_engine_sha256="$(
  cut -d' ' -f1 \
    < "$ROOT/prebuilt/flutter-engine/linux-x64-release/libflutter_engine.so.sha256"
)"
expected_engine_package_version="1:${package_version}-${PACKAGE_RELEASE}"

validate_engine_package() {
  local package="$1"
  local packaged_engine_sha256

  [[ -f "$package" ]] \
    || {
      printf 'package-denial-arch: engine package is missing: %s\n' "$package" >&2
      return 1
    }
  bsdtar -xOf "$package" .PKGINFO \
    | grep -Fqx "pkgver = $expected_engine_package_version" \
    || {
      printf \
        'package-denial-arch: engine package version does not match %s\n' \
        "$expected_engine_package_version" >&2
      return 1
    }
  packaged_engine_sha256="$(
    bsdtar -xOf "$package" usr/lib/denial/flutter/lib/libflutter_engine.so \
      | sha256sum \
      | cut -d' ' -f1
  )"
  [[ "$packaged_engine_sha256" == "$expected_engine_sha256" ]] \
    || {
      printf 'package-denial-arch: engine package contains SHA-256 %s, expected %s\n' \
        "$packaged_engine_sha256" "$expected_engine_sha256" >&2
      return 1
    }
  bsdtar -xOf "$package" .PKGINFO \
    | grep -Fqx 'provides = denial-flutter-engine-abi=3.44.7.denial1' \
    || {
      printf 'package-denial-arch: engine package has the wrong ABI capability\n' >&2
      return 1
    }
}

validate_denial_package() (
  local package="$1"
  local asset_root
  local invalid_path
  local validation_root

  [[ -f "$package" ]] \
    || {
      printf 'package-denial-arch: Denial package is missing: %s\n' \
        "$package" >&2
      return 1
    }

  validation_root="$(mktemp -d "$MAKEPKG_ROOT/validate-denial.XXXXXX")"
  # Invoked indirectly by the EXIT trap below.
  # shellcheck disable=SC2329
  cleanup_validation() {
    if [[ "$validation_root" == "$MAKEPKG_ROOT"/validate-denial.* ]]; then
      rm -rf --one-file-system -- "$validation_root"
    fi
  }
  trap cleanup_validation EXIT

  # Preserve archive modes so the hardened runner's UMask=0077 does not alter
  # the evidence being checked.
  bsdtar -xpf "$package" -C "$validation_root"
  for executable in \
    deniald denialctl denial-portal denial-session denial-settings; do
    [[ -x "$validation_root/usr/bin/$executable" ]] \
      || {
        printf 'package-denial-arch: packaged executable is missing: usr/bin/%s\n' \
          "$executable" >&2
        return 1
      }
  done
  for portal_artifact in \
    usr/lib/systemd/user/denial-portal.service \
    usr/share/dbus-1/services/org.freedesktop.impl.portal.desktop.denial.service \
    usr/share/xdg-desktop-portal/denial-portals.conf \
    usr/share/xdg-desktop-portal/portals/denial.portal; do
    [[ -f "$validation_root/$portal_artifact" ]] \
      || {
        printf 'package-denial-arch: portal artifact is missing: %s\n' \
          "$portal_artifact" >&2
        return 1
      }
  done
  [[ -f "$validation_root/usr/share/man/man1/denial-portal.1" \
    || -f "$validation_root/usr/share/man/man1/denial-portal.1.gz" ]] \
    || {
      printf 'package-denial-arch: denial-portal manual page is missing\n' >&2
      return 1
    }
  grep -Fqx \
    'org.freedesktop.impl.portal.Settings=denial;gtk' \
    "$validation_root/usr/share/xdg-desktop-portal/denial-portals.conf" \
    || {
      printf 'package-denial-arch: Settings portal routing is invalid\n' >&2
      return 1
    }
  [[ -f "$validation_root/usr/lib/systemd/user/denial-session.target" ]] \
    && grep -Fqx 'BindsTo=graphical-session.target' \
      "$validation_root/usr/lib/systemd/user/denial-session.target" \
    || {
      printf 'package-denial-arch: graphical-session target is missing or invalid\n' >&2
      return 1
    }
  grep -Fqx 'depend = rtkit' "$validation_root/.PKGINFO" \
    || {
      printf 'package-denial-arch: Denial package does not require rtkit\n' >&2
      return 1
    }
  [[ -f "$validation_root/usr/share/man/man1/denialctl.1" \
    || -f "$validation_root/usr/share/man/man1/denialctl.1.gz" ]] \
    || {
      printf 'package-denial-arch: denialctl manual page is missing\n' >&2
      return 1
    }
  asset_root="$validation_root/usr/lib/denial/flutter/data/flutter_assets"
  [[ -d "$asset_root" ]] \
    || {
      printf 'package-denial-arch: packaged Flutter assets are missing\n' >&2
      return 1
    }

  invalid_path="$(
    find "$asset_root" -type d ! -perm 0755 -print -quit
  )"
  [[ -z "$invalid_path" ]] \
    || {
      printf \
        'package-denial-arch: packaged asset directory is not mode 0755: %s\n' \
        "${invalid_path#"$validation_root/"}" >&2
      return 1
    }

  invalid_path="$(
    find "$asset_root" -type f ! -perm 0644 -print -quit
  )"
  [[ -z "$invalid_path" ]] \
    || {
      printf \
        'package-denial-arch: packaged asset file is not mode 0644: %s\n' \
        "${invalid_path#"$validation_root/"}" >&2
      return 1
    }

  invalid_path="$(
    find "$asset_root" ! -type d ! -type f -print -quit
  )"
  [[ -z "$invalid_path" ]] \
    || {
      printf \
        'package-denial-arch: packaged assets contain an unexpected entry: %s\n' \
        "${invalid_path#"$validation_root/"}" >&2
      return 1
    }
)

if [[ ! -f "$engine_package" || "$REBUILD_ENGINE_PACKAGE" == 1 ]]; then
  makepkg \
    --dir "$ENGINE_PACKAGE_DIR" \
    --force \
    --cleanbuild \
    --clean \
    --noconfirm
  validate_engine_package "$engine_package"
else
  validate_engine_package "$engine_package"
  printf 'Reusing validated Flutter generation package: %s\n' "$engine_package"
fi

# The exact engine dependency is the package built immediately above, not a
# package installed into the developer's live Pacman root. Validate both
# package metadata records after the build and install them together in Stage 1.
makepkg \
  --dir "$DENIAL_PACKAGE_DIR" \
  --force \
  --cleanbuild \
  --clean \
  --nodeps \
  --noconfirm

denial_package="$(makepkg --dir "$DENIAL_PACKAGE_DIR" --packagelist)"
validate_denial_package "$denial_package"

printf '\nArch packages ready:\n'
printf '%s\n' "$engine_package"
printf '%s\n' "$denial_package"
