#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
# shellcheck source=lib/denial-architecture.sh
source "$SCRIPT_DIR/lib/denial-architecture.sh"

CACHE_ROOT="${XDG_CACHE_HOME:-${HOME:?HOME is required}/.cache}"
BUILD_ROOT="${DENIAL_PC_BUILD_ROOT:-$CACHE_ROOT/denial/pc-build}"
PACKAGE_ROOT="${DENIAL_PC_PACKAGE_ROOT:-$BUILD_ROOT/packages}"
MAKEPKG_ROOT="${DENIAL_PC_MAKEPKG_ROOT:-$BUILD_ROOT/makepkg}"
PACKAGE_INPUT_ROOT="${DENIAL_PC_PACKAGE_INPUT_ROOT:-$BUILD_ROOT/package-input}"
STAGE_ROOT="${DENIAL_PACKAGE_STAGE_ROOT:-$PACKAGE_INPUT_ROOT/native}"
PACKAGE_PACKAGER="${DENIAL_PACKAGE_PACKAGER:-Doctor Logix <doctor.logix@gmail.com>}"
REBUILD_ENGINE_PACKAGE="${DENIAL_REBUILD_ENGINE_PACKAGE:-0}"

ENGINE_PACKAGE_DIR="$ROOT/packaging/arch/flutter-engine"
DENIAL_PACKAGE_DIR="$ROOT/packaging/arch"
PLUGIN_MANAGER_PACKAGE_DIR="$ROOT/packaging/arch/plugin-manager"

for required_command in bsdtar find makepkg mktemp rm; do
  command -v "$required_command" >/dev/null 2>&1 \
    || {
      printf 'package-denial-arch: %s is required\n' \
        "$required_command" >&2
      exit 1
    }
done
[[ "$REBUILD_ENGINE_PACKAGE" == 0 || "$REBUILD_ENGINE_PACKAGE" == 1 ]] \
  || {
    printf 'package-denial-arch: DENIAL_REBUILD_ENGINE_PACKAGE must be 0 or 1\n' >&2
    exit 1
  }

if [[ "${DENIAL_PROMOTION_MODE:-0}" == 1 \
  && "${DENIAL_PACKAGE_SKIP_STAGE:-0}" != 1 ]]; then
  printf 'package-denial-arch: promotion requires DENIAL_PACKAGE_SKIP_STAGE=1\n' >&2
  exit 125
fi

# Build and stage once. Every package format must consume these same bytes,
# including the Flutter-tool snapshot whose compilation is not reproducible.
if [[ "${DENIAL_PACKAGE_SKIP_STAGE:-0}" != 1 ]]; then
  "$ROOT/tools/stage-denial-runtime"
fi
[[ -f "$STAGE_ROOT/metadata.json" ]] \
  || { printf 'package-denial-arch: missing staged metadata\n' >&2; exit 1; }
mapfile -t native_metadata < <(
  "$ROOT/tools/read-denial-native-metadata" "$STAGE_ROOT/metadata.json"
)
((${#native_metadata[@]} == 7)) \
  || { printf 'package-denial-arch: invalid staged metadata\n' >&2; exit 1; }
package_version="${native_metadata[0]}"
PACKAGE_RELEASE="${native_metadata[1]}"
export SOURCE_DATE_EPOCH="${native_metadata[3]}"
# The packages take the architecture of the binaries they carry.
CARCH="$(denial_elf_arch "$STAGE_ROOT/denial/usr/bin/deniald")"
export CARCH
case "$CARCH" in
  x86_64) engine_platform=linux-x64 ;;
  aarch64) engine_platform=linux-arm64 ;;
esac

# Every source lives in this checkout. makepkg keeps a file:// source it
# already copied, so a stale copy would fail validation after an edit.
rm -rf -- "$MAKEPKG_ROOT/sources"
mkdir -p -- "$PACKAGE_ROOT" "$MAKEPKG_ROOT" "$MAKEPKG_ROOT/sources"

export DENIAL_PACKAGE_SOURCE_ROOT="$ROOT"
export DENIAL_PACKAGE_VERSION="$package_version"
export DENIAL_PACKAGE_RELEASE="$PACKAGE_RELEASE"
export PKGDEST="$PACKAGE_ROOT"
export BUILDDIR="$MAKEPKG_ROOT"
export SRCDEST="$MAKEPKG_ROOT/sources"
export PACKAGER="$PACKAGE_PACKAGER"

engine_package="$(makepkg --dir "$ENGINE_PACKAGE_DIR" --packagelist)"
expected_engine_sha256="$(
  cut -d' ' -f1 \
    < "$ROOT/prebuilt/flutter-engine/$engine_platform-release/libflutter_engine.so.sha256"
)"
expected_engine_package_version="1:${package_version}-${PACKAGE_RELEASE}"

validate_engine_package() {
  local package="$1"
  local packaged_engine_sha256

  [[ -f "$package" ]] \
    || {
      printf 'package-denial-arch: engine package is missing: %s\n' "$package" >&2
      return 1
    }
  bsdtar -xOf "$package" .PKGINFO \
    | grep -Fqx "pkgver = $expected_engine_package_version" \
    || {
      printf \
        'package-denial-arch: engine package version does not match %s\n' \
        "$expected_engine_package_version" >&2
      return 1
    }
  packaged_engine_sha256="$(
    bsdtar -xOf "$package" usr/lib/denial/flutter/lib/libflutter_engine.so \
      | sha256sum \
      | cut -d' ' -f1
  )"
  [[ "$packaged_engine_sha256" == "$expected_engine_sha256" ]] \
    || {
      printf 'package-denial-arch: engine package contains SHA-256 %s, expected %s\n' \
        "$packaged_engine_sha256" "$expected_engine_sha256" >&2
      return 1
    }
  bsdtar -xOf "$package" .PKGINFO \
    | grep -Fqx 'provides = denial-flutter-engine-abi=3.47.5.denial1' \
    || {
      printf 'package-denial-arch: engine package has the wrong ABI capability\n' >&2
      return 1
    }
}

validate_denial_package() (
  local package="$1"
  local asset_root
  local invalid_path
  local validation_root

  [[ -f "$package" ]] \
    || {
      printf 'package-denial-arch: Denial package is missing: %s\n' \
        "$package" >&2
      return 1
    }

  validation_root="$(mktemp -d "$MAKEPKG_ROOT/validate-denial.XXXXXX")"
  # Invoked indirectly by the EXIT trap below.
  # shellcheck disable=SC2329
  cleanup_validation() {
    if [[ "$validation_root" == "$MAKEPKG_ROOT"/validate-denial.* ]]; then
      rm -rf --one-file-system -- "$validation_root"
    fi
  }
  trap cleanup_validation EXIT

  # Preserve archive modes so the hardened runner's UMask=0077 does not alter
  # the evidence being checked.
  bsdtar -xpf "$package" -C "$validation_root"
  for executable in \
    deniald denialctl denial-portal denial-session denial-settings; do
    [[ -x "$validation_root/usr/bin/$executable" ]] \
      || {
        printf 'package-denial-arch: packaged executable is missing: usr/bin/%s\n' \
          "$executable" >&2
        return 1
      }
  done
  for portal_artifact in \
    usr/lib/systemd/user/denial-portal.service \
    usr/share/dbus-1/services/org.freedesktop.impl.portal.desktop.denial.service \
    usr/share/xdg-desktop-portal/denial-portals.conf \
    usr/share/xdg-desktop-portal/portals/denial.portal; do
    [[ -f "$validation_root/$portal_artifact" ]] \
      || {
        printf 'package-denial-arch: portal artifact is missing: %s\n' \
          "$portal_artifact" >&2
        return 1
      }
  done
  for suspend_hook in \
    usr/lib/systemd/system-sleep/denial-suspend-mode \
    usr/lib/elogind/system-sleep/denial-suspend-mode; do
    [[ -x "$validation_root/$suspend_hook" ]] \
      || {
        printf 'package-denial-arch: suspend mode hook is missing: %s\n' \
          "$suspend_hook" >&2
        return 1
      }
    sh -n "$validation_root/$suspend_hook" \
      || {
        printf 'package-denial-arch: suspend mode hook does not parse: %s\n' \
          "$suspend_hook" >&2
        return 1
      }
  done
  [[ -f "$validation_root/usr/share/man/man1/denial-portal.1" \
    || -f "$validation_root/usr/share/man/man1/denial-portal.1.gz" ]] \
    || {
      printf 'package-denial-arch: denial-portal manual page is missing\n' >&2
      return 1
    }
  grep -Fqx \
    'org.freedesktop.impl.portal.Settings=denial;gtk' \
    "$validation_root/usr/share/xdg-desktop-portal/denial-portals.conf" \
    || {
      printf 'package-denial-arch: Settings portal routing is invalid\n' >&2
      return 1
    }
  session_target="$validation_root/usr/lib/systemd/user/denial-session.target"
  [[ -f "$session_target" ]] \
    || {
      printf 'package-denial-arch: graphical-session target is missing\n' >&2
      return 1
    }
  for directive in \
    'BindsTo=graphical-session.target' \
    'Before=graphical-session.target' \
    'Wants=graphical-session-pre.target' \
    'After=graphical-session-pre.target' \
    'Wants=xdg-desktop-autostart.target' \
    'Before=xdg-desktop-autostart.target'; do
    grep -Fqx "$directive" "$session_target" \
      || {
        printf \
          'package-denial-arch: graphical-session target is missing %s\n' \
          "$directive" >&2
        return 1
      }
  done
  grep -Fqx 'depend = rtkit' "$validation_root/.PKGINFO" \
    || {
      printf 'package-denial-arch: Denial package does not require rtkit\n' >&2
      return 1
    }
  [[ -f "$validation_root/usr/share/man/man1/denialctl.1" \
    || -f "$validation_root/usr/share/man/man1/denialctl.1.gz" ]] \
    || {
      printf 'package-denial-arch: denialctl manual page is missing\n' >&2
      return 1
    }
  asset_root="$validation_root/usr/lib/denial/flutter/data/flutter_assets"
  [[ -d "$asset_root" ]] \
    || {
      printf 'package-denial-arch: packaged Flutter assets are missing\n' >&2
      return 1
    }

  invalid_path="$(
    find "$asset_root" -type d ! -perm 0755 -print -quit
  )"
  [[ -z "$invalid_path" ]] \
    || {
      printf \
        'package-denial-arch: packaged asset directory is not mode 0755: %s\n' \
        "${invalid_path#"$validation_root/"}" >&2
      return 1
    }

  invalid_path="$(
    find "$asset_root" -type f ! -perm 0644 -print -quit
  )"
  [[ -z "$invalid_path" ]] \
    || {
      printf \
        'package-denial-arch: packaged asset file is not mode 0644: %s\n' \
        "${invalid_path#"$validation_root/"}" >&2
      return 1
    }

  invalid_path="$(
    find "$asset_root" ! -type d ! -type f -print -quit
  )"
  [[ -z "$invalid_path" ]] \
    || {
      printf \
        'package-denial-arch: packaged assets contain an unexpected entry: %s\n' \
        "${invalid_path#"$validation_root/"}" >&2
      return 1
    }
)

validate_plugin_manager_package() (
  local package="$1"
  local validation_root

  [[ -f "$package" ]] || {
    printf 'package-denial-arch: Plugin Manager package is missing: %s\n' \
      "$package" >&2
    return 1
  }
  validation_root="$(mktemp -d "$MAKEPKG_ROOT/validate-plugin-manager.XXXXXX")"
  trap 'rm -rf --one-file-system -- "$validation_root"' EXIT
  bsdtar -xpf "$package" -C "$validation_root"
  for executable in denial-plugin-manager denial-plugins; do
    [[ -x "$validation_root/usr/bin/$executable" ]] || {
      printf 'package-denial-arch: Plugin Manager executable is missing: %s\n' \
        "$executable" >&2
      return 1
    }
  done
  [[ -f "$validation_root/usr/lib/denial/plugin-build-kit/kit.json" ]] || {
    printf 'package-denial-arch: Plugin Manager build kit is missing\n' >&2
    return 1
  }
  [[ ! -e "$validation_root/usr/lib/denial/plugin-build-kit/flutter/bin/cache/dart-sdk" ]] || {
    printf 'package-denial-arch: Plugin Manager embeds the Dart SDK\n' >&2
    return 1
  }
  grep -Fqx 'depend = dart' "$validation_root/.PKGINFO" || {
    printf 'package-denial-arch: Plugin Manager does not require dart\n' >&2
    return 1
  }
  grep -Fqx "depend = denial=$package_version-$PACKAGE_RELEASE" \
    "$validation_root/.PKGINFO" || {
    printf 'package-denial-arch: Plugin Manager does not require matching Denial\n' >&2
    return 1
  }
)

if [[ ! -f "$engine_package" || "$REBUILD_ENGINE_PACKAGE" == 1 ]]; then
  DENIAL_PACKAGE_PAYLOAD_ROOT="$STAGE_ROOT/denial-flutter-engine" makepkg \
    --dir "$ENGINE_PACKAGE_DIR" \
    --force \
    --cleanbuild \
    --clean \
    --noconfirm
  validate_engine_package "$engine_package"
else
  validate_engine_package "$engine_package"
  printf 'Reusing validated Flutter generation package: %s\n' "$engine_package"
fi

# The exact engine dependency is the package built immediately above, not a
# package installed into the developer's live Pacman root. Validate both
# package metadata records after the build and install them together in Stage 1.
DENIAL_PACKAGE_PAYLOAD_ROOT="$STAGE_ROOT/denial" makepkg \
  --dir "$DENIAL_PACKAGE_DIR" \
  --force \
  --cleanbuild \
  --clean \
  --nodeps \
  --noconfirm

denial_package="$(makepkg --dir "$DENIAL_PACKAGE_DIR" --packagelist)"
DENIAL_PACKAGE_PAYLOAD_ROOT="$STAGE_ROOT/denial-plugin-manager" makepkg \
  --dir "$PLUGIN_MANAGER_PACKAGE_DIR" \
  --force \
  --cleanbuild \
  --clean \
  --nodeps \
  --noconfirm
plugin_manager_package="$(
  makepkg --dir "$PLUGIN_MANAGER_PACKAGE_DIR" --packagelist
)"
validate_denial_package "$denial_package"
validate_plugin_manager_package "$plugin_manager_package"

printf '\nArch packages ready:\n'
printf '%s\n' "$engine_package"
printf '%s\n' "$denial_package"
printf '%s\n' "$plugin_manager_package"
