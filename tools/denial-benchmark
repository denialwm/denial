#!/usr/bin/env python3
"""Run declarative Denial desktop benchmarks on the tablet (Python stdlib only).

All action deadlines and resource samples use the target's monotonic clock.
Existing applications receive normal close requests; refusal aborts the run.
"""
from __future__ import annotations

import argparse
import contextlib
