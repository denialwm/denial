#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/denial-architecture.sh
source "$SCRIPT_DIR/lib/denial-architecture.sh"

fail() {
  printf 'test-denial-architecture: %s\n' "$*" >&2
  exit 1
}

assert_mapping() {
  local input="$1"
  local canonical="$2"
  local flutter="$3"

  denial_arch_configure "$input" "$input"
  [[ "$DENIAL_ARCH" == "$canonical" ]] || fail "$input canonical mapping"
  [[ "$DENIAL_CROSS" == 0 && -z "$DENIAL_RUST_TARGET" ]] \
    || fail "$input native build was configured as a cross build"
  [[ "$DENIAL_FLUTTER_ARCH" == "$flutter" ]] || fail "$input Flutter mapping"
  [[ "$DENIAL_FLUTTER_PLATFORM" == "linux-$flutter" ]] \
    || fail "$input Flutter platform mapping"
  if [[ "$flutter" == x64 ]]; then
    [[ "$(denial_flutter_engine_target release)" == denial_host_release ]] \
      || fail "$input release engine target mapping"
  else
    [[ "$(denial_flutter_engine_target release)" == denial_host_release_arm64 ]] \
      || fail "$input release engine target mapping"
  fi
}

for alias in x86_64 amd64 x64; do
  assert_mapping "$alias" x86_64 x64
done
for alias in aarch64 arm64; do
  assert_mapping "$alias" aarch64 arm64
done

denial_arch_configure aarch64 x86_64
[[ "$DENIAL_CROSS" == 1 && "$DENIAL_ARCH" == aarch64 \
  && "$DENIAL_HOST_ARCH" == x86_64 ]] || fail 'cross mapping'
[[ "$DENIAL_RUST_TARGET" == aarch64-unknown-linux-gnu ]] \
  || fail 'cross Rust target mapping'
[[ "$DENIAL_FLUTTER_PLATFORM" == linux-arm64 \
  && "$DENIAL_HOST_FLUTTER_PLATFORM" == linux-x64 ]] \
  || fail 'cross Flutter platform mapping'
[[ "$(denial_flutter_engine_target release)" == denial_linux_arm64_release \
  && "$(denial_flutter_host_engine_target release)" == denial_host_release ]] \
  || fail 'cross engine target mapping'
DENIAL_TARGET_ARCH=arm64 denial_arch_configure '' x86_64
[[ "$DENIAL_CROSS" == 1 ]] || fail 'DENIAL_TARGET_ARCH did not select the target'
if denial_arch_configure x86_64 aarch64 2>/dev/null; then
  fail 'unsupported cross build was accepted'
fi

if denial_arch_configure riscv64 2>/dev/null; then
  fail 'unsupported architecture was accepted'
fi
if denial_flutter_engine_target invalid 2>/dev/null; then
  fail 'unsupported engine mode was accepted'
fi

printf 'Architecture mappings passed.\n'
