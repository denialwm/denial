#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"

fail() {
  printf 'generate-denial-dnf-repository: %s\n' "$*" >&2
  exit 1
}

if (($# != 6)); then
  printf '%s\n' \
    'Usage: generate-denial-dnf-repository PACKAGE_ROOT OUTPUT_ROOT FINGERPRINT PUBLIC_KEY VERSION RELEASE' \
    >&2
  exit 2
fi

for command_name in \
  basename bsdtar cat cp createrepo_c find gpg grep install mktemp \
  realpath rm rpm rpm2cpio rpmkeys rpmsign sort; do
  command -v "$command_name" >/dev/null 2>&1 \
    || fail "$command_name is required"
done

PACKAGE_ROOT="$(realpath -e -- "$1")"
OUTPUT_ROOT="$(realpath -m -- "$2")"
FINGERPRINT="${3^^}"
PUBLIC_KEY="$(realpath -e -- "$4")"
VERSION="$5"
RELEASE="$6"
readonly PACKAGE_ROOT OUTPUT_ROOT FINGERPRINT PUBLIC_KEY VERSION RELEASE

[[ -n "${GNUPGHOME:-}" && -d "$GNUPGHOME" ]] \
  || fail 'GNUPGHOME must identify the release-signing keyring'
[[ "$FINGERPRINT" =~ ^[0-9A-F]{40,64}$ ]] \
  || fail 'fingerprint must be a complete OpenPGP fingerprint'
[[ "$VERSION" =~ ^[0-9][0-9A-Za-z.+~]*$ && "$VERSION" != *-* ]] \
  || fail 'version is not valid for both Debian and RPM metadata'
[[ "$RELEASE" =~ ^[0-9]+$ ]] \
  || fail 'release must be numeric'
[[ -f "$PUBLIC_KEY" && ! -L "$PUBLIC_KEY" ]] \
  || fail 'public key must be a regular file'
if [[ -e "$OUTPUT_ROOT" ]] \
  && find "$OUTPUT_ROOT" -mindepth 1 -print -quit | grep -q .; then
  fail "output directory is not empty: $OUTPUT_ROOT"
fi

mapfile -d '' packages < <(
  find "$PACKAGE_ROOT" -maxdepth 1 -type f -name '*.rpm' -print0 | sort -z
)
((${#packages[@]} == 2)) \
  || fail "expected two RPM packages, found ${#packages[@]}"

repository_root="$OUTPUT_ROOT/fedora/44/x86_64"
package_output="$repository_root/Packages"
work_root="$(mktemp -d "${TMPDIR:-/tmp}/denial-dnf-repository.XXXXXX")"
cleanup() {
  if [[ "$work_root" == "${TMPDIR:-/tmp}"/denial-dnf-repository.* ]]; then
    rm -rf --one-file-system -- "$work_root"
  fi
}
trap cleanup EXIT
install -d -m 0755 "$package_output"

rpm_query_db="$work_root/rpm-query"
install -d -m 0700 "$rpm_query_db"
rpmkeys --dbpath "$rpm_query_db" --import "$PUBLIC_KEY"

package_names=()
for package in "${packages[@]}"; do
  package_name="$(rpm --dbpath "$rpm_query_db" -qp --qf '%{NAME}' "$package")"
  package_version="$(rpm --dbpath "$rpm_query_db" -qp --qf '%{VERSION}-%{RELEASE}' "$package")"
  package_arch="$(rpm --dbpath "$rpm_query_db" -qp --qf '%{ARCH}' "$package")"
  [[ "$package_name" == denial || "$package_name" == denial-flutter-engine ]] \
    || fail "unexpected RPM package: ${package_name:-unset}"
  [[ "$package_version" == "$VERSION-$RELEASE" ]] \
    || fail "$(basename -- "$package") has version $package_version"
  [[ "$package_arch" == x86_64 ]] \
    || fail "$(basename -- "$package") targets $package_arch"

  expected_payload="$work_root/payload-$package_name"
  install -d -m 0755 "$expected_payload"
  rpm2cpio "$package" | bsdtar -xpf - -C "$expected_payload"

  destination="$package_output/$(basename -- "$package")"
  cp --reflink=auto -- "$package" "$destination"
  rpmsign \
    --addsign \
    --define "_gpg_name $FINGERPRINT" \
    --define "_gpg_path $GNUPGHOME" \
    "$destination"
  rpmkeys --dbpath "$rpm_query_db" --checksig --verbose "$destination" \
    | grep -Eiq 'signature.*: OK'
  "$ROOT/tools/verify-denial-package-payload" \
    rpm "$destination" "$expected_payload"
  "$ROOT/tools/verify-denial-native-package-metadata" \
    rpm "$destination" "$VERSION" "$RELEASE" '3.44.7.denial1' 2.39
  package_names+=("$package_name")
done
mapfile -t package_names < <(printf '%s\n' "${package_names[@]}" | sort)
[[ "${package_names[*]}" == 'denial denial-flutter-engine' ]] \
  || fail 'RPM package set is incomplete'

createrepo_c \
  --checksum sha256 \
  --unique-md-filenames \
  "$repository_root"
repomd="$repository_root/repodata/repomd.xml"
[[ -s "$repomd" ]] || fail 'createrepo_c produced no repomd.xml'
gpg \
  --batch \
  --yes \
  --armor \
  --local-user "$FINGERPRINT" \
  --digest-algo SHA256 \
  --detach-sign \
  --output "$repomd.asc" \
  "$repomd"
gpg --batch --verify "$repomd.asc" "$repomd"

cat >"$OUTPUT_ROOT/denial-fedora.repo" <<'EOF'
[denial]
name=Denial public alpha
baseurl=https://denialwm.github.io/denial/rpm/fedora/$releasever/$basearch
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-denial
skip_if_unavailable=0
EOF

find "$OUTPUT_ROOT" -type d -exec chmod 0755 {} +
find "$OUTPUT_ROOT" -type f -exec chmod 0644 {} +
cleanup
trap - EXIT
printf 'Generated signed Fedora 44 DNF repository: %s\n' "$OUTPUT_ROOT"
