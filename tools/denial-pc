resolve_drm_device() {
    [[ -e "$DRM_DEVICE" ]] || die "DRM device not found: $DRM_DEVICE"
    local resolved
    resolved="$(readlink -f -- "$DRM_DEVICE")"
    [[ -c "$resolved" ]] || die "DRM device is not a character device: $resolved"
    printf '%s\n' "$resolved"
}

run_compositor() {
    require_file "$BINARY"
    require_pinned_engine
    require_file "$BUNDLE/data/icudtl.dat"
    require_file "$BUNDLE/lib/libapp.so"
    require_file "$SETTINGS_BINARY"
    [[ -x "$SETTINGS_BINARY" ]] \
        || die "Settings application is not executable: $SETTINGS_BINARY"
    require_file "$OUTPUT_CONFIG"
    command -v Xwayland >/dev/null 2>&1 \
        || die "Xwayland is required for X11 applications such as Steam"

    local drm_device
    drm_device="$(resolve_drm_device)"
    local shell_profile="${DENIA_SHELL_PROFILE:-desktop}"
    case "$shell_profile" in
        mobile | desktop) ;;
        *) die "DENIA_SHELL_PROFILE must be mobile or desktop, got: $shell_profile" ;;
    esac
    local flutter_renderer="${DENIA_FLUTTER_RENDERER:-impeller}"
    case "$flutter_renderer" in
        skia | impeller) ;;
        *) die "DENIA_FLUTTER_RENDERER must be skia or impeller, got: $flutter_renderer" ;;
    esac

    unset DISPLAY WAYLAND_DISPLAY HYPRLAND_INSTANCE_SIGNATURE SWAYSOCK I3SOCK
    unset NO_COLOR WLR_DRM_DEVICES AQ_DRM_DEVICES
    export DENIA_SHELL_PROFILE="$shell_profile"
    export DENIAL_SETTINGS_BINARY="$SETTINGS_BINARY"
    export RUST_BACKTRACE=1
    export RUST_LOG="${DENIA_RUST_LOG:-deniald=info,smithay=warn}"

    command -v systemd-cat >/dev/null 2>&1 \
        || die "systemd-cat is required to retain compositor diagnostics"
    exec systemd-cat --identifier=deniald "$BINARY" \
        --device "$drm_device" \
        --output-config "$OUTPUT_CONFIG" \
        --wayland \
        --flutter-bundle "$BUNDLE" \
        --flutter-renderer "$flutter_renderer"
}

run_session() {
    [[ -z "${WAYLAND_DISPLAY:-}" ]] \
        || die "a Wayland compositor is already active; log out and select Denial from the display manager"
    run_compositor
}

run_engine_test_session() {
    select_engine_test
    run_session
}

check_engine_test() {
    select_engine_test
    (
        cd -- "$COMPOSITOR_ROOT"
        DENIAL_TEST_FLUTTER_BUNDLE="$BUNDLE" \
        CARGO_TARGET_DIR="$RUST_TARGET" \
        cargo test --locked --jobs "$BUILD_JOBS" \
            -p denial-flutter-engine \
            loads_the_bundled_flutter_engine_abi
    )
    printf 'Verified staged engine ABI and AOT data (sha256 %s).\n' \
        "$SESSION_ENGINE_SHA256"
}

arm_engine_test() {
    select_engine_test

    local test_root artifact_id link
    test_root="${BUNDLE%/bundle}"
    artifact_id="${test_root##*/}"
    link="$ENGINE_TEST_STORE/.next-session.$$"
    ln -s -- "$artifact_id" "$link"
    mv -Tf -- "$link" "$ENGINE_TEST_NEXT"
    printf 'Armed engine %.12s... for the next Denial development login only.\n' \
        "$SESSION_ENGINE_SHA256"
    printf 'The flag is consumed before deniald starts; later logins use the known-good engine.\n'
}

cancel_engine_test() {
    if [[ -e "$ENGINE_TEST_NEXT" || -L "$ENGINE_TEST_NEXT" ]]; then
        rm -f -- "$ENGINE_TEST_NEXT"
        printf 'Cancelled the pending one-shot engine test.\n'
    else
        printf 'No one-shot engine test is armed.\n'
    fi
}

run_display_manager_session() {
    install_settings_desktop_entry
    if [[ ! -e "$ENGINE_TEST_NEXT" && ! -L "$ENGINE_TEST_NEXT" ]]; then
        run_session
        return
    fi

    local test_root
    test_root="$(readlink -f -- "$ENGINE_TEST_NEXT" || true)"
    rm -f -- "$ENGINE_TEST_NEXT"
    [[ -n "$test_root" ]] \
        || die "the one-shot engine-test target was missing; the flag was cleared, so retrying starts the known-good session"
    select_engine_test_root "$test_root"
    printf 'Starting the one-shot isolated engine test (%.12s...).\n' \
        "$SESSION_ENGINE_SHA256"
    run_session
}

request_kms_reconfigure() {
    local pid
    pid="$(pgrep -u "$(id -u)" -x deniald || true)"
    [[ $pid =~ ^[0-9]+$ ]] \
        || die "expected exactly one deniald process for this user, found: ${pid:-none}"
    grep -aFq "live KMS reconfiguration requested" "/proc/$pid/exe" \
        || die "the running deniald predates live KMS re-evaluation; reboot into the rebuilt session first"
    kill -USR2 "$pid"
    printf 'Requested live KMS re-evaluation from deniald PID %s\n' "$pid"
}

show_path_state() {
    local label="$1"
    local path="$2"
    if [[ -e "$path" ]]; then
        printf 'ok       %-18s %s\n' "$label" "$path"
    else
        printf 'missing  %-18s %s\n' "$label" "$path"
    fi
}

show_command_state() {
    local label="$1"
    local command="$2"
    local path
    path="$(command -v "$command" || true)"
    if [[ -n "$path" ]]; then
        printf 'ok       %-18s %s\n' "$label" "$path"
    else
        printf 'missing  %-18s %s\n' "$label" "$command"
    fi
}

show_engine_state() {
    if [[ ! -e "$PREBUILT_ENGINE" || ! -e "$PREBUILT_ENGINE_SHA256" ]]; then
        printf 'missing  %-18s %s (rebuild locally)\n' \
            "pinned engine" "$PREBUILT_ENGINE"
    elif [[ "$(file_sha256 "$PREBUILT_ENGINE")" != "$(prebuilt_engine_sha256)" ]]; then
        printf 'corrupt  %-18s %s (checksum mismatch; rebuild or investigate)\n' \
            "pinned engine" "$PREBUILT_ENGINE"
    else
        printf 'ok       %-18s %s\n' "pinned engine" "$PREBUILT_ENGINE"
    fi

    if [[ ! -e "$ENGINE" ]]; then
        printf 'missing  %-18s %s\n' "bundle engine" "$ENGINE"
    elif [[ -e "$PREBUILT_ENGINE_SHA256" \
        && "$(file_sha256 "$ENGINE")" == "$(prebuilt_engine_sha256)" ]]; then
        printf 'ok       %-18s %s (pinned)\n' "bundle engine" "$ENGINE"
    else
        printf 'stale    %-18s %s (not pinned; run bundle)\n' "bundle engine" "$ENGINE"
    fi
}

show_flutter_bindings_state() {
    if [[ ! -e "$PREBUILT_ENGINE_REVISION" ]]; then
        printf 'missing  %-18s %s\n' "engine revision" "$PREBUILT_ENGINE_REVISION"
    elif [[ ! -e "$PREBUILT_FLUTTER_REVISION" ]]; then
        printf 'missing  %-18s %s\n' "Flutter revision" "$PREBUILT_FLUTTER_REVISION"
    elif [[ ! -e "$EMBEDDER_BINDINGS" ]]; then
        printf 'missing  %-18s %s\n' "embedder bindings" "$EMBEDDER_BINDINGS"
    else
        local engine_revision flutter_revision
        engine_revision="$(tr -d '[:space:]' < "$PREBUILT_ENGINE_REVISION")"
        flutter_revision="$(tr -d '[:space:]' < "$PREBUILT_FLUTTER_REVISION")"
        if grep -Fqx "// Flutter engine revision: $engine_revision" "$EMBEDDER_BINDINGS" \
            && grep -Fqx "// Flutter source revision: $flutter_revision" "$EMBEDDER_BINDINGS"; then
            printf 'ok       %-18s %s (engine %.12s...)\n' \
                "embedder bindings" "$EMBEDDER_BINDINGS" "$engine_revision"
        else
            printf 'stale    %-18s %s (run tools/generate-flutter-embedder-bindings)\n' \
                "embedder bindings" "$EMBEDDER_BINDINGS"
        fi
    fi
}

show_session_state() {
    if [[ ! -e "$SESSION_FILE" ]]; then
        printf 'missing  %-18s %s\n' "session entry" "$SESSION_FILE"
    elif grep -Fqx "X-Denial-Launcher=$SCRIPT_DIR/denial-pc" "$SESSION_FILE" \
        && grep -Fqx "DesktopNames=Denial" "$SESSION_FILE" \
        && grep -Fqx "TryExec=/usr/bin/bash" "$SESSION_FILE" \
        && grep -Fqx \
            "Exec=$SCRIPT_DIR/denial-pc session" \
            "$SESSION_FILE"; then
        printf 'ok       %-18s %s\n' "session entry" "$SESSION_FILE"
    else
        printf 'stale    %-18s %s (run install-session)\n' "session entry" "$SESSION_FILE"
    fi

    if [[ ! -e "$SETTINGS_DESKTOP_FILE" ]]; then
        printf 'missing  %-18s %s\n' \
            "Settings desktop" "$SETTINGS_DESKTOP_FILE"
    elif grep -Fqx "# Installed by $SCRIPT_DIR/denial-pc" \
        "$SETTINGS_DESKTOP_FILE" \
        && grep -Fqx "Exec=$SETTINGS_BINARY" "$SETTINGS_DESKTOP_FILE" \
        && grep -Fqx "TryExec=$SETTINGS_BINARY" "$SETTINGS_DESKTOP_FILE"; then
        printf 'ok       %-18s %s\n' \
            "Settings desktop" "$SETTINGS_DESKTOP_FILE"
    else
        printf 'stale    %-18s %s (run install-session)\n' \
            "Settings desktop" "$SETTINGS_DESKTOP_FILE"
    fi

    if [[ ! -e "$SESSION_TARGET_FILE" ]]; then
        printf 'missing  %-18s %s\n' "session target" "$SESSION_TARGET_FILE"
    elif cmp -s -- "$SESSION_TARGET_SOURCE" "$SESSION_TARGET_FILE"; then
        printf 'ok       %-18s %s\n' "session target" "$SESSION_TARGET_FILE"
    else
        printf 'stale    %-18s %s (run install-session)\n' \
            "session target" "$SESSION_TARGET_FILE"
    fi

    if [[ -e "$LEGACY_SESSION_FILE" ]]; then
        printf 'stale    %-18s %s (removed by install-session)\n' \
            "legacy SDDM entry" "$LEGACY_SESSION_FILE"
    fi

    if [[ ! -e "$PORTAL_FILE" ]]; then
        printf 'missing  %-18s %s\n' "portal routing" "$PORTAL_FILE"
    elif grep -Fqx "# Installed by $SCRIPT_DIR/denial-pc" "$PORTAL_FILE" \
        && grep -Fqx "org.freedesktop.impl.portal.Settings=denial;gtk" "$PORTAL_FILE" \
        && grep -Fqx "org.freedesktop.impl.portal.ScreenCast=wlr" "$PORTAL_FILE" \
        && grep -Fqx "org.freedesktop.impl.portal.Screenshot=wlr" "$PORTAL_FILE"; then
        printf 'ok       %-18s %s\n' "portal routing" "$PORTAL_FILE"
    else
        printf 'stale    %-18s %s (run install-session)\n' \
            "portal routing" "$PORTAL_FILE"
    fi

    if [[ ! -e "$WLR_PORTAL_CONFIG" ]]; then
        printf 'missing  %-18s %s\n' "wlr portal config" "$WLR_PORTAL_CONFIG"
    elif grep -Fqx "# Installed by $SCRIPT_DIR/denial-pc" "$WLR_PORTAL_CONFIG" \
        && grep -Fqx "chooser_type=dmenu" "$WLR_PORTAL_CONFIG" \
        && grep -Fq "chooser_cmd=zenity --list " "$WLR_PORTAL_CONFIG"; then
        printf 'ok       %-18s %s\n' "wlr portal config" "$WLR_PORTAL_CONFIG"
    else
        printf 'stale    %-18s %s (run install-session)\n' \
            "wlr portal config" "$WLR_PORTAL_CONFIG"
    fi
}

