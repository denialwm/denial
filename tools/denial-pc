LEGACY_SESSION_FILE="${DENIAL_LEGACY_SESSION_FILE:-/usr/share/wayland-sessions/denial-rs.desktop}"
AVAILABLE_CPUS="$(nproc)"
if [[ "${GITHUB_ACTIONS:-}" == true \
    || "${DENIAL_PC_DEDICATED_BUILDER:-0}" == 1 ]]; then
    DEFAULT_BUILD_JOBS="$AVAILABLE_CPUS"
elif ((AVAILABLE_CPUS > 2)); then
    DEFAULT_BUILD_JOBS=$((AVAILABLE_CPUS - 2))
else
    DEFAULT_BUILD_JOBS=1
fi
BUILD_JOBS="${DENIAL_BUILD_JOBS:-$DEFAULT_BUILD_JOBS}"

usage() {
    cat <<'EOF'
Usage: tools/denial-pc COMMAND

Commands:
  bootstrap         Validate or provision Flutter, then fetch Rust crates
  bundle            Build only the x64 Dart/Flutter bundle
  settings          Build only the standalone Flutter Settings application
  refresh           Build the bundle and reload its Flutter runtime in this session
  kms-refresh       Re-evaluate the live KMS topology without ending the session
  compositor        Build the release Rust compositor and denialctl
  build             Build the bundle, release compositor, and denialctl
  arch-package      Build an installable Arch Linux package
  debian-package    Build installable Debian-family packages
  fedora-package    Build installable Fedora RPM packages
  alpine-package    Build installable Alpine Linux APK packages
  native-packages   Build Debian-family and Fedora packages from one payload
  flutter-test      Run lock-matched Flutter shell tests; forwards remaining arguments
  test              Run compositor and lock-matched Flutter shell tests
  session           Run the real DRM session (normally invoked by a display manager)
  engine-test-build Build only the local release engine and stage an isolated test bundle
  engine-test-check Verify the staged engine ABI and AOT bundle without starting Denial
  engine-test-arm   Use the staged engine test for the next development login only
  engine-test-cancel
                    Cancel a pending one-shot engine test
  engine-test-session
                    Run the staged engine test (normally invoked by a display manager)
  doctor            Show prerequisites and built artifact state
  install-session   Add the display-manager entry and Denial portal routing
  install-settings-entry
                    Refresh the local Settings entry for this user
  install-engine-test-session
                    Add a separate display-manager entry for the staged engine test
  remove-session    Remove that session and portal configuration
  remove-engine-test-session
                    Remove only the engine-test display-manager entry

Environment:
  DENIAL_FLUTTER_SOURCE_ROOT
                     Prepared Flutter source tree override
  DENIAL_FLUTTER_SDK_ROOT
                     Compatibility alias for DENIAL_FLUTTER_SOURCE_ROOT
  DENIAL_BUILD_JOBS  Explicit Cargo and Flutter build parallelism
  DENIAL_PC_DEDICATED_BUILDER
                     Set to 1 to use every CPU by default
  DENIA_FLUTTER_RENDERER
                     Development-session renderer: skia or impeller (default: impeller)

The production compositor is deniald and its native client is denialctl. The
denial-nested binary is a separate visual topology harness and never acquires
DRM or input devices.
EOF
}

die() {
    printf 'denial-pc: %s\n' "$*" >&2
    exit 1
}

[[ "$BUILD_JOBS" =~ ^[1-9][0-9]*$ ]] \
    || die "DENIAL_BUILD_JOBS must be a positive integer"

run_pinned_cargo() (
    cd -- "$COMPOSITOR_ROOT"
    CARGO_TARGET_DIR="$RUST_TARGET" cargo "$@"
)

require_file() {
    [[ -f "$1" ]] || die "missing $1; run '$0 build' first"
}

config_active_lines_equal() {
    local path="$1"
    shift
    local -a actual=()
    local -a expected=("$@")
    local index

    mapfile -t actual < <(
        sed -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' "$path"
    )
    ((${#actual[@]} == ${#expected[@]})) || return 1
    for ((index = 0; index < ${#actual[@]}; index++)); do
        [[ "${actual[index]}" == "${expected[index]}" ]] || return 1
    done
}

is_compatible_legacy_config() {
    local label="$1"
    local path="$2"

    case "$label" in
        "portal routing")
            config_active_lines_equal "$path" \
                '[preferred]' \
                'default=gtk' \
                'org.freedesktop.impl.portal.Settings=denial;gtk' \
                'org.freedesktop.impl.portal.ScreenCast=wlr' \
                'org.freedesktop.impl.portal.Screenshot=wlr'
            ;;
        "wlr portal config")
            config_active_lines_equal "$path" \
                '[screencast]' \
                'chooser_type=dmenu' \
                "chooser_cmd=zenity --list --title='Share your screen' --text='Choose a source to share' --column='Source' --width=520 --height=320"
            ;;
        *) return 1 ;;
    esac
}

require_managed_config_or_absent() {
    local label="$1"
    local path="$2"
    [[ -e "$path" || -L "$path" ]] || return
    grep -Fqx "# Installed by $SCRIPT_DIR/denial-pc" "$path" && return
    if is_compatible_legacy_config "$label" "$path"; then
        printf 'Adopting compatible legacy %s: %s\n' "$label" "$path"
        return
    fi
    die "refusing to replace unrecognized $label: $path"
}

render_settings_desktop_entry() {
    local destination="$1"
    {
        printf '# Installed by %s/denial-pc\n' "$SCRIPT_DIR"
        sed \
            -e "s|^Exec=.*|Exec=$SETTINGS_BINARY|" \
            -e "s|^TryExec=.*|TryExec=$SETTINGS_BINARY|" \
            "$SETTINGS_DESKTOP_SOURCE"
    } >"$destination"
}

require_managed_settings_desktop_or_absent() {
    [[ -e "$SETTINGS_DESKTOP_FILE" || -L "$SETTINGS_DESKTOP_FILE" ]] \
        || return 0
    grep -Fqx "# Installed by $SCRIPT_DIR/denial-pc" \
        "$SETTINGS_DESKTOP_FILE" \
        || die "refusing to replace unrecognized Settings desktop entry: $SETTINGS_DESKTOP_FILE"
}

install_settings_desktop_entry() {
    require_file "$SETTINGS_DESKTOP_SOURCE"
    require_file "$SETTINGS_BINARY"
    [[ -x "$SETTINGS_BINARY" ]] \
        || die "Settings application is not executable: $SETTINGS_BINARY"
    require_managed_settings_desktop_or_absent

    local rendered
    rendered="$(mktemp)"
    render_settings_desktop_entry "$rendered"
    if [[ -e "$SETTINGS_DESKTOP_FILE" ]] \
        && cmp -s -- "$rendered" "$SETTINGS_DESKTOP_FILE"; then
        rm -f -- "$rendered"
        return
    fi
    if install -Dm644 -- "$rendered" "$SETTINGS_DESKTOP_FILE"; then
        :
    else
        local status=$?
        rm -f -- "$rendered"
        return "$status"
    fi
    rm -f -- "$rendered"
    printf 'Installed %s\n' "$SETTINGS_DESKTOP_FILE"
}

tracked_changes_match_revision() {
    local source="$1"
    local revision="$2"
    local changed_path
    local changed_paths=()

    mapfile -d '' changed_paths < <(
        git -C "$source" diff --name-only -z HEAD --
    )
    ((${#changed_paths[@]})) || return 1
    for changed_path in "${changed_paths[@]}"; do
        git -C "$source" diff --quiet "$revision" -- "$changed_path" \
            || return 1
    done
}

is_git_checkout() {
    [[ -d "$1" ]] \
        && [[ "$(git -C "$1" rev-parse --is-inside-work-tree 2>/dev/null || true)" == true ]]
}

checkout_revision() {
    local label="$1"
    local repository="$2"
    local revision="$3"
    local destination="$4"

    if [[ ! -e "$destination" ]]; then
        mkdir -p -- "$(dirname -- "$destination")"
        git init --quiet "$destination"
        git -C "$destination" remote add origin "$repository"
    elif ! is_git_checkout "$destination"; then
        die "$label path exists but is not a Git checkout: $destination"
    fi

    local actual_origin
    actual_origin="$(git -C "$destination" remote get-url origin)"
    if [[ "$actual_origin" != "$repository" ]]; then
        if [[ -n "$(git -C "$destination" status --porcelain --untracked-files=no)" ]]; then
            if ! git -C "$destination" cat-file -e "$revision^{commit}" \
                2>/dev/null; then
                printf 'Fetching %s migration target %s...\n' \
                    "$label" "$revision"
                git -C "$destination" fetch --depth=1 "$repository" "$revision"
            fi
            if tracked_changes_match_revision "$destination" "$revision"; then
                printf 'Migrating source-equivalent %s cache to %s...\n' \
                    "$label" "$repository"
                git -C "$destination" remote set-url origin "$repository"
                git -C "$destination" checkout --quiet --detach --force \
                    "$revision"
                return
            fi
            die "$label uses $actual_origin and has tracked changes that do not match $revision; refusing to overwrite them"
        fi
        git -C "$destination" remote set-url origin "$repository"
    fi

    if ! git -C "$destination" cat-file -e "$revision^{commit}" 2>/dev/null; then
        printf 'Fetching %s at %s...\n' "$label" "$revision"
        git -C "$destination" fetch --depth=1 origin "$revision"
    fi

    local current
    current="$(git -C "$destination" rev-parse HEAD 2>/dev/null || true)"
    if [[ "$current" == "$revision" ]]; then
        return
    fi
    if [[ -n "$(git -C "$destination" status --porcelain --untracked-files=no)" ]]; then
        die "$label has tracked changes and cannot switch to $revision: $destination"
    fi
    git -C "$destination" checkout --quiet --detach "$revision"
}

file_sha256() {
    sha256sum -- "$1" | cut -d' ' -f1
}

prebuilt_engine_sha256() {
    require_file "$PREBUILT_ENGINE_SHA256"
    cut -d' ' -f1 < "$PREBUILT_ENGINE_SHA256"
}

verify_prebuilt_engine() {
    [[ -f "$PREBUILT_ENGINE" ]] \
        || die "missing locally built Flutter engine: $PREBUILT_ENGINE (see $PREBUILT_ENGINE_DIR/BUILD_INFO.md)"
    [[ "$(file_sha256 "$PREBUILT_ENGINE")" == "$(prebuilt_engine_sha256)" ]] \
        || die "locally built Flutter engine does not match $PREBUILT_ENGINE_SHA256; rebuild or investigate it (see $PREBUILT_ENGINE_DIR/BUILD_INFO.md)"
}

install_pinned_engine() {
    verify_prebuilt_engine
    mkdir -p -- "$(dirname -- "$ENGINE")"
    install -m644 -- "$PREBUILT_ENGINE" "$ENGINE"
    printf 'Installed pinned Flutter engine into bundle (sha256 %.12s...)\n' \
        "$(prebuilt_engine_sha256)"
}

require_pinned_engine() {
    require_file "$ENGINE"
    local expected label
    if [[ -n "$SESSION_ENGINE_SHA256" ]]; then
        expected="$SESSION_ENGINE_SHA256"
        label="staged engine test"
    else
        expected="$(prebuilt_engine_sha256)"
        label="pinned build"
    fi
    [[ "$expected" =~ ^[0-9a-f]{64}$ ]] \
        || die "invalid expected SHA-256 for $label"
    [[ "$(file_sha256 "$ENGINE")" == "$expected" ]] \
        || die "bundle engine does not match the $label"
}

select_engine_test_root() {
    local test_root="$1"
    local expected
    [[ -n "$test_root" && -d "$test_root" ]] \
        || die "staged engine-test target is missing: $test_root"
    case "$test_root/" in
        "$ENGINE_TEST_STORE"/*) ;;
        *) die "staged engine-test target escapes $ENGINE_TEST_STORE: $test_root" ;;
    esac

    require_file "$test_root/libflutter_engine.so.sha256"
    expected="$(cut -d' ' -f1 < "$test_root/libflutter_engine.so.sha256")"
    [[ "$expected" =~ ^[0-9a-f]{64}$ ]] \
        || die "invalid staged engine-test SHA-256: $test_root/libflutter_engine.so.sha256"

    BUNDLE="$test_root/bundle"
    ENGINE="$BUNDLE/lib/libflutter_engine.so"
    SESSION_ENGINE_SHA256="$expected"
    require_pinned_engine
    require_file "$BUNDLE/data/icudtl.dat"
    require_file "$BUNDLE/lib/libapp.so"
}

select_engine_test() {
    [[ -L "$ENGINE_TEST_CURRENT" ]] \
        || die "no staged engine test; run '$0 engine-test-build'"
    select_engine_test_root "$(readlink -f -- "$ENGINE_TEST_CURRENT")"
}

stage_engine_test() {
    require_pinned_engine
    require_file "$BUNDLE/data/icudtl.dat"
    require_file "$BUNDLE/lib/libapp.so"
    is_git_checkout "$ENGINE_TEST_SOURCE_ROOT" \
        || die "engine-test Flutter checkout not found: $ENGINE_TEST_SOURCE_ROOT"
    [[ -z "$(git -C "$ENGINE_TEST_SOURCE_ROOT" status --porcelain)" ]] \
        || die "engine-test Flutter checkout must be clean before building: $ENGINE_TEST_SOURCE_ROOT"
    require_file "$ENGINE_TEST_NINJA_OUT/args.gn"

    local revision engine_source engine_sha artifact_id final_dir stage link
    revision="$(git -C "$ENGINE_TEST_SOURCE_ROOT" rev-parse HEAD)"
    engine_source="$ENGINE_TEST_NINJA_OUT/libflutter_engine.so"
    printf 'Building only the release Flutter engine at %.12s...\n' "$revision"
    PATH="$ENGINE_TEST_SOURCE_ROOT/engine/src/flutter/third_party/depot_tools:$PATH" \
        /usr/bin/ninja -C "$ENGINE_TEST_NINJA_OUT" \
        -j "$BUILD_JOBS" libflutter_engine.so flutter_patched_sdk
    require_file "$engine_source"
    [[ "$revision" == "$(git -C "$ENGINE_TEST_SOURCE_ROOT" rev-parse HEAD)" ]] \
        || die "Flutter revision changed while the engine was building"
    [[ -z "$(git -C "$ENGINE_TEST_SOURCE_ROOT" status --porcelain)" ]] \
        || die "Flutter checkout changed while the engine was building"

    engine_sha="$(file_sha256 "$engine_source")"
    artifact_id="${revision}-${engine_sha:0:16}"
    final_dir="$ENGINE_TEST_STORE/$artifact_id"
    mkdir -p -- "$ENGINE_TEST_STORE"
    if [[ ! -d "$final_dir" ]]; then
        stage="$(mktemp -d "$ENGINE_TEST_STORE/.stage.XXXXXX")"
        mkdir -p -- "$stage/bundle"
        cp -a -- "$BUNDLE/." "$stage/bundle/"
        install -m644 -- "$engine_source" \
            "$stage/bundle/lib/libflutter_engine.so"
        printf '%s  libflutter_engine.so\n' "$engine_sha" \
            > "$stage/libflutter_engine.so.sha256"
        printf '%s\n' "$revision" > "$stage/FLUTTER_REVISION"
        [[ "$(file_sha256 "$stage/bundle/lib/libflutter_engine.so")" == "$engine_sha" ]] \
            || die "staged engine-test copy failed checksum verification: $stage"
        chmod -R a-w -- "$stage"
        mv -- "$stage" "$final_dir"
    else
        [[ -f "$final_dir/FLUTTER_REVISION" \
            && "$(tr -d '[:space:]' < "$final_dir/FLUTTER_REVISION")" == "$revision" \
            && -f "$final_dir/bundle/lib/libflutter_engine.so" \
            && "$(file_sha256 "$final_dir/bundle/lib/libflutter_engine.so")" == "$engine_sha" ]] \
            || die "existing engine-test artifact is inconsistent: $final_dir"
    fi

    link="$ENGINE_TEST_STORE/.current.$$"
    ln -s -- "$artifact_id" "$link"
    mv -Tf -- "$link" "$ENGINE_TEST_CURRENT"
    printf '\nStaged isolated engine test:\n  Flutter %.12s...\n  Engine  %s\n  Bundle  %s\n' \
        "$revision" "$engine_sha" "$final_dir/bundle"
    printf 'The normal development bundle was not modified.\n'
}

require_flutter_bindings() {
    require_file "$PREBUILT_ENGINE_REVISION"
    require_file "$PREBUILT_FLUTTER_REVISION"
    require_file "$EMBEDDER_BINDINGS"
    local engine_revision flutter_revision
    engine_revision="$(tr -d '[:space:]' < "$PREBUILT_ENGINE_REVISION")"
    flutter_revision="$(tr -d '[:space:]' < "$PREBUILT_FLUTTER_REVISION")"
    [[ "$flutter_revision" == "$FLUTTER_UPSTREAM_REVISION" ]] \
        || die "prebuilt engine targets upstream Flutter $flutter_revision, but the source lock expects $FLUTTER_UPSTREAM_REVISION"
    if ! grep -Fqx \
        "// Flutter engine revision: $engine_revision" "$EMBEDDER_BINDINGS" \
        || ! grep -Fqx \
            "// Flutter source revision: $flutter_revision" "$EMBEDDER_BINDINGS"; then
        die "Flutter embedder bindings do not match engine $engine_revision / Flutter $flutter_revision; run 'tools/generate-flutter-embedder-bindings'"
    fi
}

require_revision() {
    local label="$1"
    local source="$2"
    local revision="$3"

    is_git_checkout "$source" \
        || die "$label checkout not found: $source (run '$0 bootstrap')"
    local current
    current="$(git -C "$source" rev-parse HEAD)"
    [[ "$current" == "$revision" ]] \
        || die "$label revision is $current, expected $revision: $source"
}

prepare_flutter_version_metadata() {
    local version_ref="refs/tags/$FLUTTER_SDK_VERSION"
    local tagged_revision
    if ((FLUTTER_SDK_MANAGED)); then
        tagged_revision="$(
            git -C "$FLUTTER_SDK_ROOT" rev-parse \
                --verify "$version_ref^{commit}" 2>/dev/null || true
        )"
        if [[ "$tagged_revision" != "$FLUTTER_SDK_REVISION" ]]; then
            git -C "$FLUTTER_SDK_ROOT" tag --force \
                "$FLUTTER_SDK_VERSION" "$FLUTTER_SDK_REVISION" >/dev/null
        fi
    fi

    local version_file="$FLUTTER_SDK_ROOT/bin/cache/flutter.version.json"
    if ((FLUTTER_SDK_MANAGED)); then
        if [[ -f "$version_file" ]] \
            && ! jq -e \
            --arg version "$FLUTTER_SDK_VERSION" \
            --arg revision "$FLUTTER_SDK_REVISION" \
            '.frameworkVersion == $version
                and .frameworkRevision == $revision' \
            "$version_file" >/dev/null; then
            rm -f -- "$version_file"
        fi
    else
        if [[ ! -f "$version_file" ]]; then
            "$FLUTTER" --version --suppress-analytics >/dev/null
        fi
        local rendered_version
        rendered_version="$(mktemp -- "${version_file}.XXXXXX")"
        jq \
            --arg version "$FLUTTER_SDK_VERSION" \
            --arg revision "$FLUTTER_SDK_REVISION" \
            '.frameworkVersion = $version
                | .flutterVersion = $version
                | .frameworkRevision = $revision' \
            "$version_file" >"$rendered_version"
        mv -- "$rendered_version" "$version_file"
    fi

    local legacy_version_file="$FLUTTER_SDK_ROOT/version"
    if [[ -f "$legacy_version_file" ]] \
        && [[ "$(< "$legacy_version_file")" != "$FLUTTER_SDK_VERSION" ]]; then
        rm -f -- "$legacy_version_file"
    fi
}

prepare_flutter_toolchain() {
    require_revision "Flutter SDK" "$FLUTTER_SDK_ROOT" "$FLUTTER_SDK_REVISION"
    [[ -x "$FLUTTER" ]] || die "Flutter launcher not found: $FLUTTER"
    if ((!FLUTTER_SDK_MANAGED)); then
        # The launcher may rebuild its tool snapshot and delete version metadata.
        # Finish that bootstrap before pinning the fork's declared SDK version.
        "$FLUTTER" --version --suppress-analytics >/dev/null
    fi
    prepare_flutter_version_metadata
    git -C "$FLUTTER_SDK_ROOT" diff --quiet \
        || die "Flutter fork checkout has tracked modifications: $FLUTTER_SDK_ROOT"
    git -C "$FLUTTER_SDK_ROOT" diff --cached --quiet \
        || die "Flutter fork checkout has staged modifications: $FLUTTER_SDK_ROOT"
}

bootstrap_dependencies() {
    if ((FLUTTER_SDK_MANAGED)); then
        checkout_revision \
            "Flutter SDK" \
            "$FLUTTER_SDK_REPOSITORY" \
            "$FLUTTER_SDK_REVISION" \
            "$FLUTTER_SDK_ROOT"
    else
        require_revision "Flutter SDK" "$FLUTTER_SDK_ROOT" "$FLUTTER_SDK_REVISION"
    fi
    prepare_flutter_toolchain
    "$FLUTTER" precache --linux
    run_pinned_cargo fetch --locked
    printf '\nDependencies are ready below %s\n' "$DEPENDENCY_ROOT"
}

build_bundle() (
    prepare_flutter_toolchain
    "$ROOT/tools/denial-flutter-engine" prepare-app-build
    mkdir -p -- "$(dirname -- "$BUNDLE_ASSEMBLY")" "$BUNDLE/data" "$BUNDLE/lib"
    local assembly
    assembly="$(mktemp -d -- "${BUNDLE_ASSEMBLY}.XXXXXX")"
    trap 'rm -rf -- "$assembly"' EXIT
    (
        cd "$ROOT/dart_shell"
        "$FLUTTER" pub get
        "$FLUTTER" assemble \
            --local-engine-src-path="$LOCAL_ENGINE_SRC_PATH" \
            --local-engine="$LOCAL_ENGINE_TARGET" \
            --local-engine-host="$LOCAL_ENGINE_TARGET" \
            --suppress-analytics \
            --resource-pool-size="$BUILD_JOBS" \
            --output="$assembly" \
            -dTargetFile=lib/main.dart \
            -dBuildMode=release \
            -dTargetPlatform=linux-x64 \
            -dDartObfuscation=false \
            -dTrackWidgetCreation=true \
            -dTreeShakeIcons=true \
            release_bundle_linux-x64_assets
    )
    require_file "$assembly/lib/libapp.so"
    require_file "$ICU_DATA"
    mkdir -p -- "$BUNDLE/data/flutter_assets"
    rsync -a --delete \
        "$assembly/flutter_assets/" \
        "$BUNDLE/data/flutter_assets/"
    install -m644 -- "$ICU_DATA" "$BUNDLE/data/icudtl.dat"
    install -m755 -- "$assembly/lib/libapp.so" "$BUNDLE/lib/libapp.so"
    install_pinned_engine
)

build_settings() (
