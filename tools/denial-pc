DENIAL_PORTAL_DBUS_TEMPLATE="$ROOT/dev/org.freedesktop.impl.portal.desktop.denial.service.in"
DENIAL_PORTAL_DBUS_SERVICE="${DENIAL_PORTAL_DBUS_SERVICE:-/usr/local/share/dbus-1/services/org.freedesktop.impl.portal.desktop.denial.service}"
DENIAL_PORTAL_UNIT_TEMPLATE="$ROOT/dev/denial-portal-development.service.in"
