    prepare_sdk_package
    "$ROOT/tools/denial-flutter-engine" prepare-app-build
    build_native_application settings_app denial-settings "$SETTINGS_BUNDLE"
    require_file "$SETTINGS_BUNDLE/denial-settings"
    require_file "$SETTINGS_BUNDLE/lib/libapp.so"
    require_file "$SETTINGS_BUNDLE/lib/libflutter_engine.so"
