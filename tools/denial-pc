#!/usr/bin/env bash
set -euo pipefail

# SDDM passes the session's exit code through sddm-helper. Code 1 means an
# authentication failure there, which suppresses greeter restart even after a
# successful login. Install this boundary before any startup checks can fail.
case "${1:-}" in
    session | engine-test-session)
        DENIAL_SESSION_PID=''
        finish_development_session() {
            local status="$1"
            if [[ "$status" == 1 ]]; then
                printf 'denial-pc: session exited with status 1; reporting session failure (2) to the display manager\n' >&2
                status=2
            fi
            exit "$status"
        }
        terminate_development_session() {
            trap '' HUP INT TERM
            if [[ -n "$DENIAL_SESSION_PID" ]]; then
                kill -TERM "$DENIAL_SESSION_PID" 2>/dev/null || true
                wait "$DENIAL_SESSION_PID" 2>/dev/null || true
            fi
            exit 143
        }
        trap 'finish_development_session "$?"' EXIT
        trap terminate_development_session HUP INT TERM
        ;;
esac

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
# shellcheck source=lib/denial-architecture.sh
source "$SCRIPT_DIR/lib/denial-architecture.sh"
# shellcheck source=lib/denial-local-engine.sh
