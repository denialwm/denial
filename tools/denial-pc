ENGINE_TEST_NINJA_OUT="${DENIAL_PC_ENGINE_TEST_NINJA_OUT:-$ENGINE_TEST_SOURCE_ROOT/engine/src/out/denial_host_release}"
SESSION_ENGINE_SHA256=""
BINARY="${DENIAL_PC_BINARY:-$RUST_TARGET/release/deniald}"
