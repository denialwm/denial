resolve_drm_device() {
    [[ -e "$DRM_DEVICE" ]] || die "DRM device not found: $DRM_DEVICE"
    local resolved
    resolved="$(readlink -f -- "$DRM_DEVICE")"
    [[ -c "$resolved" ]] || die "DRM device is not a character device: $resolved"
    printf '%s\n' "$resolved"
}

run_compositor() {
    require_file "$BINARY"
    command -v systemd-cat >/dev/null 2>&1 \
        || die "systemd-cat is required to retain compositor diagnostics"
    require_pinned_engine warn
    require_file "$BUNDLE/data/icudtl.dat"
    require_file "$BUNDLE/lib/libapp.so"
    require_file "$SETTINGS_BINARY"
    [[ -x "$SETTINGS_BINARY" ]] \
        || die "Settings application is not executable: $SETTINGS_BINARY"
    require_file "$OUTPUT_CONFIG"
    local -a xwayland_arguments=()
    if [[ "$PC_XWAYLAND" == 1 ]]; then
        command -v Xwayland >/dev/null 2>&1 \
            || die "Xwayland is required for X11 applications such as Steam"
    else
        xwayland_arguments=(--no-xwayland)
    fi

    # DENIAL_POLKIT_AGENT=0 leaves PolicyKit to an agent the user runs.
    local polkit_arguments=()
    if [[ "${DENIAL_POLKIT_AGENT:-1}" == 0 ]]; then
        polkit_arguments=(--no-polkit-agent)
    fi

    local drm_device
    drm_device="$(resolve_drm_device)"
    local shell_profile="${DENIAL_SHELL_PROFILE-${DENIA_SHELL_PROFILE-desktop}}"
    case "$shell_profile" in
        mobile | desktop) ;;
        *) die "DENIAL_SHELL_PROFILE must be mobile or desktop, got: $shell_profile" ;;
    esac

    unset DISPLAY WAYLAND_DISPLAY HYPRLAND_INSTANCE_SIGNATURE SWAYSOCK I3SOCK
    unset NO_COLOR WLR_DRM_DEVICES AQ_DRM_DEVICES
    export DENIAL_SHELL_PROFILE="$shell_profile"
    export DENIA_SHELL_PROFILE="$shell_profile"
    export DENIAL_SETTINGS_BINARY="$SETTINGS_BINARY"
    # After a Denial update deniald rebuilds the user's plugins with the
    # locally built Plugin Manager backend, when there is one.
    if [[ -z "${DENIAL_PLUGINS_BINARY:-}" \
        && -x "$BUILD_ROOT/plugin-manager/denial-plugins" ]]; then
        export DENIAL_PLUGINS_BINARY="$BUILD_ROOT/plugin-manager/denial-plugins"
    fi
    export RUST_BACKTRACE=1
    export RUST_LOG="${DENIAL_RUST_LOG-${DENIA_RUST_LOG-deniald=info,smithay=warn}}"

    systemd-cat --identifier=deniald "$BINARY" \
        --device "$drm_device" \
        --output-config "$OUTPUT_CONFIG" \
        --wayland \
        "${xwayland_arguments[@]}" \
        "${polkit_arguments[@]}" \
        --flutter-bundle "$BUNDLE" \
        --flutter-renderer impeller <&0 &
    DENIAL_SESSION_PID=$!
    local status=0
    wait "$DENIAL_SESSION_PID" || status=$?
    DENIAL_SESSION_PID=''
    exit "$status"
}

run_session() {
    [[ -z "${WAYLAND_DISPLAY:-}" ]] \
        || die "a Wayland compositor is already active; log out and select Denial from the display manager"
    run_compositor
}

run_engine_test_session() {
    select_engine_test
