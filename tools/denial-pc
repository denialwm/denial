    printf 'denial-pc: missing required command: jq\n' >&2
    exit 1
}
[[ -f "$FLUTTER_SOURCE_LOCK" ]] || {
    printf 'denial-pc: missing Flutter source lock: %s\n' \
        "$FLUTTER_SOURCE_LOCK" >&2
    exit 1
}

