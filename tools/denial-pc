build_plugin_manager() (
    prepare_flutter_toolchain
    prepare_sdk_package
    "$ROOT/tools/denial-flutter-engine" prepare-app-build
    local dart="$FLUTTER_SDK_ROOT/bin/cache/dart-sdk/bin/dart"
    mkdir -p -- "$BUILD_ROOT/plugin-manager"
    (
        cd -- "$ROOT/packages/denial_plugin_manager"
        "$dart" pub get --enforce-lockfile
        "$dart" compile exe bin/denial_plugins.dart \
            --output="$BUILD_ROOT/plugin-manager/denial-plugins.new"
        mv -f -- "$BUILD_ROOT/plugin-manager/denial-plugins.new" "$BUILD_ROOT/plugin-manager/denial-plugins"
    )
    local app_bundle="$ROOT/plugin_manager_app/build/linux/$DENIAL_FLUTTER_ARCH/release/bundle"
    # Keep metadata beside the native application after publishing its bundle.
    python3 - "$BUILD_ROOT/plugin-manager" "$RUST_TARGET/release/denialctl" \
        "$app_bundle" <<'PYMETA'
import json, os, pathlib, sys
backend, control, app = map(pathlib.Path, sys.argv[1:])
def publish(target, value):
    target.parent.mkdir(parents=True, exist_ok=True)
    temporary = target.with_name(target.name + '.new')
    temporary.write_text(json.dumps(value) + '\n')
    temporary.replace(target)
publish(backend / 'denial-plugins.installation.json', {
    'schema': 1, 'buildKit': 'build-kit',
    'denialctl': os.path.relpath(control, backend),
})
publish(app.parent / 'denial-plugin-manager.installation.json', {
    'schema': 1, 'application': 'denial-plugin-manager',
    'backend': str((backend / 'denial-plugins').resolve()),
})
PYMETA
    build_native_application plugin_manager_app denial-plugin-manager "$app_bundle"
    install -m644 -- "$app_bundle/../denial-plugin-manager.installation.json" "$app_bundle/denial-plugin-manager.installation.json"
    require_file "$ROOT/plugin_manager_app/build/linux/$DENIAL_FLUTTER_ARCH/release/bundle/denial-plugin-manager"
    require_file "$app_bundle/denial-plugin-manager.installation.json"
    # A versioned, release-only build kit travels with installed Denial. The
    # manager copies it into its own cache before running Flutter commands.
    local staging kit_id
    local -a kit_provenance=()
    ((FLUTTER_SDK_MANAGED)) || kit_provenance=(--provenance development)
    staging="$(mktemp -d "$BUILD_ROOT/plugin-manager/preparing-kit.XXXXXX")"
    trap 'rm -rf -- "$staging"' EXIT
    "$ROOT/tools/prepare-denial-plugin-kit" \
        "${kit_provenance[@]}" \
        --flutter-root "$FLUTTER_SDK_ROOT" \
        --engine-root "$LOCAL_ENGINE_SRC_PATH" \
        --engine-target "$LOCAL_ENGINE_TARGET" \
        --platform "$DENIAL_FLUTTER_PLATFORM" --output "$staging/kit"
    kit_id="$(sha256sum "$staging/kit/kit.json" | cut -d' ' -f1)"
    mkdir -p -- "$BUILD_ROOT/plugin-manager/build-kits"
    if [[ ! -d "$BUILD_ROOT/plugin-manager/build-kits/$kit_id" ]]; then
        mv -- "$staging/kit" "$BUILD_ROOT/plugin-manager/build-kits/$kit_id"
    fi
    ln -s "build-kits/$kit_id" "$staging/build-kit"
    mv -Tf -- "$staging/build-kit" "$BUILD_ROOT/plugin-manager/build-kit"
    require_file "$BUNDLE/lib/libapp.so"
    install -m644 -- \
        "$BUILD_ROOT/plugin-manager/build-kit/runtime/.denial-ui-source.json" \
        "$BUNDLE/.denial-ui-source.json"
    # The compiled Flutter-tool snapshot is not byte-for-byte reproducible, so
    # every rebuild can have a new kit identity. Only the atomically selected
    # kit is a build output; retaining older copies quickly consumes gigabytes.
    local cached_kit cached_id
    while IFS= read -r -d '' cached_kit; do
        cached_id="${cached_kit##*/}"
        [[ "$cached_id" != "$kit_id" && "$cached_id" =~ ^[0-9a-f]{64}$ ]] \
            || continue
        chmod -R u+w -- "$cached_kit" 2>/dev/null || true
        rm -rf --one-file-system -- "$cached_kit"
    done < <(find "$BUILD_ROOT/plugin-manager/build-kits" \
        -mindepth 1 -maxdepth 1 -type d -print0)

    printf '\nBuilt Plugin Manager and backend at %s\n' "$BUILD_ROOT/plugin-manager/denial-plugins"
)

find_denial_pid() {
    local candidate found="" index
    local -a arguments=()

    while read -r candidate; do
        [[ -n "$candidate" && -r "/proc/$candidate/cmdline" ]] || continue
        arguments=()
        mapfile -d '' -t arguments < "/proc/$candidate/cmdline" || continue
        for ((index = 0; index + 1 < ${#arguments[@]}; index++)); do
            if [[ "${arguments[index]}" == "--flutter-bundle" \
                && "${arguments[index + 1]}" == "$BUNDLE" ]]; then
                [[ -z "$found" ]] \
                    || die "multiple deniald sessions use Flutter bundle $BUNDLE"
                found="$candidate"
                break
            fi
        done
    done < <(ps -C deniald -o pid=)

    [[ -n "$found" ]] || return 1
    printf '%s\n' "$found"
}

# A process-directed signal goes to any thread that does not block it. deniald
# reads its control signals from a signalfd, so a single unmasked thread would
# take the default action and terminate the session.
require_signal_masked() {
    local pid="$1" signal="$2" name="$3" status mask blocked
    for status in "/proc/$pid/task/"*/status; do
        mask="$(awk '/^SigBlk:/ { print $2 }' "$status" 2>/dev/null)" || continue
        [[ $mask =~ ^[0-9a-fA-F]{16}$ ]] || continue
        blocked=$(( 16#${mask:12} >> (signal - 1) & 1 ))
        ((blocked)) \
            || die "deniald process $pid has a thread that does not block $name (${status%/status}); sending it would end the session. Restart Denial into a fixed build first"
    done
}

require_bundle_refresh_support() {
    local pid="$1"
    "/proc/$pid/exe" --help 2>/dev/null \
        | grep -Fq "Control: SIGUSR1 safely refreshes the embedded Flutter bundle in process." \
        || die "running deniald process $pid predates safe in-process bundle refresh support; restart Denial once before using refresh"
    require_signal_masked "$pid" 10 SIGUSR1
}

refresh_bundle() {
    local pid
    pid="$(find_denial_pid)" \
        || die "no running deniald session uses Flutter bundle $BUNDLE"
    require_bundle_refresh_support "$pid"
    build_bundle

    pid="$(find_denial_pid)" \
        || die "the deniald session exited before its Flutter bundle could be refreshed"
    require_bundle_refresh_support "$pid"
    kill -USR1 "$pid" \
        || die "could not request a Flutter bundle refresh from deniald process $pid"
    printf '\nRequested an in-process Flutter bundle refresh from deniald process %s.\n' "$pid"
}

build_compositor() {
    require_flutter_bindings
    run_pinned_cargo build \
        --locked \
        --release \
        --jobs "$BUILD_JOBS" \
        "${COMPOSITOR_DEFAULT_FEATURE_ARGS[@]}" \
        --features "$COMPOSITOR_FEATURES" \
        --bin deniald \
        --bin denialctl
    run_pinned_cargo build \
        --locked \
        --release \
        --jobs "$BUILD_JOBS" \
        -p denial-portal
    require_file "$BINARY"
    require_file "$CONTROL_BINARY"
    require_file "$PORTAL_BINARY"
    printf '\nBuilt %s\nBuilt %s\nBuilt %s\n' \
        "$BINARY" "$CONTROL_BINARY" "$PORTAL_BINARY"
}

build_all() {
    build_bundle
    build_settings
    build_plugin_manager
    build_polkit_agent
    build_compositor
}

test_compositor() {
    local -a kernel_test_filters=()
    if [[ "${DENIAL_SKIP_CPU_CAPACITY_TEST:-0}" == 1 ]]; then
        # RestrictRealtime on the CI runner rejects SCHED_RESET_ON_FORK.
        # Keep this kernel integration test enabled for normal local runs.
        kernel_test_filters=(--skip cpu_scheduling::capacity::tests::hint_preserves_priority_and_does_not_leak_to_new_threads)
    fi
    require_flutter_bindings
    run_pinned_cargo check \
        --locked \
        --jobs "$BUILD_JOBS" \
        --no-default-features \
        --features kms \
        --bin deniald
    run_pinned_cargo check \
        --locked \
        --jobs "$BUILD_JOBS" \
        --no-default-features \
        --features flutter \
        --bin deniald
    command -v dbus-run-session >/dev/null 2>&1 \
        || die "dbus-run-session is required for isolated notification service tests"
    (
        cd -- "$COMPOSITOR_ROOT"
        DENIAL_NOTIFICATION_TEST_BUS=1 \
        DENIAL_FPRINT_TEST_BUS=1 \
        DENIAL_SESSION_LOCK_TEST_BUS=1 \
        CARGO_TARGET_DIR="$RUST_TARGET" \
        dbus-run-session -- cargo test \
            --locked \
            --jobs "$BUILD_JOBS" \
            --lib \
            --bins \
            --tests \
            --features flutter \
            -- "${kernel_test_filters[@]}"
    )
    run_pinned_cargo test \
        --locked \
        --jobs "$BUILD_JOBS" \
        -p denial-flutter-engine
    (
        cd -- "$COMPOSITOR_ROOT"
        require_file "$XDG_DESKTOP_PORTAL_FRONTEND"
        DENIAL_PORTAL_TEST_BUS=1 \
        DENIAL_PORTAL_FRONTEND_TEST="$XDG_DESKTOP_PORTAL_FRONTEND" \
        CARGO_TARGET_DIR="$RUST_TARGET" \
        dbus-run-session -- cargo test \
            --locked \
            --jobs "$BUILD_JOBS" \
            -p denial-portal \
            -- \
            --test-threads=1
    )
}

test_flutter() {
