require_file() {
    [[ -f "$1" ]] || die "missing $1; run '$0 build' first"
}

config_active_lines_equal() {
    local path="$1"
    shift
    local -a actual=()
    local -a expected=("$@")
    local index

    mapfile -t actual < <(
        sed -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' "$path"
    )
    ((${#actual[@]} == ${#expected[@]})) || return 1
    for ((index = 0; index < ${#actual[@]}; index++)); do
        [[ "${actual[index]}" == "${expected[index]}" ]] || return 1
    done
}

is_compatible_legacy_config() {
    local label="$1"
    local path="$2"

    case "$label" in
        "portal routing")
            config_active_lines_equal "$path" \
                '[preferred]' \
                'default=gtk' \
                'org.freedesktop.impl.portal.Settings=denial;gtk' \
                'org.freedesktop.impl.portal.ScreenCast=wlr' \
                'org.freedesktop.impl.portal.Screenshot=wlr'
            ;;
        "wlr portal config")
            config_active_lines_equal "$path" \
                '[screencast]' \
                'chooser_type=dmenu' \
                "chooser_cmd=zenity --list --title='Share your screen' --text='Choose a source to share' --column='Source' --width=520 --height=320"
            ;;
        *) return 1 ;;
    esac
}

require_managed_config_or_absent() {
    local label="$1"
    local path="$2"
    [[ -e "$path" || -L "$path" ]] || return 0
    grep -Fqx "# Installed by $SCRIPT_DIR/denial-pc" "$path" && return 0
    if is_compatible_legacy_config "$label" "$path"; then
        printf 'Adopting compatible legacy %s: %s\n' "$label" "$path"
        return
    fi
    die "refusing to replace unrecognized $label: $path"
}

render_settings_desktop_entry() {
    local destination="$1"
    {
        printf '# Installed by %s/denial-pc\n' "$SCRIPT_DIR"
        sed \
            -e "s|^Exec=.*|Exec=$SETTINGS_BINARY|" \
            -e "s|^TryExec=.*|TryExec=$SETTINGS_BINARY|" \
            "$SETTINGS_DESKTOP_SOURCE"
    } >"$destination"
}

require_managed_settings_desktop_or_absent() {
    [[ -e "$SETTINGS_DESKTOP_FILE" || -L "$SETTINGS_DESKTOP_FILE" ]] \
        || return 0
    grep -Fqx "# Installed by $SCRIPT_DIR/denial-pc" \
        "$SETTINGS_DESKTOP_FILE" \
        || die "refusing to replace unrecognized Settings desktop entry: $SETTINGS_DESKTOP_FILE"
}

install_settings_desktop_entry() {
    require_file "$SETTINGS_DESKTOP_SOURCE"
    require_file "$SETTINGS_BINARY"
    [[ -x "$SETTINGS_BINARY" ]] \
        || die "Settings application is not executable: $SETTINGS_BINARY"
    require_managed_settings_desktop_or_absent

    local rendered
    rendered="$(mktemp)"
    render_settings_desktop_entry "$rendered"
    if [[ -e "$SETTINGS_DESKTOP_FILE" ]] \
        && cmp -s -- "$rendered" "$SETTINGS_DESKTOP_FILE"; then
        rm -f -- "$rendered"
        return
    fi
    if install -Dm644 -- "$rendered" "$SETTINGS_DESKTOP_FILE"; then
        :
    else
        local status=$?
        rm -f -- "$rendered"
        return "$status"
    fi
    rm -f -- "$rendered"
    printf 'Installed %s\n' "$SETTINGS_DESKTOP_FILE"
}

install_welcome_desktop_entries() {
    require_file "$SETTINGS_BINARY"
    local config_home="${XDG_CONFIG_HOME:-${HOME:?HOME is required}/.config}"
    local destination="$USER_DATA_HOME/applications/dev.denial.Welcome.desktop"
    local old_autostart="$config_home/autostart/dev.denial.Welcome.desktop"
    if [[ -e "$destination" || -L "$destination" ]]; then
        grep -Fqx "# Installed by $SCRIPT_DIR/denial-pc" "$destination" \
            || die "refusing to replace unrecognized Welcome entry: $destination"
    fi
    local rendered
    rendered="$(mktemp)"
    {
        printf '# Installed by %s/denial-pc\n' "$SCRIPT_DIR"
        sed -e "s|^Exec=.*|Exec=$SETTINGS_BINARY --welcome|" \
            -e "s|^TryExec=.*|TryExec=$SETTINGS_BINARY|" \
            "$ROOT/packaging/dev.denial.Welcome.desktop"
    } > "$rendered"
    install -Dm644 -- "$rendered" "$destination"
    rm -f -- "$rendered"
    # Startup is compositor-owned now. Remove only this checkout's old entry.
    if [[ -f "$old_autostart" ]] && grep -Fqx \
        "# Installed by $SCRIPT_DIR/denial-pc" "$old_autostart"; then
        rm -f -- "$old_autostart"
    fi
}

remove_welcome_desktop_entries() {
    local config_home="${XDG_CONFIG_HOME:-${HOME:?HOME is required}/.config}"
    local destination
    for destination in "$USER_DATA_HOME/applications/dev.denial.Welcome.desktop" \
        "$config_home/autostart/dev.denial.Welcome.desktop"; do
        if [[ -f "$destination" ]] && grep -Fqx \
            "# Installed by $SCRIPT_DIR/denial-pc" "$destination"; then
            rm -f -- "$destination"
        fi
    done
}

