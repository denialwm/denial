as_root() {
    if [[ "$(id -u)" -eq 0 ]]; then
        "$@"
    else
        sudo "$@"
    fi
}

remove_legacy_session_entry() {
    [[ -e "$LEGACY_SESSION_FILE" ]] || return 0
    if ! grep -Fqx "Name=Denial (Rust)" "$LEGACY_SESSION_FILE" \
        || ! grep -Fqx \
            "Exec=uwsm start -e -D Denial $ROOT/dev/denial-rs-session session" \
            "$LEGACY_SESSION_FILE"; then
        printf 'warning  refusing to remove unrecognized legacy entry %s\n' \
            "$LEGACY_SESSION_FILE" >&2
        return
    fi
    as_root rm -f -- "$LEGACY_SESSION_FILE"
    printf 'Removed obsolete %s\n' "$LEGACY_SESSION_FILE"
}

install_session() {
    require_file "$SESSION_TEMPLATE"
    require_file "$SESSION_TARGET_SOURCE"
    require_file "$SUSPEND_MODE_HOOK_SOURCE"
    require_file "$PORTAL_TEMPLATE"
    require_file "$DENIAL_PORTAL_DESCRIPTOR_SOURCE"
    require_file "$DENIAL_PORTAL_DBUS_TEMPLATE"
    require_file "$DENIAL_PORTAL_UNIT_TEMPLATE"
    require_file "$POLKIT_UNIT_TEMPLATE"
    require_file "$WLR_PORTAL_CONFIG_TEMPLATE"
    require_file "$BINARY"
    require_file "$CONTROL_BINARY"
    require_file "$PORTAL_BINARY"
    require_managed_config_or_absent "portal routing" "$PORTAL_FILE"
    require_managed_config_or_absent "wlr portal config" "$WLR_PORTAL_CONFIG"
    install_settings_desktop_entry
    install_welcome_desktop_entries
    install_plugin_manager_desktop_entry
    if [[ -e "$SESSION_TARGET_FILE" ]] \
        && ! grep -Fqx 'BindsTo=graphical-session.target' "$SESSION_TARGET_FILE"; then
        die "refusing to replace unrecognized session target: $SESSION_TARGET_FILE"
    fi
    if [[ ! -e "$WLR_PORTAL_DESCRIPTOR" ]]; then
        printf 'warning  xdg-desktop-portal-wlr is not installed (%s is missing)\n' \
            "$WLR_PORTAL_DESCRIPTOR" >&2
    fi
    if ! command -v zenity >/dev/null 2>&1; then
        printf 'warning  zenity is not installed; the OBS source selector will not open\n' >&2
    fi

    local rendered portal_rendered wlr_portal_rendered dbus_rendered unit_rendered polkit_rendered
    rendered="$(mktemp)"
    portal_rendered="$(mktemp)"
    wlr_portal_rendered="$(mktemp)"
    dbus_rendered="$(mktemp)"
    unit_rendered="$(mktemp)"
    polkit_rendered="$(mktemp)"
    sed "s|@LAUNCHER@|$SCRIPT_DIR/denial-pc|g" "$POLKIT_UNIT_TEMPLATE" > "$polkit_rendered"
    sed "s|@LAUNCHER@|$SCRIPT_DIR/denial-pc|g" "$SESSION_TEMPLATE" > "$rendered"
    sed "s|@LAUNCHER@|$SCRIPT_DIR/denial-pc|g" \
        "$PORTAL_TEMPLATE" > "$portal_rendered"
    sed "s|@LAUNCHER@|$SCRIPT_DIR/denial-pc|g" \
        "$WLR_PORTAL_CONFIG_TEMPLATE" > "$wlr_portal_rendered"
    sed "s|@PORTAL_BINARY@|$PORTAL_BINARY|g" \
        "$DENIAL_PORTAL_DBUS_TEMPLATE" > "$dbus_rendered"
    sed "s|@PORTAL_BINARY@|$PORTAL_BINARY|g" \
        "$DENIAL_PORTAL_UNIT_TEMPLATE" > "$unit_rendered"
    sh -n "$SUSPEND_MODE_HOOK_SOURCE"
    if as_root install -Dm644 "$rendered" "$SESSION_FILE" \
        && as_root install -Dm644 "$SESSION_TARGET_SOURCE" "$SESSION_TARGET_FILE" \
        && as_root install -Dm755 "$SUSPEND_MODE_HOOK_SOURCE" "$SUSPEND_MODE_HOOK_FILE" \
        && as_root install -Dm644 "$portal_rendered" "$PORTAL_FILE" \
        && as_root install -Dm644 "$wlr_portal_rendered" "$WLR_PORTAL_CONFIG" \
        && as_root install -Dm644 "$DENIAL_PORTAL_DESCRIPTOR_SOURCE" "$DENIAL_PORTAL_DESCRIPTOR" \
        && as_root install -Dm644 "$dbus_rendered" "$DENIAL_PORTAL_DBUS_SERVICE" \
        && as_root install -Dm644 "$unit_rendered" "$DENIAL_PORTAL_UNIT" \
        && as_root install -Dm644 "$polkit_rendered" "$POLKIT_UNIT"; then
        :
    else
        local status=$?
        rm -f -- "$rendered" "$portal_rendered" "$wlr_portal_rendered" \
            "$dbus_rendered" "$unit_rendered" "$polkit_rendered"
        return "$status"
    fi
    rm -f -- "$rendered" "$portal_rendered" "$wlr_portal_rendered" \
        "$dbus_rendered" "$unit_rendered" "$polkit_rendered"
    systemctl --user daemon-reload >/dev/null 2>&1 || true
    remove_legacy_session_entry
    printf 'Installed %s\nInstalled %s\nInstalled %s\nInstalled %s\nInstalled %s\nInstalled %s\nInstalled %s\nInstalled %s\n' \
        "$SESSION_FILE" "$SESSION_TARGET_FILE" "$PORTAL_FILE" "$WLR_PORTAL_CONFIG" \
        "$DENIAL_PORTAL_DESCRIPTOR" "$DENIAL_PORTAL_DBUS_SERVICE" "$DENIAL_PORTAL_UNIT" \
        "$SUSPEND_MODE_HOOK_FILE"
    printf 'Log out, then choose "Denial (development)" in the display manager.\n'
}

install_engine_test_session() {
    require_file "$ENGINE_TEST_SESSION_TEMPLATE"
    select_engine_test

    local rendered
    rendered="$(mktemp)"
    sed "s|@LAUNCHER@|$SCRIPT_DIR/denial-pc|g" \
        "$ENGINE_TEST_SESSION_TEMPLATE" > "$rendered"
    if as_root install -Dm644 "$rendered" "$ENGINE_TEST_SESSION_FILE"; then
        :
    else
        local status=$?
        rm -f -- "$rendered"
        return "$status"
    fi
    rm -f -- "$rendered"
    printf 'Installed %s\n' "$ENGINE_TEST_SESSION_FILE"
    printf 'Log out, then choose "Denial (engine test)" in the display manager.\n'
}

remove_engine_test_session() {
    if [[ ! -e "$ENGINE_TEST_SESSION_FILE" ]]; then
        printf 'Already absent: %s\n' "$ENGINE_TEST_SESSION_FILE"
        return
    fi
    grep -Fqx \
        "X-Denial-Engine-Test-Launcher=$SCRIPT_DIR/denial-pc" \
        "$ENGINE_TEST_SESSION_FILE" \
        || die "refusing to remove an engine-test entry not installed by this checkout: $ENGINE_TEST_SESSION_FILE"
    as_root rm -f -- "$ENGINE_TEST_SESSION_FILE"
    printf 'Removed %s\n' "$ENGINE_TEST_SESSION_FILE"
}

remove_portal_entry() {
    [[ -e "$PORTAL_FILE" ]] || return 0
    if ! grep -Fqx "# Installed by $SCRIPT_DIR/denial-pc" "$PORTAL_FILE"; then
        printf 'warning  refusing to remove unrecognized portal routing %s\n' \
            "$PORTAL_FILE" >&2
        return
    fi
    as_root rm -f -- "$PORTAL_FILE"
    printf 'Removed %s\n' "$PORTAL_FILE"
}

remove_wlr_portal_config() {
    [[ -e "$WLR_PORTAL_CONFIG" ]] || return 0
    if ! grep -Fqx "# Installed by $SCRIPT_DIR/denial-pc" "$WLR_PORTAL_CONFIG"; then
        printf 'warning  refusing to remove unrecognized wlr portal config %s\n' \
            "$WLR_PORTAL_CONFIG" >&2
        return
    fi
    as_root rm -f -- "$WLR_PORTAL_CONFIG"
    printf 'Removed %s\n' "$WLR_PORTAL_CONFIG"
}

remove_settings_desktop_entry() {
    [[ -e "$SETTINGS_DESKTOP_FILE" || -L "$SETTINGS_DESKTOP_FILE" ]] \
        || return 0
    if ! grep -Fqx "# Installed by $SCRIPT_DIR/denial-pc" \
        "$SETTINGS_DESKTOP_FILE"; then
        printf 'warning  refusing to remove unrecognized Settings desktop entry %s\n' \
            "$SETTINGS_DESKTOP_FILE" >&2
        return
    fi
    rm -f -- "$SETTINGS_DESKTOP_FILE"
    printf 'Removed %s\n' "$SETTINGS_DESKTOP_FILE"
}

remove_denial_portal_metadata() {
    if [[ -e "$DENIAL_PORTAL_DESCRIPTOR" ]] \
        && ! cmp -s -- "$DENIAL_PORTAL_DESCRIPTOR_SOURCE" "$DENIAL_PORTAL_DESCRIPTOR"; then
        printf 'warning  refusing to remove unrecognized Denial portal descriptor %s\n' \
            "$DENIAL_PORTAL_DESCRIPTOR" >&2
    else
        as_root rm -f -- "$DENIAL_PORTAL_DESCRIPTOR"
    fi
    if [[ -e "$DENIAL_PORTAL_DBUS_SERVICE" ]] \
        && { ! grep -Fqx "Name=org.freedesktop.impl.portal.desktop.denial" "$DENIAL_PORTAL_DBUS_SERVICE" \
            || ! grep -Fqx "Exec=$PORTAL_BINARY" "$DENIAL_PORTAL_DBUS_SERVICE"; }; then
        printf 'warning  refusing to remove unrecognized Denial portal D-Bus service %s\n' \
            "$DENIAL_PORTAL_DBUS_SERVICE" >&2
    else
        as_root rm -f -- "$DENIAL_PORTAL_DBUS_SERVICE"
    fi
    if [[ -e "$DENIAL_PORTAL_UNIT" ]] \
        && { ! grep -Fqx "BusName=org.freedesktop.impl.portal.desktop.denial" "$DENIAL_PORTAL_UNIT" \
            || ! grep -Fqx "ExecStart=$PORTAL_BINARY" "$DENIAL_PORTAL_UNIT"; }; then
        printf 'warning  refusing to remove unrecognized Denial portal unit %s\n' \
            "$DENIAL_PORTAL_UNIT" >&2
    else
        as_root rm -f -- "$DENIAL_PORTAL_UNIT"
    fi
    systemctl --user daemon-reload >/dev/null 2>&1 || true
}

remove_session_target() {
    if [[ -e "$POLKIT_UNIT" ]] && grep -Fqx "# Installed by $SCRIPT_DIR/denial-pc" "$POLKIT_UNIT"; then
        as_root rm -f -- "$POLKIT_UNIT"
    fi
    [[ -e "$SESSION_TARGET_FILE" ]] || return 0
    if ! grep -Fqx 'BindsTo=graphical-session.target' "$SESSION_TARGET_FILE"; then
        printf 'warning  refusing to remove unrecognized session target %s\n' \
            "$SESSION_TARGET_FILE" >&2
        return
    fi
    as_root rm -f -- "$SESSION_TARGET_FILE"
    systemctl --user daemon-reload >/dev/null 2>&1 || true
    printf 'Removed %s\n' "$SESSION_TARGET_FILE"
}

remove_session() {
    if [[ ! -e "$SESSION_FILE" ]]; then
        printf 'Already absent: %s\n' "$SESSION_FILE"
        remove_portal_entry
        remove_denial_portal_metadata
        remove_session_target
        remove_settings_desktop_entry
        remove_welcome_desktop_entries
    local plugin_entry="$USER_DATA_HOME/applications/dev.denial.PluginManager.desktop"
    if [[ -f "$plugin_entry" ]] && grep -Fqx "# Installed by $SCRIPT_DIR/denial-pc" "$plugin_entry"; then
        rm -f -- "$plugin_entry"
    fi
        remove_wlr_portal_config
        return
    fi
    grep -Fq "X-Denial-Launcher=$SCRIPT_DIR/denial-pc" "$SESSION_FILE" \
        || die "refusing to remove a session entry not installed by this checkout: $SESSION_FILE"
    as_root rm -f -- "$SESSION_FILE"
    printf 'Removed %s\n' "$SESSION_FILE"
    remove_portal_entry
    remove_denial_portal_metadata
    remove_session_target
    remove_settings_desktop_entry
    remove_welcome_desktop_entries
    local plugin_entry="$USER_DATA_HOME/applications/dev.denial.PluginManager.desktop"
    if [[ -f "$plugin_entry" ]] && grep -Fqx "# Installed by $SCRIPT_DIR/denial-pc" "$plugin_entry"; then
        rm -f -- "$plugin_entry"
    fi
    remove_wlr_portal_config
}

case "${1:-}" in
    bootstrap) bootstrap_dependencies ;;
    bundle) build_bundle ;;
    settings) build_settings ;;
    welcome) build_settings; install_welcome_desktop_entries ;;
    refresh) refresh_bundle ;;
    kms-refresh) request_kms_reconfigure ;;
    compositor) build_compositor ;;
    build) build_all ;;
    arch-package) "$ROOT/tools/package-denial-arch" ;;
    debian-package) "$ROOT/tools/package-denial-deb" ;;
    fedora-package) "$ROOT/tools/package-denial-rpm" ;;
    opensuse-package) "$ROOT/tools/package-denial-opensuse-rpm" ;;
    alpine-package) "$ROOT/tools/package-denial-apk" ;;
    native-packages) "$ROOT/tools/package-denial-native" ;;
    flutter-test)
        shift
        test_flutter "$@"
        ;;
    plugin-manager) build_plugin_manager ;;
    polkit-agent) build_polkit_agent ;;
    polkit-agent-run) run_polkit_agent ;;
    compositor-test) test_compositor ;;
    plugin-check) check_plugins ;;
    sdk-test)
        shift
        test_sdk "$@"
        ;;
    test) test_all ;;
    session) run_display_manager_session ;;
    engine-test-build) stage_engine_test ;;
    engine-test-check) check_engine_test ;;
    engine-test-arm) arm_engine_test ;;
    engine-test-cancel) cancel_engine_test ;;
    engine-test-session) run_engine_test_session ;;
    doctor) doctor ;;
    install-session) install_session ;;
    install-settings-entry) install_settings_desktop_entry ;;
    install-welcome-entry) install_welcome_desktop_entries ;;
    install-plugin-manager-entry) install_plugin_manager_desktop_entry ;;
    install-engine-test-session) install_engine_test_session ;;
    remove-session) remove_session ;;
    remove-engine-test-session) remove_engine_test_session ;;
    help|-h|--help|'') usage ;;
    *) die "unknown command '$1' (try '$0 help')" ;;
esac
