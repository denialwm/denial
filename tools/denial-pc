FLUTTER_SDK_REVISION="$(jq -er '.flutter.revision' "$FLUTTER_SOURCE_LOCK")"
FLUTTER_UPSTREAM_REVISION="$(
    jq -er '.flutter.upstream_revision' "$FLUTTER_SOURCE_LOCK"
)"
if [[ -n "${DENIAL_FLUTTER_SOURCE_ROOT:-}" \
    && -n "${DENIAL_FLUTTER_SDK_ROOT:-}" \
    && "${DENIAL_FLUTTER_SOURCE_ROOT:-}" != "${DENIAL_FLUTTER_SDK_ROOT:-}" ]]; then
    printf 'denial-pc: DENIAL_FLUTTER_SOURCE_ROOT conflicts with DENIAL_FLUTTER_SDK_ROOT\n' >&2
