test_sdk() (
    prepare_flutter_toolchain
    local dart="$FLUTTER_SDK_ROOT/bin/cache/dart-sdk/bin/dart"
    require_file "$dart"
    cd -- "$ROOT/packages/denial_sdk"
    "$dart" pub get --enforce-lockfile
    "$dart" format --output=none --set-exit-if-changed lib example test
    "$dart" analyze --fatal-infos
    "$dart" test "$@"
)

check_plugins() (
    prepare_flutter_toolchain
    "$ROOT/tools/denial-flutter-engine" prepare-app-build
    local dart="$FLUTTER_SDK_ROOT/bin/cache/dart-sdk/bin/dart"
    local package
    for package in packages/denial_flutter_sdk plugins/denial_top_bar plugins/denial_desktop plugins/denial_launcher plugins/denial_clock plugins/denial_clock/ui plugins/denial_pets; do
        (
            cd -- "$ROOT/$package"
            "$FLUTTER" pub get --enforce-lockfile
            # Pub's SDK source is upstream cached sky_engine. The public SDK
            # exposes Denial engine primitives, so analyze with the declarations
            # produced by the same locked release build as the platform dill.
            python3 - .dart_tool/package_config.json \
                "$LOCAL_ENGINE_SRC_PATH/out/$LOCAL_ENGINE_TARGET/gen/dart-pkg/sky_engine" <<'PYSDK'
import json, pathlib, sys
config = pathlib.Path(sys.argv[1])
engine = pathlib.Path(sys.argv[2]).resolve()
assert (engine / 'pubspec.yaml').is_file(), engine
data = json.loads(config.read_text())
for package in data['packages']:
    if package['name'] == 'sky_engine':
        package['rootUri'] = engine.as_uri()
config.write_text(json.dumps(data, indent=2) + '\n')
PYSDK
            "$dart" format --output=none --set-exit-if-changed lib
            "$dart" analyze --fatal-infos
            if [[ "$package" == packages/denial_flutter_sdk ]]; then
                # Core SDK persistence and lifecycle tests need no development engine.
                "$dart" test test/glass_configuration_test.dart test/surface_events_test.dart test/settings_document_test.dart test/bridge_transport_test.dart
            fi
            if [[ "$package" == plugins/denial_pets ]]; then
                # The perching rule is plain Dart.
                "$dart" test
            fi
        )
    done
    (
        cd -- "$ROOT/packages/denial_plugin_manager"
        "$dart" pub get --enforce-lockfile
        "$dart" format --output=none --set-exit-if-changed lib bin test
        "$dart" analyze --fatal-infos
        # These files compile and launch detached worker fixtures. Serial files
        # avoid competing compiler startups exhausting bounded readiness waits.
        "$dart" test --concurrency=1
    )
    (
        cd -- "$ROOT/plugin_manager_app"
        "$FLUTTER" pub get --enforce-lockfile
        "$dart" format --output=none --set-exit-if-changed lib tool
        "$dart" analyze --fatal-infos
        local check
        for check in tool/check_*.dart; do
            "$dart" run "$check"
        done
    )
)

test_all() {
    test_sdk
