#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"

failures=0
warnings=0

usage() {
  cat <<'EOF'
Usage:
  tools/denial-release doctor [--ci] [--branch BRANCH] [--release-tag TAG]
  tools/denial-release source-audit [--branch BRANCH] [--development]
                                    [--public-alpha TAG]

Commands:
  doctor        Inspect an Arch x86-64 release-builder host.
  source-audit  Verify committed source, manifests, and Arch PKGBUILDs.

Options:
  --ci              Require the protected manual GitHub runner context.
  --branch BRANCH   Require the main or dev validation branch (default: main).
  --release-tag TAG Require a manual workflow running from this version tag.
  --development     Allow a dirty checkout, reported as a warning.
  --public-alpha TAG
                    Audit a clean version-tag checkout for public-alpha use.

Neither command builds, signs, attests, or publishes a package.
EOF
}

pass() {
  printf 'PASS  %s\n' "$*"
}

warn() {
  warnings=$((warnings + 1))
  printf 'WARN  %s\n' "$*"
}

fail() {
  failures=$((failures + 1))
  printf 'FAIL  %s\n' "$*"
}

finish() {
  printf '\nResult: %d failure(s), %d warning(s)\n' "$failures" "$warnings"
  ((failures == 0))
}

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

check_command() {
  local command_name="$1"
  if command_exists "$command_name"; then
    pass "command available: $command_name"
  else
    fail "missing required command: $command_name"
  fi
}

check_bwrap_network_isolation() {
  local output

  command_exists bwrap || return
  if output="$(
    bwrap \
      --die-with-parent \
      --unshare-user \
      --unshare-pid \
      --unshare-net \
      --unshare-ipc \
      --unshare-uts \
      --unshare-cgroup-try \
      --new-session \
      --ro-bind / / \
      -- /usr/bin/true \
      2>&1
  )"; then
    pass 'bubblewrap can create the package-build private network namespace'
  else
    fail 'bubblewrap cannot create the package-build private network namespace'
    [[ -z "$output" ]] || printf 'INFO  bubblewrap: %s\n' "$output"
  fi
}

existing_path_for() {
  local candidate="$1"
  local parent

  while [[ ! -e "$candidate" ]]; do
    parent="$(dirname -- "$candidate")"
    if [[ "$parent" == "$candidate" ]]; then
      return 1
    fi
    candidate="$parent"
  done
  printf '%s\n' "$candidate"
}

doctor() {
  local require_ci=0
  local architecture
  local available_kib
  local available_gib
  local builder_root
  local disk_probe
  local memory_gib
  local memory_kib
  local release_tag=''
  local validation_branch='main'
  local required_commands=(
    actionlint
    arch-nspawn
    awk
    bash
    bsdtar
    bwrap
    cargo
    clang
    cmake
    diffoscope
    flock
    git
    gn
    gpg
    jq
    ld.lld
    lddtree
    makechrootpkg
    makepkg
    makerepropkg
    mkarchroot
    namcap
    ninja
    objdump
    patchelf
    pkg-config
    pkgctl
    python3
    readelf
    repo-add
    rustc
    sha256sum
    shellcheck
    sudo
    systemd-nspawn
    unshare
    zstd
  )

  while (($#)); do
    case "$1" in
      --ci) require_ci=1 ;;
      --branch)
        (($# >= 2)) \
          || {
            printf 'denial-release: --branch requires a value\n' >&2
            return 2
          }
        validation_branch="$2"
        shift
        ;;
      --release-tag)
        (($# >= 2)) \
          || {
            printf 'denial-release: --release-tag requires a value\n' >&2
            return 2
          }
        release_tag="$2"
        shift
        ;;
      -h | --help)
        usage
        return 0
        ;;
      *)
        printf 'denial-release: unknown doctor option: %s\n' "$1" >&2
        return 2
        ;;
    esac
    shift
  done
  case "$validation_branch" in
    main | dev) ;;
    *)
      printf 'denial-release: --branch must be main or dev\n' >&2
      return 2
      ;;
  esac

  printf 'Denial x86-64 builder qualification\n\n'

  if [[ -r /etc/arch-release ]]; then
    pass 'host is Arch Linux'
  else
    fail 'host is not an Arch Linux installation'
  fi

  architecture="$(uname -m)"
  if [[ "$architecture" == x86_64 ]]; then
    pass 'native architecture is x86_64'
  else
    fail "native architecture is $architecture, expected x86_64"
  fi

  if ((EUID == 0)); then
    fail 'runner must use a dedicated unprivileged account, not root'
  else
    pass "runner account is unprivileged: $(id -un)"
  fi

  memory_kib="$(
    awk '$1 == "MemTotal:" { print $2; exit }' /proc/meminfo
  )"
  memory_gib=$((memory_kib / 1024 / 1024))
  if ((memory_gib >= 32)); then
    pass "physical memory is ${memory_gib} GiB"
  elif ((memory_gib >= 24)); then
    warn "physical memory is ${memory_gib} GiB; 32 GiB or more is preferred"
  else
    fail "physical memory is ${memory_gib} GiB; at least 24 GiB is required"
  fi

  builder_root="${DENIAL_BUILDER_ROOT:-${HOME:?HOME is required}/.cache/denial-builder}"
  if disk_probe="$(existing_path_for "$builder_root")"; then
    available_kib="$(
      df -Pk -- "$disk_probe" \
        | awk 'NR == 2 { print $4 }'
    )"
    available_gib=$((available_kib / 1024 / 1024))
    if ((available_gib >= 150)); then
      pass "builder filesystem has ${available_gib} GiB free"
    elif ((available_gib >= 80)); then
      warn "builder filesystem has ${available_gib} GiB free; 150 GiB is preferred"
    else
      fail "builder filesystem has ${available_gib} GiB free; at least 80 GiB is required"
    fi
    printf 'INFO  builder root: %s\n' "$builder_root"
  else
    fail "could not locate a filesystem for builder root: $builder_root"
  fi

  for command_name in "${required_commands[@]}"; do
    check_command "$command_name"
  done
  check_bwrap_network_isolation

  if command_exists timedatectl \
    && [[ "$(timedatectl show -p NTPSynchronized --value 2>/dev/null || true)" == yes ]]; then
    pass 'system clock reports network synchronization'
  else
    warn 'system clock synchronization could not be confirmed'
  fi

  if ((require_ci)); then
    if [[ "${GITHUB_ACTIONS:-}" == true ]]; then
      pass 'running under GitHub Actions'
    else
      fail 'not running under GitHub Actions'
    fi
    if [[ -n "$release_tag" ]]; then
      if [[ "${GITHUB_EVENT_NAME:-}" == workflow_dispatch ]]; then
        pass 'release workflow was triggered manually'
      else
        fail "unexpected release workflow event: ${GITHUB_EVENT_NAME:-unset}"
      fi
      if [[ "$release_tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        pass "release tag has the required form: $release_tag"
      else
        fail "invalid release tag: $release_tag"
      fi
      if [[ "${GITHUB_REF:-}" == "refs/tags/${release_tag}" ]]; then
        pass "workflow ref is refs/tags/${release_tag}"
      else
        fail "unexpected workflow ref: ${GITHUB_REF:-unset}"
      fi
    else
      case "${GITHUB_EVENT_NAME:-}" in
        push)
          pass 'validation workflow was triggered by a push'
          ;;
        workflow_dispatch)
          pass 'validation workflow was triggered manually'
          ;;
        *)
          fail "unexpected validation workflow event: ${GITHUB_EVENT_NAME:-unset}"
          ;;
      esac
      if [[ "${GITHUB_REF:-}" == "refs/heads/${validation_branch}" ]]; then
        pass "workflow ref is refs/heads/${validation_branch}"
      else
        fail "unexpected workflow ref: ${GITHUB_REF:-unset}"
      fi
    fi
    if [[ "${RUNNER_OS:-}" == Linux ]]; then
      pass 'GitHub runner OS is Linux'
    else
      fail "unexpected runner OS: ${RUNNER_OS:-unset}"
    fi
    if [[ "${RUNNER_ARCH:-}" == X64 ]]; then
      pass 'GitHub runner architecture is X64'
    else
      fail "unexpected runner architecture: ${RUNNER_ARCH:-unset}"
    fi
  fi

  warn 'signing-key separation requires an operational review; it is not inferred from this host scan'
  finish
}

check_equal() {
  local label="$1"
  local expected="$2"
  local actual="$3"

  if [[ "$actual" == "$expected" ]]; then
    pass "$label"
  else
    fail "$label: expected $expected, got $actual"
  fi
}

file_sha256() {
  sha256sum "$1" | awk '{ print $1 }'
}

source_audit() {
  local allow_dirty=0
  local actual
  local cargo_lock_version
  local cargo_version
  local dart_version
  local debug_engine_dir="$ROOT/prebuilt/flutter-engine/linux-x64-debug"
  local engine_dir="$ROOT/prebuilt/flutter-engine/linux-x64-release"
  local engine_package_epoch
  local engine_package_version
  local flutter_tool_dir="$ROOT/prebuilt/flutter-tools/3.44.7"
  local github_sha
  local installer_fingerprint
  local installer_key_url
  local makepkg_audit_root
  local manifest="$ROOT/packaging/arch/flutter-engine/manifest.json"
  local package_version
  local profile_engine_dir="$ROOT/prebuilt/flutter-engine/linux-x64-profile"
  local public_alpha_tag=''
  local public_key="$ROOT/packaging/arch/denial-repo-key.asc"
  local public_key_fingerprint
  local remote
  local rust_toolchain="$ROOT/rust-toolchain.toml"
  local rust_toolchain_channel
  local status
  local source_lock="$ROOT/prebuilt/flutter-engine/SOURCE_LOCK.json"
  local ui_dependency_bounds
  local ui_manifest="$ROOT/packaging/arch/ui-development/manifest.json"
  local ui_package_version
  local validation_branch='main'
  local version_major
  local version_minor
  local version_patch
  local workflow_file

  while (($#)); do
    case "$1" in
      --branch)
        (($# >= 2)) \
          || {
            printf 'denial-release: --branch requires a value\n' >&2
            return 2
          }
        validation_branch="$2"
        shift
        ;;
      --development) allow_dirty=1 ;;
      --public-alpha)
        (($# >= 2)) \
          || {
            printf 'denial-release: --public-alpha requires a tag\n' >&2
            return 2
          }
        public_alpha_tag="$2"
        shift
        ;;
      -h | --help)
        usage
        return 0
        ;;
      *)
        printf 'denial-release: unknown source-audit option: %s\n' "$1" >&2
        return 2
        ;;
    esac
    shift
  done
  case "$validation_branch" in
    main | dev) ;;
    *)
      printf 'denial-release: --branch must be main or dev\n' >&2
      return 2
      ;;
  esac

  printf 'Denial committed-source audit\n\n'

  for command_name in bash find git gpg jq makepkg sha256sum; do
    if ! command_exists "$command_name"; then
      fail "missing required command: $command_name"
    fi
  done
  if ((failures)); then
    finish
    return
  fi

  if git -C "$ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    pass 'repository is a Git working tree'
  else
    fail 'repository is not a Git working tree'
    finish
    return
  fi

  remote="$(git -C "$ROOT" remote get-url origin 2>/dev/null || true)"
  case "$remote" in
    https://github.com/denialwm/denial.git | git@github.com:denialwm/denial.git)
      pass 'origin identifies denialwm/denial'
      ;;
    *)
      warn "origin is not the canonical Denial URL: ${remote:-unset}"
      ;;
  esac

  status="$(git -C "$ROOT" status --porcelain --untracked-files=normal)"
  if [[ -z "$status" ]]; then
    pass 'checkout is clean'
  elif ((allow_dirty)); then
    warn 'checkout is dirty; development override accepted'
  else
    fail 'checkout is dirty'
  fi

  if git -C "$ROOT" diff --check; then
    pass 'working-tree diff has no whitespace errors'
  else
    fail 'working-tree diff contains whitespace errors'
  fi
  if git -C "$ROOT" show --check --format= HEAD >/dev/null; then
    pass 'HEAD commit has no whitespace errors'
  else
    fail 'HEAD commit contains whitespace errors'
  fi
  if git -C "$ROOT" fsck --strict --no-dangling --no-progress >/dev/null; then
    pass 'Git object graph passes strict verification'
  else
    fail 'Git object graph failed strict verification'
  fi

  if [[ -f "$rust_toolchain" ]]; then
    rust_toolchain_channel="$(
      sed -n 's/^channel = "\([^"]*\)"$/\1/p' "$rust_toolchain"
    )"
    check_equal \
      'repository-level Rust toolchain is pinned' \
      '1.95.0' \
      "$rust_toolchain_channel"
  else
    fail 'repository-level rust-toolchain.toml is missing'
  fi
  if [[ -e "$ROOT/compositor/rust-toolchain.toml" ]]; then
    fail 'compositor has a duplicate Rust toolchain pin'
  else
    pass 'repository has one canonical Rust toolchain pin'
  fi

  if [[ "${GITHUB_ACTIONS:-}" == true ]]; then
    if [[ -n "$public_alpha_tag" ]]; then
      github_sha="${GITHUB_SHA:-unset}"
      if [[ "$github_sha" == "$(git -C "$ROOT" rev-parse HEAD)" \
        || "$github_sha" == "$(
          git -C "$ROOT" rev-parse "$public_alpha_tag"
        )" ]]; then
        pass 'checked-out release commit matches the GitHub tag context'
      else
        fail \
          "checked-out release commit does not match GITHUB_SHA: $github_sha"
      fi
      check_equal \
        'public-alpha workflow uses the requested tag' \
        "refs/tags/${public_alpha_tag}" \
        "${GITHUB_REF:-unset}"
    else
      check_equal \
        'checked-out commit matches GITHUB_SHA' \
        "${GITHUB_SHA:-unset}" \
        "$(git -C "$ROOT" rev-parse HEAD)"
      check_equal \
        'validation workflow uses the requested branch' \
        "refs/heads/${validation_branch}" \
        "${GITHUB_REF:-unset}"
    fi
  fi

  if jq -e '
      .schema_version == 1
      and .stage == "public-alpha"
      and .package.name == "denial-flutter-engine"
      and .package.version_source == "denial-release-tag"
      and .package.epoch == 1
      and .package.architecture == "x86_64"
      and .compatibility.flutter_engine_abi == "3.44.7.denial1"
      and .assurances.offline_source_closure == false
      and .assurances.reproducible_package == false
      and .assurances.signed_generation_tags == false
    ' "$manifest" >/dev/null; then
    pass 'engine manifest states the public-alpha assurances accurately'
  else
    fail 'engine manifest schema, architecture, or assurance state is invalid'
  fi
  if jq -e '
      .schema_version == 1
      and .stage == "public-alpha"
      and .package.name == "denial-ui-development"
      and .package.architecture == "x86_64"
      and .compatibility.denial_ui_development_api == 1
      and .compatibility.flutter_engine_abi == "3.44.7.denial1"
      and .runtime.engine_mode == "debug-jit"
      and .runtime.flutter_tool_snapshot_kind == "app-aot-elf"
      and .runtime.flutter_tool_runtime == "dartaotruntime"
      and .runtime.flutter_tool_target_cpu == "generic-x64"
      and .runtime.editor_attach_mode == "non-pausing"
      and .runtime.dap_debugger_control == false
      and .runtime.hot_reload == true
      and .runtime.flutter_inspector == true
      and .assurances.offline_source_closure == false
      and .assurances.reproducible_package == false
      and .assurances.independently_reproduced == false
    ' "$ui_manifest" >/dev/null; then
    pass 'UI-development manifest states its public-alpha boundary accurately'
  else
    fail 'UI-development manifest schema, runtime, or assurance state is invalid'
  fi

  if jq -e '
      .schema_version == 1
      and .flutter.repository == "https://github.com/denialwm/flutter.git"
      and .flutter.branch == "denial/3.44.7-r1"
      and (.flutter.revision | test("^[0-9a-f]{40}$"))
      and (.flutter.upstream_revision | test("^[0-9a-f]{40}$"))
      and .skia.repository == "https://github.com/denialwm/skia.git"
      and .skia.branch == "denial/3.44.7-r1"
      and (.skia.revision | test("^[0-9a-f]{40}$"))
      and (.skia.upstream_revision | test("^[0-9a-f]{40}$"))
      and .depot_tools.repository ==
        "https://chromium.googlesource.com/chromium/tools/depot_tools.git"
      and (.depot_tools.revision | test("^[0-9a-f]{40}$"))
    ' "$source_lock" >/dev/null; then
    pass 'Flutter and Skia fork source lock is valid'
  else
    fail 'Flutter and Skia fork source lock is invalid'
  fi
  if [[ ! -d "$ROOT/patches" ]] \
    && [[ -z "$(
      find "$ROOT" \
        -path "$ROOT/.git" -prune \
        -o -type f -name '*.patch' -print -quit
    )" ]]; then
    pass 'repository contains no downstream patch series'
  else
    fail 'downstream patches must live as commits in the Flutter or Skia fork'
  fi
  if [[ -x "$ROOT/tools/denial-flutter-engine" ]] \
    && [[ "$("$ROOT/tools/denial-flutter-engine" cache-key)" \
      =~ ^[0-9a-f]{64}$ ]]; then
    pass 'Flutter Engine fork builder has a valid immutable cache key'
  else
    fail 'Flutter Engine fork builder or its cache key is invalid'
  fi
  for workflow_file in \
    "$ROOT/.github/workflows/branch-validation.yml" \
    "$ROOT/.github/workflows/builder-qualification.yml" \
    "$ROOT/.github/workflows/release.yml"; do
    if grep -Fq 'tools/denial-flutter-engine build' "$workflow_file"; then
      pass "$(basename -- "$workflow_file") builds or reuses the fork engine"
    else
      fail "$(basename -- "$workflow_file") bypasses the fork engine builder"
    fi
  done
  if grep -R -Fq \
      '/srv/denial-builder/artifacts/flutter-engine/' \
      "$ROOT/.github/workflows" \
      "$ROOT/packaging/arch/runner"; then
    fail 'pipeline still consumes manually staged Flutter Engine artifacts'
  else
    pass 'pipeline does not consume manually staged Flutter Engine artifacts'
  fi
  if (
    cd "$ROOT/dart_shell/assets/fonts"
    sha256sum --check --strict JetBrainsMono.sha256
  ) >/dev/null; then
    pass 'bundled JetBrains Mono files match their source manifest'
  else
    fail 'bundled JetBrains Mono files failed source verification'
  fi
  if (
    cd "$ROOT"
    sha256sum --check --strict \
      dart_shell/assets/cursors/bibata_modern_ice.sha256
  ) >/dev/null; then
    pass 'bundled Bibata cursor frames match their import manifest'
  else
    fail 'bundled Bibata cursor frames failed source verification'
  fi

  check_equal \
    'engine manifest identifies the source lock' \
    "$(jq -r '.source_lock.sha256' "$manifest")" \
    "$(file_sha256 "$source_lock")"
  check_equal \
    'engine manifest uses the canonical source-lock path' \
    'prebuilt/flutter-engine/SOURCE_LOCK.json' \
    "$(jq -r '.source_lock.path' "$manifest")"
  check_equal \
    'UI manifest uses the canonical source-lock path' \
    'prebuilt/flutter-engine/SOURCE_LOCK.json' \
    "$(jq -r '.source_lock.path' "$ui_manifest")"
  check_equal \
    'UI manifest identifies the source lock' \
    "$(jq -r '.source_lock.sha256' "$ui_manifest")" \
    "$(file_sha256 "$source_lock")"
  check_equal \
    'engine manifest identifies the Flutter fork commit' \
    "$(jq -r '.sources.flutter_fork_revision' "$manifest")" \
    "$(jq -r '.flutter.revision' "$source_lock")"
  check_equal \
    'engine manifest identifies the Skia fork commit' \
    "$(jq -r '.sources.skia_fork_revision' "$manifest")" \
    "$(jq -r '.skia.revision' "$source_lock")"
  check_equal \
    'UI manifest identifies the Flutter fork commit' \
    "$(jq -r '.sources.flutter_fork_revision' "$ui_manifest")" \
    "$(jq -r '.flutter.revision' "$source_lock")"
  check_equal \
    'UI manifest identifies the Skia fork commit' \
    "$(jq -r '.sources.skia_fork_revision' "$ui_manifest")" \
    "$(jq -r '.skia.revision' "$source_lock")"
  check_equal \
    'engine manifest identifies the Flutter fork repository' \
    "$(jq -r '.sources.flutter_repository' "$manifest")" \
    "$(jq -r '.flutter.repository' "$source_lock")"
  check_equal \
    'engine manifest identifies the Skia fork repository' \
    "$(jq -r '.sources.skia_repository' "$manifest")" \
    "$(jq -r '.skia.repository' "$source_lock")"
  check_equal \
    'engine manifest identifies the upstream Flutter compatibility revision' \
    "$(jq -r '.sources.flutter_revision' "$manifest")" \
    "$(jq -r '.flutter.upstream_revision' "$source_lock")"
  check_equal \
    'engine manifest identifies the upstream Skia compatibility revision' \
    "$(jq -r '.sources.skia_revision' "$manifest")" \
    "$(jq -r '.skia.upstream_revision' "$source_lock")"
  check_equal \
    'UI manifest identifies the upstream Flutter compatibility revision' \
    "$(jq -r '.sources.flutter_revision' "$ui_manifest")" \
    "$(jq -r '.flutter.upstream_revision' "$source_lock")"
  check_equal \
    'UI manifest identifies the debug-engine arguments' \
    "$(jq -r '.artifacts.debug_engine_args_sha256' "$ui_manifest")" \
    "$(file_sha256 "$debug_engine_dir/args.gn")"
  check_equal \
    'UI manifest identifies the debug-engine checksum' \
    "$(jq -r '.artifacts.debug_engine_sha256' "$ui_manifest")" \
    "$(awk 'NR == 1 { print $1 }' "$debug_engine_dir/libflutter_engine.so.sha256")"
  check_equal \
    'UI manifest identifies the profile-engine arguments' \
    "$(jq -r '.artifacts.profile_engine_args_sha256' "$ui_manifest")" \
    "$(file_sha256 "$profile_engine_dir/args.gn")"
  check_equal \
    'UI manifest identifies the profile-engine checksum' \
    "$(jq -r '.artifacts.profile_engine_sha256' "$ui_manifest")" \
    "$(awk 'NR == 1 { print $1 }' "$profile_engine_dir/libflutter_engine.so.sha256")"
  check_equal \
    'UI manifest identifies the Flutter-tool snapshot checksum' \
    "$(jq -r '.artifacts.flutter_tool_sha256' "$ui_manifest")" \
    "$(awk 'NR == 1 { print $1 }' "$flutter_tool_dir/flutter_tools.snapshot.sha256")"
  check_equal \
    'generated Rust ABI hash matches generation manifest' \
    "$(jq -r '.abi.generated_rust_bindings_sha256' "$manifest")" \
    "$(file_sha256 "$ROOT/compositor/flutter-engine/src/sys.rs")"
  check_equal \
    'GN arguments hash matches generation manifest' \
    "$(jq -r '.artifacts.gn_args_sha256' "$manifest")" \
    "$(file_sha256 "$engine_dir/args.gn")"
  check_equal \
    'engine checksum matches generation manifest' \
    "$(jq -r '.artifacts.libflutter_engine_sha256' "$manifest")" \
    "$(awk 'NR == 1 { print $1 }' "$engine_dir/libflutter_engine.so.sha256")"

  if git -C "$ROOT" ls-files --error-unmatch -- \
      prebuilt/flutter-engine/linux-x64-release/libflutter_engine.so \
      >/dev/null 2>&1; then
    fail 'generated Flutter engine must not be tracked by Git'
  else
    pass 'generated Flutter engine is not tracked by Git'
  fi
  if git -C "$ROOT" ls-files --error-unmatch -- \
      prebuilt/flutter-engine/linux-x64-debug/libflutter_engine.so \
      >/dev/null 2>&1; then
    fail 'generated debug Flutter engine must not be tracked by Git'
  else
    pass 'generated debug Flutter engine is not tracked by Git'
  fi
  if git -C "$ROOT" ls-files --error-unmatch -- \
      prebuilt/flutter-engine/linux-x64-profile/libflutter_engine.so \
      >/dev/null 2>&1; then
    fail 'generated profile Flutter engine must not be tracked by Git'
  else
    pass 'generated profile Flutter engine is not tracked by Git'
  fi

  if [[ -f "$engine_dir/libflutter_engine.so" ]]; then
    if (
      cd "$engine_dir"
      sha256sum --check --strict libflutter_engine.so.sha256
    ) >/dev/null; then
      pass 'local engine artifact matches its adjacent checksum'
    else
      fail 'local engine artifact does not match its adjacent checksum'
    fi
  else
    pass 'local engine artifact is not required for the committed-source audit'
  fi
  if [[ -f "$debug_engine_dir/libflutter_engine.so" ]]; then
    if (
      cd "$debug_engine_dir"
      sha256sum --check --strict libflutter_engine.so.sha256
    ) >/dev/null; then
      pass 'local debug-engine artifact matches its adjacent checksum'
    else
      fail 'local debug-engine artifact does not match its adjacent checksum'
    fi
  else
    pass 'local debug-engine artifact is not required for the committed-source audit'
  fi
  if [[ -f "$profile_engine_dir/libflutter_engine.so" ]]; then
    if (
      cd "$profile_engine_dir"
      sha256sum --check --strict libflutter_engine.so.sha256
    ) >/dev/null; then
      pass 'local profile-engine artifact matches its adjacent checksum'
    else
      fail 'local profile-engine artifact does not match its adjacent checksum'
    fi
  else
    pass 'local profile-engine artifact is not required for the committed-source audit'
  fi

  check_equal \
    'Flutter revision file matches generation manifest' \
    "$(jq -r '.sources.flutter_revision' "$manifest")" \
    "$(< "$engine_dir/FLUTTER_REVISION")"
  check_equal \
    'engine revision file matches generation manifest' \
    "$(jq -r '.sources.engine_artifact_revision' "$manifest")" \
    "$(< "$engine_dir/ENGINE_REVISION")"

  makepkg_audit_root="$(mktemp -d /tmp/denial-source-audit.XXXXXX)"
  [[ "$makepkg_audit_root" == /tmp/denial-source-audit.* ]] \
    || {
      fail "unexpected makepkg audit directory: $makepkg_audit_root"
      finish
      return
    }
  if BUILDDIR="$makepkg_audit_root/build" \
    SRCDEST="$makepkg_audit_root/sources" \
    makepkg --dir "$ROOT/packaging/arch" --verifysource >/dev/null; then
    pass 'Denial PKGBUILD source hashes verify'
  else
    fail 'Denial PKGBUILD source hashes failed'
  fi
  if BUILDDIR="$makepkg_audit_root/build" \
    SRCDEST="$makepkg_audit_root/sources" \
    makepkg --dir "$ROOT/packaging/arch/flutter-engine" \
      --verifysource >/dev/null; then
    pass 'engine PKGBUILD source hashes verify'
  else
    fail 'engine PKGBUILD source hashes failed'
  fi
  if BUILDDIR="$makepkg_audit_root/build" \
    SRCDEST="$makepkg_audit_root/sources" \
    makepkg --dir "$ROOT/packaging/arch/ui-development" \
      --verifysource >/dev/null; then
    pass 'UI-development PKGBUILD source hashes verify'
  else
    fail 'UI-development PKGBUILD source hashes failed'
  fi
  rm -rf --one-file-system -- "$makepkg_audit_root"

  if sh -n "$ROOT/install.sh" \
    && bash -n \
    "$ROOT/tools/denial-pc" \
    "$ROOT/tools/denial-builder" \
    "$ROOT/tools/denial-release-key" \
    "$ROOT/tools/denial-repository" \
    "$ROOT/tools/denial-release" \
    "$ROOT/tools/generate-denial-wire" \
    "$ROOT/tools/package-denial-arch" \
    "$ROOT/tools/import-bibata-cursor" \
    "$ROOT/tools/notification-test-client" \
    "$ROOT/packaging/arch/denial-session" \
    "$ROOT/packaging/arch/PKGBUILD" \
    "$ROOT/packaging/arch/flutter-engine/PKGBUILD" \
    "$ROOT/packaging/arch/ui-development/PKGBUILD" \
    "$ROOT/packaging/arch/runner/denial-actions-runner-arm" \
    "$ROOT/packaging/arch/runner/denial-actions-runner-cleanup" \
    "$ROOT/packaging/arch/runner/install-host"; then
    pass 'release-facing shell files parse successfully'
  else
    fail 'a release-facing shell file has a syntax error'
  fi

  cargo_version="$(
    sed -n 's/^version = "\([^"]*\)"/\1/p' "$ROOT/compositor/Cargo.toml" \
      | head -n 1
  )"
  dart_version="$(
    sed -n 's/^version: *//p' "$ROOT/dart_shell/pubspec.yaml" \
      | head -n 1
  )"
  package_version="$(
    (
      unset DENIAL_PACKAGE_VERSION
      # PKGBUILD is executable Bash and is intentionally loaded to inspect its
      # effective default metadata.
      # shellcheck disable=SC1091
      source "$ROOT/packaging/arch/PKGBUILD"
      # Assigned by the sourced PKGBUILD above.
      # shellcheck disable=SC2154
      printf '%s\n' "$pkgver"
    )
  )"
  ui_package_version="$(
    (
      unset DENIAL_PACKAGE_VERSION
      # shellcheck disable=SC1091
      source "$ROOT/packaging/arch/ui-development/PKGBUILD"
      # shellcheck disable=SC2154
      printf '%s\n' "$pkgver"
    )
  )"
  read -r engine_package_version engine_package_epoch < <(
    (
      unset DENIAL_PACKAGE_VERSION
      # shellcheck disable=SC1091
      source "$ROOT/packaging/arch/flutter-engine/PKGBUILD"
      # shellcheck disable=SC2154
      printf '%s %s\n' "$pkgver" "$epoch"
    )
  )
  check_equal 'Cargo and Dart versions agree' "$cargo_version" "$dart_version"
  check_equal 'Cargo and package versions agree' "$cargo_version" "$package_version"
  check_equal \
    'Cargo and engine package versions agree' \
    "$cargo_version" \
    "$engine_package_version"
  check_equal 'engine package uses the tag-version epoch' 1 "$engine_package_epoch"
  cargo_lock_version="$(
    awk '
      $0 == "name = \"denial\"" {
        denial = 1
        next
      }
      denial && /^version = "/ {
        gsub(/^version = "|".*$/, "")
        print
        exit
      }
    ' "$ROOT/compositor/Cargo.lock"
  )"
  check_equal \
    'Cargo manifest and lockfile versions agree' \
    "$cargo_version" \
    "$cargo_lock_version"
  check_equal \
    'Cargo and UI-development package versions agree' \
    "$cargo_version" \
    "$ui_package_version"
  IFS=. read -r version_major version_minor version_patch <<<"$cargo_version"
  if [[ "$version_major" =~ ^[0-9]+$ \
    && "$version_minor" =~ ^[0-9]+$ \
    && "$version_patch" =~ ^[0-9]+$ ]]; then
    ui_dependency_bounds="$(
      (
        # shellcheck disable=SC1091
        source "$ROOT/packaging/arch/ui-development/PKGBUILD"
        # shellcheck disable=SC2154
        printf '%s\n' "${depends[@]}" | grep -E '^denial(>=|<)'
      )
    )"
    check_equal \
      'UI-development package has the expected Denial compatibility range' \
      "$(printf 'denial>=%s\ndenial<%s.%s.0' \
        "$cargo_version" "$version_major" "$((version_minor + 1))")" \
      "$ui_dependency_bounds"
    check_equal \
      'UI-development manifest has the expected minimum Denial version' \
      "$cargo_version" \
      "$(jq -r '.compatibility.denial_minimum_version' "$ui_manifest")"
    check_equal \
      'UI-development manifest has the expected upper Denial boundary' \
      "${version_major}.$((version_minor + 1)).0" \
      "$(jq -r '.compatibility.denial_version_before' "$ui_manifest")"
  else
    fail "project version is not numeric semantic versioning: $cargo_version"
  fi
  if grep -Eq \
      "^## \\[${cargo_version//./\\.}\\] - [0-9]{4}-[0-9]{2}-[0-9]{2}$" \
      "$ROOT/CHANGELOG.md"; then
    pass "changelog contains release $cargo_version"
  else
    fail "changelog has no dated entry for release $cargo_version"
  fi
  for manual in denialctl denial-ui; do
    if grep -Fq "Denial $cargo_version" "$ROOT/docs/man/${manual}.1"; then
      pass "$manual manual identifies Denial $cargo_version"
    else
      fail "$manual manual does not identify Denial $cargo_version"
    fi
  done

  if [[ -f "$public_key" ]]; then
    public_key_fingerprint="$(
      gpg \
        --batch \
        --show-keys \
        --with-colons \
        --fingerprint \
        "$public_key" \
        | awk -F: '$1 == "fpr" { print toupper($10); exit }'
    )"
    if [[ "$public_key_fingerprint" =~ ^[0-9A-F]{40,64}$ ]]; then
      pass "tracked release key is valid: $public_key_fingerprint"
      installer_fingerprint="$(
        sed -n "s/^SIGNING_KEY='\\([^']*\\)'$/\\1/p" "$ROOT/install.sh"
      )"
      check_equal \
        'guided installer uses the tracked release fingerprint' \
        "$public_key_fingerprint" \
        "$installer_fingerprint"
    else
      fail 'tracked release key has no valid primary fingerprint'
    fi
  elif [[ -n "$public_alpha_tag" ]]; then
    fail 'tracked release key is missing'
  else
    warn 'tracked release key has not been created yet'
  fi

  installer_key_url="$(
    sed -n "s/^PUBLIC_KEY_URL='\\([^']*\\)'$/\\1/p" "$ROOT/install.sh"
  )"
  check_equal \
    'guided installer uses the published release-key URL' \
    'https://denialwm.github.io/denial/denial-repo-key.asc' \
    "$installer_key_url"
  if grep -Eq \
      '^[[:space:]]*(if[[:space:]]+![[:space:]]+)?sudo[[:space:]]+pacman[[:space:]]+-S' \
      "$ROOT/install.sh"; then
    fail 'guided repository setup installs packages instead of stopping after configuration'
  else
    pass 'guided repository setup leaves package installation explicit'
  fi
  if grep -Fq 'sudo pacman -Syu denial' "$ROOT/install.sh"; then
    pass 'guided repository setup prints the explicit install command'
  else
    fail 'guided repository setup does not print the explicit install command'
  fi
  for install_document in \
    "$ROOT/README.md" \
    "$ROOT/docs/packaging/arch/INSTALL.md"; do
    if grep -Fqx \
      'curl -fsSL https://install.denialwm.org | sh' \
      "$install_document"; then
      pass "$(realpath --relative-to="$ROOT" "$install_document") uses the canonical guided-install command"
    else
      fail "$(realpath --relative-to="$ROOT" "$install_document") does not use the canonical guided-install command"
    fi
    if grep -Fqx \
      'sudo pacman -Syu denial' \
      "$install_document"; then
      pass "$(realpath --relative-to="$ROOT" "$install_document") keeps package installation explicit"
    else
      fail "$(realpath --relative-to="$ROOT" "$install_document") does not show the explicit install command"
    fi
  done

  if [[ -n "$public_alpha_tag" ]]; then
    if [[ "$public_alpha_tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
      pass "public-alpha tag has the required form: $public_alpha_tag"
    else
      fail "invalid public-alpha tag: $public_alpha_tag"
    fi
    if git -C "$ROOT" rev-parse --verify \
      "${public_alpha_tag}^{commit}" >/dev/null 2>&1; then
      check_equal \
        'public-alpha tag resolves to audited HEAD' \
        "$(git -C "$ROOT" rev-parse HEAD)" \
        "$(git -C "$ROOT" rev-parse "${public_alpha_tag}^{commit}")"
    else
      fail "public-alpha tag is unavailable: $public_alpha_tag"
    fi
    check_equal \
      'public-alpha tag and project version agree' \
      "$cargo_version" \
      "${public_alpha_tag#v}"
  fi

  if [[ -f "$ROOT/compositor/Cargo.lock" ]]; then
    pass 'Cargo.lock is present'
  else
    fail 'Cargo.lock is missing'
  fi
  if [[ -f "$ROOT/dart_shell/pubspec.lock" ]]; then
    pass 'pubspec.lock is present'
  else
    fail 'pubspec.lock is missing'
  fi

  actual="$(git -C "$ROOT" rev-parse HEAD)"
  printf 'INFO  audited commit: %s\n' "$actual"
  if [[ -n "$public_alpha_tag" ]]; then
    printf '%s\n' \
      'INFO  release stage: signed public alpha' \
      'INFO  non-claims: no offline closure, reproducibility, independent build, SBOM, or AArch64'
  else
    printf 'INFO  release stage: development/prototype; publication is forbidden\n'
  fi
  finish
}

if (($# == 0)); then
  usage >&2
  exit 2
fi

command_name="$1"
shift
case "$command_name" in
  doctor) doctor "$@" ;;
  source-audit) source_audit "$@" ;;
  -h | --help | help) usage ;;
  *)
    printf 'denial-release: unknown command: %s\n' "$command_name" >&2
    usage >&2
    exit 2
    ;;
esac
