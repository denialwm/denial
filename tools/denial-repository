  Arch packages and repository databases, APT Release metadata, RPM headers,
  DNF repository metadata, and every direct download are signed by the Denial
  release key. Direct downloads, including Alpine APKs, use adjacent detached
  OpenPGP signatures. The current release does not publish a native APKINDEX.
  This release does not claim an offline dependency closure, reproducible
  packages, independent rebuilding, or ${unclaimed}.
EOF

release_changes="$(
  awk '
    $0 == "## [Unreleased]" {
      found = 1
      next
    }
    found && /^## \[/ {
      exit
    }
    found {
      print
    }
  ' "$ROOT/CHANGELOG.md"
)"
[[ -n "$release_changes" ]] \
  || fail "CHANGELOG.md has no release notes for ${release_version}"

