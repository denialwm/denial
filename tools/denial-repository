#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
readonly ROOT

fail() {
  printf 'denial-repository: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage:
  tools/denial-repository OUTPUT_ROOT FINGERPRINT UNSIGNED_ROOT...

Each UNSIGNED_ROOT holds one architecture's promoted package set in packages/
and its evidence in evidence/: x86_64 is required, aarch64 is optional. The
command signs every set, creates complete static Pacman, APT, and DNF
repositories with one tree per architecture, and publishes signed direct
downloads, including the x86_64 Alpine APKs, below OUTPUT_ROOT.

Required environment:
  DENIAL_RELEASE_BUILD_RUN
  DENIAL_RELEASE_SOURCE_SHA
  DENIAL_RELEASE_TAG
  DENIAL_RELEASE_WORKFLOW_RUN
  DENIAL_RELEASE_SIGNING_PASSPHRASE

GNUPGHOME must contain only the imported Denial release-signing secret
subkey. The public primary fingerprint must be passed as FINGERPRINT.
EOF
}

if (($# < 3)); then
  usage >&2
  exit 2
fi

for required_command in \
  awk basename bsdtar cat cmp cp date dirname dpkg-deb find gpg gpg-connect-agent \
  gpgconf grep head install readlink realpath repo-add rm rpm sed sh sha256sum \
  sort paste tr; do
  command -v "$required_command" >/dev/null 2>&1 \
    || fail "missing command: $required_command"
done

readonly EXPECTED_UID='Doctor Logix (Denial Repository Signing)'
OUTPUT_ROOT="$(realpath -m -- "$1")"
readonly OUTPUT_ROOT
readonly APT_ROOT="${OUTPUT_ROOT}/apt"
readonly RPM_ROOT="${OUTPUT_ROOT}/rpm"
FINGERPRINT="$(tr '[:lower:]' '[:upper:]' <<<"$2")"
readonly FINGERPRINT
shift 2
readonly SOURCE_SHA="${DENIAL_RELEASE_SOURCE_SHA:-}"
readonly RELEASE_TAG="${DENIAL_RELEASE_TAG:-}"
readonly WORKFLOW_RUN="${DENIAL_RELEASE_WORKFLOW_RUN:-}"
readonly BUILD_RUN="${DENIAL_RELEASE_BUILD_RUN:-}"
readonly TOOLING_SHA="${DENIAL_RELEASE_TOOLING_SHA:-$SOURCE_SHA}"

[[ "$FINGERPRINT" =~ ^[0-9A-F]{40,64}$ ]] \
  || fail 'signing fingerprint must be a complete OpenPGP fingerprint'
[[ "$SOURCE_SHA" =~ ^[0-9a-f]{40}$ ]] \
  || fail 'DENIAL_RELEASE_SOURCE_SHA must be a complete Git commit ID'
[[ "$RELEASE_TAG" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] \
  || fail 'DENIAL_RELEASE_TAG must have the form vMAJOR.MINOR.PATCH'
[[ "$WORKFLOW_RUN" =~ ^[0-9]+$ ]] \
  || fail 'DENIAL_RELEASE_WORKFLOW_RUN must be numeric'
[[ "$BUILD_RUN" =~ ^[0-9]+$ ]] \
  || fail 'DENIAL_RELEASE_BUILD_RUN must be numeric'
[[ "$TOOLING_SHA" =~ ^[0-9a-f]{40}$ ]] \
  || fail 'DENIAL_RELEASE_TOOLING_SHA must be a complete Git commit ID'
[[ -n "${DENIAL_RELEASE_SIGNING_PASSPHRASE:-}" ]] \
  || fail 'DENIAL_RELEASE_SIGNING_PASSPHRASE is required'
[[ -n "${GNUPGHOME:-}" && -d "$GNUPGHOME" ]] \
  || fail 'GNUPGHOME must identify the imported release-signing keyring'
readonly RPM_QUERY_DB="${GNUPGHOME}/rpm-query-db"
install -d -m 0700 "$RPM_QUERY_DB"

# One unsigned root per architecture, named by its promotion provenance.
architectures=()
declare -A unsigned_roots=()
for unsigned_root in "$@"; do
  unsigned_root="$(realpath -e -- "$unsigned_root")"
  [[ -d "$unsigned_root/packages" ]] \
    || fail "unsigned package directory is missing: $unsigned_root/packages"
  [[ -d "$unsigned_root/evidence" ]] \
    || fail "unsigned evidence directory is missing: $unsigned_root/evidence"
  [[ -f "$unsigned_root/packages/SHA256SUMS" ]] \
    || fail "unsigned package checksum manifest is missing: $unsigned_root/packages/SHA256SUMS"
  provenance="$unsigned_root/evidence/provenance.txt"
  architecture="$(sed -n 's/^package_architecture=//p' "$provenance")"
  case "$architecture" in
    x86_64) package_formats=arch,deb,rpm,apk ;;
    aarch64) package_formats=arch,deb,rpm ;;
    *) fail "unsigned promotion has no supported architecture: $unsigned_root" ;;
  esac
  [[ -z "${unsigned_roots[$architecture]+set}" ]] \
    || fail "two unsigned roots hold $architecture packages"
  for expected in \
    'public_beta=true' \
    'artifact_class=tag-promoted-main-candidate' \
    "release_tag=$RELEASE_TAG" \
    "source_commit=$SOURCE_SHA" \
    "main_candidate_run=$BUILD_RUN" \
    "promotion_workflow_run=$WORKFLOW_RUN" \
    'compiled_payloads_changed=false' \
    "package_formats=$package_formats"; do
    grep -Fxq "$expected" "$provenance" \
      || fail "$architecture promotion provenance is missing: $expected"
  done
  (
    cd "$unsigned_root/packages"
    sha256sum --check --strict --quiet SHA256SUMS
  ) || fail "$architecture unsigned package checksums failed"
  unsigned_roots[$architecture]="$unsigned_root"
  architectures+=("$architecture")
done
[[ -n "${unsigned_roots[x86_64]+set}" ]] \
  || fail 'the release needs an x86_64 package set'
mapfile -t architectures < <(printf '%s\n' "${architectures[@]}" | sort -r)

if [[ -e "$OUTPUT_ROOT" ]] \
  && find "$OUTPUT_ROOT" -mindepth 1 -print -quit | grep -q .; then
  fail "output directory is not empty: $OUTPUT_ROOT"
fi

gpg --batch --list-secret-keys "$FINGERPRINT" >/dev/null 2>&1 \
  || fail "release secret subkey is unavailable: $FINGERPRINT"
gpg --batch --list-secret-keys "$FINGERPRINT" \
  | grep -Fq "$EXPECTED_UID" \
  || fail "selected key does not carry the required UID: $EXPECTED_UID"

mapfile -t secret_fingerprints < <(
  gpg --batch --with-colons --fingerprint --list-secret-keys "$FINGERPRINT" \
    | awk -F: '$1 == "fpr" { print toupper($10) }'
)
printf '%s\n' "${secret_fingerprints[@]}" \
  | grep -Fxq "$FINGERPRINT" \
  || fail 'selected fingerprint does not match the imported secret key'

preset_passphrase=''
for candidate in \
  /usr/lib/gnupg/gpg-preset-passphrase \
  /usr/libexec/gpg-preset-passphrase; do
  if [[ -x "$candidate" ]]; then
    preset_passphrase="$candidate"
    break
  fi
done
[[ -n "$preset_passphrase" ]] \
  || fail 'gpg-preset-passphrase is unavailable'

if ! grep -Fqx 'allow-preset-passphrase' "$GNUPGHOME/gpg-agent.conf" \
  2>/dev/null; then
  printf '%s\n' 'allow-preset-passphrase' >>"$GNUPGHOME/gpg-agent.conf"
fi

gpgconf --kill gpg-agent >/dev/null 2>&1 || true
gpg-connect-agent /bye >/dev/null

mapfile -t keygrips < <(
  gpg --batch --with-colons --with-keygrip \
    --list-secret-keys "$FINGERPRINT" \
    | awk -F: '$1 == "grp" { print $10 }'
)
((${#keygrips[@]} > 0)) || fail 'no secret-key grip was found'

release_passphrase="$DENIAL_RELEASE_SIGNING_PASSPHRASE"
unset DENIAL_RELEASE_SIGNING_PASSPHRASE
for keygrip in "${keygrips[@]}"; do
  "$preset_passphrase" \
    --preset \
    --passphrase "$release_passphrase" \
    "$keygrip"
done
release_passphrase=''
unset release_passphrase

kill_agent() {
  gpgconf --kill gpg-agent >/dev/null 2>&1 || true
}
trap kill_agent EXIT

# Checks one architecture's unsigned set and records its packages: Arch in
# pacman_inputs, Debian and RPM in deb_input_lists and rpm_input_lists, all keyed by
# architecture.
declare -A pacman_inputs=() deb_input_lists=() rpm_input_lists=()
check_package_set() {
  local architecture="$1"
  local package_input="${unsigned_roots[$architecture]}/packages"
  local deb_architecture
  case "$architecture" in
    x86_64) deb_architecture=amd64 ;;
    aarch64) deb_architecture=arm64 ;;
  esac

  mapfile -d '' package_inputs < <(
    find "$package_input" \
      -maxdepth 1 \
      -type f \
      -name '*.pkg.tar.zst' \
      -print0 \
      | sort -z
  )
  ((${#package_inputs[@]} == 3)) \
    || fail "expected exactly three $architecture Arch packages, found ${#package_inputs[@]}"

  engine_packages=0
  denial_packages=0
  plugin_manager_packages=0
  for package in "${package_inputs[@]}"; do
    package_filename="$(basename -- "$package")"
    package_info="$(bsdtar -xOf "$package" .PKGINFO)"
    package_name="$(
      sed -n 's/^pkgname = //p' <<<"$package_info" | head -n 1
    )"
    package_version="$(
      sed -n 's/^pkgver = //p' <<<"$package_info" | head -n 1
    )"
    package_arch="$(
      sed -n 's/^arch = //p' <<<"$package_info" | head -n 1
    )"
    [[ "$package_arch" == "$architecture" ]] \
      || fail "$(basename -- "$package") targets $package_arch, expected $architecture"
    bsdtar -xOf "$package" .BUILDINFO >/dev/null \
      || fail "$(basename -- "$package") has no .BUILDINFO"

    case "$package_name" in
      denial-flutter-engine)
        [[ "$package_filename" == \
          "denial-flutter-engine-1:${release_version}-1-${architecture}.pkg.tar.zst" ]] \
          || fail "unexpected engine package filename: $package_filename"
        [[ "$package_version" == "1:${release_version}-1" ]] \
          || fail "unexpected engine package version: $package_version"
        grep -Fqx \
          'provides = denial-flutter-engine-abi=3.47.5.denial1' \
          <<<"$package_info" \
          || fail 'engine package does not provide the expected Flutter ABI'
        engine_packages=$((engine_packages + 1))
        ;;
      denial)
        [[ "$package_filename" == \
          "denial-${release_version}-1-${architecture}.pkg.tar.zst" ]] \
          || fail "unexpected Denial package filename: $package_filename"
        [[ "$package_version" == "${release_version}-1" ]] \
          || fail \
            "Denial package version is $package_version, expected ${release_version}-1"
        grep -Fqx \
          'depend = denial-flutter-engine-abi=3.47.5.denial1' \
          <<<"$package_info" \
          || fail 'Denial package does not require the exact Flutter Engine ABI'
        grep -Fqx 'depend = rtkit' <<<"$package_info" \
          || fail 'Denial package does not require rtkit'
        [[ "$(
          bsdtar -xOf "$package" usr/share/denial/version
        )" == "$release_version" ]] \
          || fail 'Denial package runtime version does not match its signed tag'
        denial_packages=$((denial_packages + 1))
        ;;
      denial-plugin-manager)
        [[ "$package_filename" == \
          "denial-plugin-manager-${release_version}-1-${architecture}.pkg.tar.zst" ]] \
          || fail "unexpected Plugin Manager package filename: $package_filename"
        [[ "$package_version" == "${release_version}-1" ]] \
          || fail "unexpected Plugin Manager package version: $package_version"
        grep -Fqx "depend = denial=${release_version}-1" <<<"$package_info" \
          || fail 'Plugin Manager package does not require matching Denial'
        grep -Fqx 'depend = dart' <<<"$package_info" \
          || fail 'Plugin Manager package does not require Dart'
        plugin_manager_packages=$((plugin_manager_packages + 1))
        ;;
      *)
        fail "unexpected package name: ${package_name:-unset}"
        ;;
    esac
  done
  ((engine_packages == 1 && denial_packages == 1 \
    && plugin_manager_packages == 1)) \
    || fail "the $architecture package set must contain denial, its engine, and Plugin Manager"

  mapfile -d '' deb_inputs < <(
    find "$package_input" \
      -maxdepth 1 \
      -type f \
      -name '*.deb' \
      -print0 \
      | sort -z
  )
  mapfile -d '' rpm_inputs < <(
    find "$package_input" \
      -maxdepth 1 \
      -type f \
      -name '*.rpm' \
      -print0 \
      | sort -z
  )
  ((${#deb_inputs[@]} == 3)) \
    || fail "expected exactly three Debian packages, found ${#deb_inputs[@]}"
  ((${#rpm_inputs[@]} == 3)) \
    || fail "expected exactly three RPM packages, found ${#rpm_inputs[@]}"

  deb_names=()
  for package in "${deb_inputs[@]}"; do
    package_name="$(dpkg-deb --field "$package" Package)"
    package_version="$(dpkg-deb --field "$package" Version)"
    package_arch="$(dpkg-deb --field "$package" Architecture)"
    [[ "$package_arch" == "$deb_architecture" ]] \
      || fail "$(basename -- "$package") targets $package_arch, expected $deb_architecture"
    [[ "$package_version" == "${release_version}-1" ]] \
      || fail "$(basename -- "$package") has version $package_version"
    case "$package_name" in
      denial)
        expected_filename="denial_${release_version}-1_${deb_architecture}.deb"
        ;;
      denial-flutter-engine)
        expected_filename="denial-flutter-engine_${release_version}-1_${deb_architecture}.deb"
        ;;
      denial-plugin-manager)
        expected_filename="denial-plugin-manager_${release_version}-1_${deb_architecture}.deb"
        ;;
      *) fail "unexpected Debian package: ${package_name:-unset}" ;;
    esac
    [[ "$(basename -- "$package")" == "$expected_filename" ]] \
      || fail "unexpected Debian package filename: $(basename -- "$package")"
    "$ROOT/tools/verify-denial-native-package-metadata" \
      deb "$package" "$release_version" 1 '3.47.5.denial1' 2.39 \
      "$architecture"
    deb_names+=("$package_name")
  done
  [[ "${deb_names[*]}" == \
    'denial-flutter-engine denial-plugin-manager denial' ]] \
    || fail "$architecture Debian package set is incomplete"

  rpm_names=()
  for package in "${rpm_inputs[@]}"; do
    package_name="$(rpm --dbpath "$RPM_QUERY_DB" -qp --qf '%{NAME}' "$package")"
    package_version="$(rpm --dbpath "$RPM_QUERY_DB" -qp --qf '%{VERSION}-%{RELEASE}' "$package")"
    package_arch="$(rpm --dbpath "$RPM_QUERY_DB" -qp --qf '%{ARCH}' "$package")"
    [[ "$package_arch" == "$architecture" ]] \
      || fail "$(basename -- "$package") targets $package_arch, expected $architecture"
    [[ "$package_version" == "${release_version}-1" ]] \
      || fail "$(basename -- "$package") has version $package_version"
    case "$package_name" in
      denial)
        expected_filename="denial-${release_version}-1.${architecture}.rpm"
        ;;
      denial-flutter-engine)
        expected_filename="denial-flutter-engine-${release_version}-1.${architecture}.rpm"
        ;;
      denial-plugin-manager)
        expected_filename="denial-plugin-manager-${release_version}-1.${architecture}.rpm"
        ;;
      *) fail "unexpected RPM package: ${package_name:-unset}" ;;
    esac
    [[ "$(basename -- "$package")" == "$expected_filename" ]] \
      || fail "unexpected RPM package filename: $(basename -- "$package")"
    "$ROOT/tools/verify-denial-native-package-metadata" \
      rpm "$package" "$release_version" 1 '3.47.5.denial1' 2.39 \
      "$architecture"
    rpm_names+=("$package_name")
  done
  [[ "${rpm_names[*]}" == \
    'denial denial-flutter-engine denial-plugin-manager' ]] \
    || fail "$architecture RPM package set is incomplete"

  pacman_inputs[$architecture]="$(printf '%s\n' "${package_inputs[@]}")"
  deb_input_lists[$architecture]="$(printf '%s\n' "${deb_inputs[@]}")"
  rpm_input_lists[$architecture]="$(printf '%s\n' "${rpm_inputs[@]}")"
}

release_version="${RELEASE_TAG#v}"
IFS=. read -r release_major release_minor release_patch <<<"$release_version"
[[ "$release_major" =~ ^[0-9]+$ \
  && "$release_minor" =~ ^[0-9]+$ \
  && "$release_patch" =~ ^[0-9]+$ ]] \
  || fail "release tag has an invalid semantic version: $RELEASE_TAG"
for architecture in "${architectures[@]}"; do
  check_package_set "$architecture"
done

# The Alpine packages exist for x86_64 only.
package_input="${unsigned_roots[x86_64]}/packages"
mapfile -d '' apk_inputs < <(
  find "$package_input" \
    -maxdepth 1 \
    -type f \
    -name '*.apk' \
    -print0 \
    | sort -z
)
((${#apk_inputs[@]} == 3)) \
  || fail "expected exactly three Alpine packages, found ${#apk_inputs[@]}"
apk_names=()
for package in "${apk_inputs[@]}"; do
  if bsdtar -tf "$package" | grep -Eq '^\.SIGN\.'; then
    fail "unsigned promotion APK contains a native signature: $package"
  fi
  package_info="$(bsdtar -xOf "$package" .PKGINFO)"
  package_name="$(
    sed -n 's/^pkgname = //p' <<<"$package_info" | head -n 1
  )"
  package_version="$(
    sed -n 's/^pkgver = //p' <<<"$package_info" | head -n 1
  )"
  package_arch="$(
    sed -n 's/^arch = //p' <<<"$package_info" | head -n 1
  )"
  [[ "$package_arch" == x86_64 ]] \
    || fail "$(basename -- "$package") targets $package_arch, expected x86_64"
  [[ "$package_version" == "${release_version}-r1" ]] \
    || fail "$(basename -- "$package") has version $package_version"
  case "$package_name" in
    denial)
      expected_filename="denial-${release_version}-r1.apk"
      grep -Fqx \
        "depend = denial-flutter-engine=${release_version}-r1" \
        <<<"$package_info" \
        || fail 'Alpine Denial package has the wrong engine dependency'
      [[ "$(
        bsdtar -xOf "$package" usr/share/denial/version
      )" == "$release_version" ]] \
        || fail 'Alpine Denial runtime version does not match its tag'
      ;;
    denial-flutter-engine)
      expected_filename="denial-flutter-engine-${release_version}-r1.apk"
      grep -Fqx \
        'provides = denial-flutter-engine-abi-3.47.5.denial1' \
        <<<"$package_info" \
        || fail 'Alpine engine package has the wrong ABI capability'
      ;;
    denial-plugin-manager)
      expected_filename="denial-plugin-manager-${release_version}-r1.apk"
      grep -Fqx "depend = denial=${release_version}-r1" \
        <<<"$package_info" \
        || fail 'Alpine Plugin Manager has the wrong Denial dependency'
      ;;
    *) fail "unexpected Alpine package: ${package_name:-unset}" ;;
  esac
  [[ "$(basename -- "$package")" == "$expected_filename" ]] \
    || fail "unexpected Alpine package filename: $(basename -- "$package")"
  apk_names+=("$package_name")
done
[[ "$(printf '%s\n' "${apk_names[@]}" | sort | paste -sd' ' -)" == \
  'denial denial-flutter-engine denial-plugin-manager' ]] \
  || fail 'Alpine package set is incomplete'

readonly INSTALLER="${ROOT}/install.sh"
[[ -f "$INSTALLER" ]] || fail "guided installer is missing: $INSTALLER"
sh -n "$INSTALLER" || fail 'guided installer does not parse as POSIX shell'
installer_fingerprint="$(
  sed -n "s/^SIGNING_KEY='\\([^']*\\)'$/\\1/p" "$INSTALLER"
)"
[[ "$installer_fingerprint" == "$FINGERPRINT" ]] \
  || fail 'guided installer fingerprint does not match the release key'
if grep -Eq \
    '^[[:space:]]*sudo[[:space:]]+(pacman[[:space:]]+-S|apt(-get)?[[:space:]].*install|dnf[[:space:]].*install)' \
    "$INSTALLER"; then
  fail 'guided repository setup must not install packages'
fi
for install_command in \
  'sudo pacman -Syu denial' \
  'sudo apt update && sudo apt install denial' \
  'sudo dnf install denial'; do
  grep -Fq "$install_command" "$INSTALLER" \
    || fail "guided repository setup omits: $install_command"
done

materialize_alias() {
  local alias="$1"
  local target

  [[ -L "$alias" ]] || fail "repository alias is not a symlink: $alias"
  target="$(readlink -- "$alias")"
  [[ "$target" != */* && -f "$(dirname -- "$alias")/$target" ]] \
    || fail "repository alias has an unsafe target: $alias -> $target"
  rm -- "$alias"
  cp --reflink=auto -- "$(dirname -- "$alias")/$target" "$alias"
}

install -d -m 0755 "${OUTPUT_ROOT}/evidence"
for architecture in "${architectures[@]}"; do
  install -d -m 0755 \
    "${OUTPUT_ROOT}/${architecture}" \
    "${OUTPUT_ROOT}/downloads/${architecture}"
  cp -a -- \
    "${unsigned_roots[$architecture]}/evidence" \
    "${OUTPUT_ROOT}/evidence/${architecture}"
done
install -m 0644 "$INSTALLER" "${OUTPUT_ROOT}/install.sh"

gpg --batch --armor --export "$FINGERPRINT" \
  >"${OUTPUT_ROOT}/denial-repo-key.asc"
exported_fingerprint="$(
  gpg \
    --batch \
    --show-keys \
    --with-colons \
    --fingerprint \
    "${OUTPUT_ROOT}/denial-repo-key.asc" \
    | awk -F: '$1 == "fpr" { print toupper($10); exit }'
)"
[[ "$exported_fingerprint" == "$FINGERPRINT" ]] \
  || fail 'exported public key fingerprint does not match'
rpmkeys --dbpath "$RPM_QUERY_DB" --import \
  "${OUTPUT_ROOT}/denial-repo-key.asc"

sign_detached() {
  gpg \
    --batch \
    --yes \
    --local-user "$FINGERPRINT" \
    --detach-sign \
    --output "${1}.sig" \
    "$1"
  gpg --batch --verify "${1}.sig" "$1"
}

signed_package_count=0
signed_native_count=0
apt_inputs=()
dnf_inputs=()
for architecture in "${architectures[@]}"; do
  download_root="${OUTPUT_ROOT}/downloads/${architecture}"
  mapfile -t package_inputs <<<"${pacman_inputs[$architecture]}"
  mapfile -t deb_inputs <<<"${deb_input_lists[$architecture]}"
  native_inputs=("${deb_inputs[@]}")
  if [[ "$architecture" == x86_64 ]]; then
    native_inputs+=("${apk_inputs[@]}")
  fi

  signed_packages=()
  for package in "${package_inputs[@]}"; do
    destination="${OUTPUT_ROOT}/${architecture}/$(basename -- "$package")"
    cp --reflink=auto -- "$package" "$destination"
    sign_detached "$destination"
    signed_packages+=("$destination")
  done
  signed_package_count=$((signed_package_count + ${#signed_packages[@]}))

  for package in "${native_inputs[@]}"; do
    destination="${download_root}/$(basename -- "$package")"
    cp --reflink=auto -- "$package" "$destination"
    sign_detached "$destination"
    signed_native_count=$((signed_native_count + 1))
  done
  apt_inputs+=("${unsigned_roots[$architecture]}/packages")
  dnf_inputs+=("${unsigned_roots[$architecture]}/packages")

  repository_database="${OUTPUT_ROOT}/${architecture}/denial.db.tar.zst"
  repo-add \
    --sign \
    --key "$FINGERPRINT" \
    --include-sigs \
    --prevent-downgrade \
    "$repository_database" \
    "${signed_packages[@]}"

  for alias in \
    "${OUTPUT_ROOT}/${architecture}/denial.db" \
    "${OUTPUT_ROOT}/${architecture}/denial.db.sig" \
    "${OUTPUT_ROOT}/${architecture}/denial.files" \
    "${OUTPUT_ROOT}/${architecture}/denial.files.sig"; do
    materialize_alias "$alias"
  done

  for signed_database in \
    "${OUTPUT_ROOT}/${architecture}/denial.db.tar.zst" \
    "${OUTPUT_ROOT}/${architecture}/denial.files.tar.zst"; do
    [[ -f "$signed_database" && -f "${signed_database}.sig" ]] \
      || fail "signed repository database is incomplete: $signed_database"
    gpg --batch --verify "${signed_database}.sig" "$signed_database"
  done

  mapfile -t database_descriptions < <(
    bsdtar -tf "$repository_database" \
      | awk '/\/desc$/ { print }'
  )
  ((${#database_descriptions[@]} == ${#signed_packages[@]})) \
    || fail "$architecture repository database package count does not match the signed set"

  embedded_signatures=0
  for description in "${database_descriptions[@]}"; do
    if bsdtar -xOf "$repository_database" "$description" \
      | grep -Fxq '%PGPSIG%'; then
      embedded_signatures=$((embedded_signatures + 1))
    fi
  done
  ((embedded_signatures == ${#signed_packages[@]})) \
    || fail "$architecture repository database does not embed every package signature"
done

"$ROOT/tools/generate-denial-apt-repository" \
  "$APT_ROOT" \
  "$FINGERPRINT" \
  "$release_version" \
  1 \
  "${apt_inputs[@]}"
"$ROOT/tools/generate-denial-dnf-repository" \
  "$RPM_ROOT" \
  "$FINGERPRINT" \
  "${OUTPUT_ROOT}/denial-repo-key.asc" \
  "$release_version" \
  1 \
  "${dnf_inputs[@]}"

for setup_file in \
  "$APT_ROOT/denial-trixie.sources" \
  "$APT_ROOT/denial-noble.sources" \
  "$RPM_ROOT/denial-fedora.repo"; do
  install -m 0644 "$setup_file" "${OUTPUT_ROOT}/$(basename -- "$setup_file")"
done

# The RPM downloads are the packages the DNF repositories signed.
for architecture in "${architectures[@]}"; do
  mapfile -d '' signed_rpm_packages < <(
    find "$RPM_ROOT/fedora/44/${architecture}/Packages" \
      -maxdepth 1 \
      -type f \
      -name '*.rpm' \
      -print0 \
      | sort -z
  )
  ((${#signed_rpm_packages[@]} == 3)) \
    || fail "signed $architecture DNF repository does not contain three RPM packages"
  for package in "${signed_rpm_packages[@]}"; do
    destination="${OUTPUT_ROOT}/downloads/${architecture}/$(basename -- "$package")"
    cp --reflink=auto -- "$package" "$destination"
    cmp -- "$package" "$destination"
    rpmkeys --dbpath "$RPM_QUERY_DB" --checksig --verbose "$destination" \
      | grep -Eiq 'signature.*: OK'
    sign_detached "$destination"
    signed_native_count=$((signed_native_count + 1))
  done
done

if [[ -n "${unsigned_roots[aarch64]+set}" ]]; then
  architecture_label='x86-64 and AArch64'
  cross_build_note='
  The AArch64 binaries are cross-compiled from the same commit on that runner.'
  unclaimed='an SBOM'
else
  architecture_label='x86-64'
  cross_build_note=''
  unclaimed='an SBOM, or AArch64 binary packages'
fi

