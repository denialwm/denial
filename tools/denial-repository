#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
readonly ROOT

fail() {
  printf 'denial-repository: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage:
  tools/denial-repository UNSIGNED_ROOT OUTPUT_ROOT FINGERPRINT

UNSIGNED_ROOT must contain packages/ and evidence/. The command signs one
x86-64 public-alpha package set and creates a complete static Pacman
repository below OUTPUT_ROOT.

Required environment:
  DENIAL_RELEASE_SOURCE_SHA
  DENIAL_RELEASE_TAG
  DENIAL_RELEASE_WORKFLOW_RUN
  DENIAL_RELEASE_SIGNING_PASSPHRASE

GNUPGHOME must contain only the imported Denial release-signing secret
subkey. The public primary fingerprint must be passed as FINGERPRINT.
EOF
}

if (($# != 3)); then
  usage >&2
  exit 2
fi

for required_command in \
  awk basename bsdtar cp date dirname find gpg gpg-connect-agent gpgconf \
  grep head install readlink realpath repo-add rm sed sh sha256sum sort tr; do
  command -v "$required_command" >/dev/null 2>&1 \
    || fail "missing command: $required_command"
done

readonly EXPECTED_UID='Doctor Logix (Denial Repository Signing)'
UNSIGNED_ROOT="$(realpath -e -- "$1")"
readonly UNSIGNED_ROOT
readonly PACKAGE_INPUT="${UNSIGNED_ROOT}/packages"
readonly EVIDENCE_INPUT="${UNSIGNED_ROOT}/evidence"
OUTPUT_ROOT="$(realpath -m -- "$2")"
readonly OUTPUT_ROOT
readonly REPOSITORY_ROOT="${OUTPUT_ROOT}/x86_64"
FINGERPRINT="$(tr '[:lower:]' '[:upper:]' <<<"$3")"
readonly FINGERPRINT
readonly SOURCE_SHA="${DENIAL_RELEASE_SOURCE_SHA:-}"
readonly RELEASE_TAG="${DENIAL_RELEASE_TAG:-}"
readonly WORKFLOW_RUN="${DENIAL_RELEASE_WORKFLOW_RUN:-}"
readonly TOOLING_SHA="${DENIAL_RELEASE_TOOLING_SHA:-$SOURCE_SHA}"

[[ -d "$PACKAGE_INPUT" ]] \
  || fail "unsigned package directory is missing: $PACKAGE_INPUT"
[[ -d "$EVIDENCE_INPUT" ]] \
  || fail "unsigned evidence directory is missing: $EVIDENCE_INPUT"
[[ "$FINGERPRINT" =~ ^[0-9A-F]{40,64}$ ]] \
  || fail 'signing fingerprint must be a complete OpenPGP fingerprint'
[[ "$SOURCE_SHA" =~ ^[0-9a-f]{40}$ ]] \
  || fail 'DENIAL_RELEASE_SOURCE_SHA must be a complete Git commit ID'
[[ "$RELEASE_TAG" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] \
  || fail 'DENIAL_RELEASE_TAG must have the form vMAJOR.MINOR.PATCH'
[[ "$WORKFLOW_RUN" =~ ^[0-9]+$ ]] \
  || fail 'DENIAL_RELEASE_WORKFLOW_RUN must be numeric'
[[ "$TOOLING_SHA" =~ ^[0-9a-f]{40}$ ]] \
  || fail 'DENIAL_RELEASE_TOOLING_SHA must be a complete Git commit ID'
[[ -n "${DENIAL_RELEASE_SIGNING_PASSPHRASE:-}" ]] \
  || fail 'DENIAL_RELEASE_SIGNING_PASSPHRASE is required'
[[ -n "${GNUPGHOME:-}" && -d "$GNUPGHOME" ]] \
  || fail 'GNUPGHOME must identify the imported release-signing keyring'

if [[ -e "$OUTPUT_ROOT" ]] \
  && find "$OUTPUT_ROOT" -mindepth 1 -print -quit | grep -q .; then
  fail "output directory is not empty: $OUTPUT_ROOT"
fi

gpg --batch --list-secret-keys "$FINGERPRINT" >/dev/null 2>&1 \
  || fail "release secret subkey is unavailable: $FINGERPRINT"
gpg --batch --list-secret-keys "$FINGERPRINT" \
  | grep -Fq "$EXPECTED_UID" \
  || fail "selected key does not carry the required UID: $EXPECTED_UID"

mapfile -t secret_fingerprints < <(
  gpg --batch --with-colons --fingerprint --list-secret-keys "$FINGERPRINT" \
    | awk -F: '$1 == "fpr" { print toupper($10) }'
)
printf '%s\n' "${secret_fingerprints[@]}" \
  | grep -Fxq "$FINGERPRINT" \
  || fail 'selected fingerprint does not match the imported secret key'

preset_passphrase=''
for candidate in \
  /usr/lib/gnupg/gpg-preset-passphrase \
  /usr/libexec/gpg-preset-passphrase; do
  if [[ -x "$candidate" ]]; then
    preset_passphrase="$candidate"
    break
  fi
done
[[ -n "$preset_passphrase" ]] \
  || fail 'gpg-preset-passphrase is unavailable'

if ! grep -Fqx 'allow-preset-passphrase' "$GNUPGHOME/gpg-agent.conf" \
  2>/dev/null; then
  printf '%s\n' 'allow-preset-passphrase' >>"$GNUPGHOME/gpg-agent.conf"
fi

gpgconf --kill gpg-agent >/dev/null 2>&1 || true
gpg-connect-agent /bye >/dev/null

mapfile -t keygrips < <(
  gpg --batch --with-colons --with-keygrip \
    --list-secret-keys "$FINGERPRINT" \
    | awk -F: '$1 == "grp" { print $10 }'
)
((${#keygrips[@]} > 0)) || fail 'no secret-key grip was found'

release_passphrase="$DENIAL_RELEASE_SIGNING_PASSPHRASE"
unset DENIAL_RELEASE_SIGNING_PASSPHRASE
for keygrip in "${keygrips[@]}"; do
  "$preset_passphrase" \
    --preset \
    --passphrase "$release_passphrase" \
    "$keygrip"
done
release_passphrase=''
unset release_passphrase

kill_agent() {
  gpgconf --kill gpg-agent >/dev/null 2>&1 || true
}
trap kill_agent EXIT

mapfile -d '' package_inputs < <(
  find "$PACKAGE_INPUT" \
    -maxdepth 1 \
    -type f \
    -name '*.pkg.tar.zst' \
    -print0 \
    | sort -z
)
((${#package_inputs[@]} == 3)) \
  || fail "expected exactly three packages, found ${#package_inputs[@]}"

release_version="${RELEASE_TAG#v}"
IFS=. read -r release_major release_minor release_patch <<<"$release_version"
[[ "$release_major" =~ ^[0-9]+$ \
  && "$release_minor" =~ ^[0-9]+$ \
  && "$release_patch" =~ ^[0-9]+$ ]] \
  || fail "release tag has an invalid semantic version: $RELEASE_TAG"
ui_denial_before="${release_major}.$((release_minor + 1)).0"
engine_packages=0
denial_packages=0
ui_development_packages=0
for package in "${package_inputs[@]}"; do
  package_filename="$(basename -- "$package")"
  package_info="$(bsdtar -xOf "$package" .PKGINFO)"
  package_name="$(
    sed -n 's/^pkgname = //p' <<<"$package_info" | head -n 1
  )"
  package_version="$(
    sed -n 's/^pkgver = //p' <<<"$package_info" | head -n 1
  )"
  package_arch="$(
    sed -n 's/^arch = //p' <<<"$package_info" | head -n 1
  )"
  [[ "$package_arch" == x86_64 ]] \
    || fail "$(basename -- "$package") targets $package_arch, expected x86_64"
  bsdtar -xOf "$package" .BUILDINFO >/dev/null \
    || fail "$(basename -- "$package") has no .BUILDINFO"

  case "$package_name" in
    denial-flutter-engine)
      [[ "$package_filename" == \
        "denial-flutter-engine-1:${release_version}-1-x86_64.pkg.tar.zst" ]] \
        || fail "unexpected engine package filename: $package_filename"
      [[ "$package_version" == "1:${release_version}-1" ]] \
        || fail "unexpected engine package version: $package_version"
      grep -Fqx \
        'provides = denial-flutter-engine-abi=3.44.7.denial1' \
        <<<"$package_info" \
        || fail 'engine package does not provide the expected Flutter ABI'
      engine_packages=$((engine_packages + 1))
      ;;
    denial)
      [[ "$package_filename" == \
        "denial-${release_version}-1-x86_64.pkg.tar.zst" ]] \
        || fail "unexpected Denial package filename: $package_filename"
      [[ "$package_version" == "${release_version}-1" ]] \
        || fail \
          "Denial package version is $package_version, expected ${release_version}-1"
      grep -Fqx \
        'depend = denial-flutter-engine-abi=3.44.7.denial1' \
        <<<"$package_info" \
        || fail 'Denial package does not require the exact Flutter Engine ABI'
      grep -Fqx 'depend = rtkit' <<<"$package_info" \
        || fail 'Denial package does not require rtkit'
      grep -Fqx \
        'optdepend = denial-ui-development: live Flutter UI editing and hot reload' \
        <<<"$package_info" \
        || fail 'Denial package does not advertise its optional development package'
      denial_packages=$((denial_packages + 1))
      ;;
    denial-ui-development)
      [[ "$package_filename" == \
        "denial-ui-development-${release_version}-1-x86_64.pkg.tar.zst" ]] \
        || fail \
          "unexpected UI-development package filename: $package_filename"
      [[ "$package_version" == "${release_version}-1" ]] \
        || fail \
          "UI-development package version is $package_version, expected ${release_version}-1"
      for dependency in \
        "depend = denial>=${release_version}" \
        "depend = denial<${ui_denial_before}" \
        'depend = denial-flutter-engine-abi=3.44.7.denial1'; do
        grep -Fqx "$dependency" <<<"$package_info" \
          || fail "UI-development package is missing $dependency"
      done
      bsdtar -tf "$package" | grep -Fxq usr/bin/denial-ui \
        || fail 'UI-development package has no denial-ui client'
      bsdtar -tf "$package" \
        | grep -Fxq \
          usr/lib/denial/ui-development/flutter/bin/cache/flutter_tools.snapshot \
        || fail 'UI-development package has no pinned Flutter tool snapshot'
      bsdtar -xOf \
        "$package" \
        usr/share/denial/ui-development/manifest.json \
        | grep -Fq '"stage": "public-alpha"' \
        || fail 'UI-development package does not declare its public-alpha stage'
      expected_debug_engine_sha="$(
        awk 'NR == 1 { print $1 }' \
          "$ROOT/prebuilt/flutter-engine/linux-x64-debug/libflutter_engine.so.sha256"
      )"
      actual_debug_engine_sha="$(
        bsdtar -xOf \
          "$package" \
          usr/lib/denial/ui-development/lib/libflutter_engine.so \
          | sha256sum \
          | awk '{ print $1 }'
      )"
      [[ "$actual_debug_engine_sha" == "$expected_debug_engine_sha" ]] \
        || fail 'UI-development package contains the wrong debug engine'
      expected_profile_engine_sha="$(
        awk 'NR == 1 { print $1 }' \
          "$ROOT/prebuilt/flutter-engine/linux-x64-profile/libflutter_engine.so.sha256"
      )"
      actual_profile_engine_sha="$(
        bsdtar -xOf \
          "$package" \
          usr/lib/denial/ui-development/profile/lib/libflutter_engine.so \
          | sha256sum \
          | awk '{ print $1 }'
      )"
      [[ "$actual_profile_engine_sha" == "$expected_profile_engine_sha" ]] \
        || fail 'UI-development package contains the wrong profile engine'
      expected_flutter_tool_sha="$(
        awk 'NR == 1 { print $1 }' \
          "$ROOT/prebuilt/flutter-tools/3.44.7/flutter_tools.snapshot.sha256"
      )"
      actual_flutter_tool_sha="$(
        bsdtar -xOf \
          "$package" \
          usr/lib/denial/ui-development/flutter/bin/cache/flutter_tools.snapshot \
          | sha256sum \
          | awk '{ print $1 }'
      )"
      [[ "$actual_flutter_tool_sha" == "$expected_flutter_tool_sha" ]] \
        || fail 'UI-development package contains the wrong Flutter tool'
      expected_ui_manifest_sha="$(
        sha256sum "$ROOT/packaging/arch/ui-development/manifest.json" \
          | awk '{ print $1 }'
      )"
      actual_ui_manifest_sha="$(
        bsdtar -xOf \
          "$package" \
          usr/share/denial/ui-development/manifest.json \
          | sha256sum \
          | awk '{ print $1 }'
      )"
      [[ "$actual_ui_manifest_sha" == "$expected_ui_manifest_sha" ]] \
        || fail 'UI-development package contains the wrong release manifest'
      ui_development_packages=$((ui_development_packages + 1))
      ;;
    *)
      fail "unexpected package name: ${package_name:-unset}"
      ;;
  esac
done
((engine_packages == 1 \
  && denial_packages == 1 \
  && ui_development_packages == 1)) \
  || fail \
    'the package set must contain denial, denial-flutter-engine, and denial-ui-development'

readonly INSTALLER="${ROOT}/install.sh"
[[ -f "$INSTALLER" ]] || fail "guided installer is missing: $INSTALLER"
sh -n "$INSTALLER" || fail 'guided installer does not parse as POSIX shell'
installer_fingerprint="$(
  sed -n "s/^SIGNING_KEY='\\([^']*\\)'$/\\1/p" "$INSTALLER"
)"
[[ "$installer_fingerprint" == "$FINGERPRINT" ]] \
  || fail 'guided installer fingerprint does not match the release key'
if grep -Eq \
    '^[[:space:]]*(if[[:space:]]+![[:space:]]+)?sudo[[:space:]]+pacman[[:space:]]+-S' \
    "$INSTALLER"; then
  fail 'guided repository setup must not install packages'
fi
grep -Fq 'sudo pacman -Syu denial' "$INSTALLER" \
  || fail 'guided repository setup does not print the explicit install command'

install -d -m 0755 "$REPOSITORY_ROOT"
cp -a -- "$EVIDENCE_INPUT" "${OUTPUT_ROOT}/evidence"
install -m 0644 "$INSTALLER" "${OUTPUT_ROOT}/install.sh"

signed_packages=()
for package in "${package_inputs[@]}"; do
  destination="${REPOSITORY_ROOT}/$(basename -- "$package")"
  cp --reflink=auto -- "$package" "$destination"
  gpg \
    --batch \
    --yes \
    --local-user "$FINGERPRINT" \
    --detach-sign \
    --output "${destination}.sig" \
    "$destination"
  gpg --batch --verify "${destination}.sig" "$destination"
  signed_packages+=("$destination")
done

gpg --batch --armor --export "$FINGERPRINT" \
  >"${OUTPUT_ROOT}/denial-repo-key.asc"
exported_fingerprint="$(
  gpg \
    --batch \
    --show-keys \
    --with-colons \
    --fingerprint \
    "${OUTPUT_ROOT}/denial-repo-key.asc" \
    | awk -F: '$1 == "fpr" { print toupper($10); exit }'
)"
[[ "$exported_fingerprint" == "$FINGERPRINT" ]] \
  || fail 'exported public key fingerprint does not match'

repository_database="${REPOSITORY_ROOT}/denial.db.tar.zst"
repo-add \
  --sign \
  --key "$FINGERPRINT" \
  --include-sigs \
  --prevent-downgrade \
  "$repository_database" \
  "${signed_packages[@]}"

materialize_alias() {
  local alias="$1"
  local target

  [[ -L "$alias" ]] || fail "repository alias is not a symlink: $alias"
  target="$(readlink -- "$alias")"
  [[ "$target" != */* && -f "$(dirname -- "$alias")/$target" ]] \
    || fail "repository alias has an unsafe target: $alias -> $target"
  rm -- "$alias"
  cp --reflink=auto -- "$(dirname -- "$alias")/$target" "$alias"
}

for alias in \
  "${REPOSITORY_ROOT}/denial.db" \
  "${REPOSITORY_ROOT}/denial.db.sig" \
  "${REPOSITORY_ROOT}/denial.files" \
  "${REPOSITORY_ROOT}/denial.files.sig"; do
  materialize_alias "$alias"
done

for signed_database in \
  "${REPOSITORY_ROOT}/denial.db.tar.zst" \
  "${REPOSITORY_ROOT}/denial.files.tar.zst"; do
  [[ -f "$signed_database" && -f "${signed_database}.sig" ]] \
    || fail "signed repository database is incomplete: $signed_database"
  gpg --batch --verify "${signed_database}.sig" "$signed_database"
done

mapfile -t database_descriptions < <(
  bsdtar -tf "$repository_database" \
    | awk '/\/desc$/ { print }'
)
((${#database_descriptions[@]} == ${#signed_packages[@]})) \
  || fail 'repository database package count does not match the signed set'

embedded_signatures=0
for description in "${database_descriptions[@]}"; do
  if bsdtar -xOf "$repository_database" "$description" \
    | grep -Fxq '%PGPSIG%'; then
    embedded_signatures=$((embedded_signatures + 1))
  fi
done
((embedded_signatures == ${#signed_packages[@]})) \
  || fail 'repository database does not embed every package signature'

cat >"${OUTPUT_ROOT}/RELEASE-METADATA.txt" <<EOF
DENIAL PUBLIC-ALPHA PACMAN REPOSITORY

Release tag:         $RELEASE_TAG
Source commit:       $SOURCE_SHA
Workflow run:        $WORKFLOW_RUN
Release tooling:     $TOOLING_SHA
Architecture:        x86_64
Signing fingerprint: $FINGERPRINT
Created UTC:         $(date -u +%Y-%m-%dT%H:%M:%SZ)

Build disclosure:
  Built on Denial's owner-operated x86-64 runner.
  Packages and repository databases are signed by the Denial release key.
  This release does not claim an offline dependency closure, reproducible
  packages, independent rebuilding, an SBOM, or AArch64 support.
EOF

release_changes="$(
  awk '
    $0 == "## [Unreleased]" {
      found = 1
      next
    }
    found && /^## \[/ {
      exit
    }
    found {
      print
    }
  ' "$ROOT/CHANGELOG.md"
)"
[[ -n "$release_changes" ]] \
  || fail "CHANGELOG.md has no release notes for ${release_version}"

cat >"${OUTPUT_ROOT}/RELEASE-NOTES.md" <<EOF
## Denial ${release_version}

This is a signed x86-64 public-alpha release of Denial.

- Source tag: \`${RELEASE_TAG}\`
- Source commit: \`${SOURCE_SHA}\`
- Signing fingerprint: \`${FINGERPRINT}\`
- Required packages: \`denial\` and \`denial-flutter-engine\`
- Optional live-development package: \`denial-ui-development\`

${release_changes}

The packages were built on Denial's owner-operated x86-64 runner, then signed
and independently re-verified in a GitHub-hosted signing job. This release
does not yet claim an offline dependency closure, reproducible packages,
independent rebuilding, an SBOM, or AArch64 support.

Installation instructions are in
[\`docs/packaging/arch/INSTALL.md\`](https://github.com/denialwm/denial/blob/${RELEASE_TAG}/docs/packaging/arch/INSTALL.md).
EOF

cat >"${OUTPUT_ROOT}/index.html" <<EOF
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Denial Pacman repository</title>
</head>
<body>
  <main>
    <h1>Denial Pacman repository</h1>
    <p>Signed x86-64 packages for Denial ${release_version}.</p>
    <p>Signing fingerprint: <code>${FINGERPRINT}</code></p>
    <p>Set up the signed repository:</p>
    <pre><code>curl -fsSL https://install.denialwm.org | sh</code></pre>
    <p>
      The <a href="install.sh">setup script</a> does not install packages.
      Install Denial explicitly afterward:
    </p>
    <pre><code>sudo pacman -Syu denial</code></pre>
    <p>
      <a href="https://github.com/denialwm/denial/blob/${RELEASE_TAG}/docs/packaging/arch/INSTALL.md">
        Installation instructions
      </a>
    </p>
  </main>
</body>
</html>
EOF

(
  cd -- "$OUTPUT_ROOT"
  mapfile -d '' checksum_inputs < <(
    find . \
      -type f \
      ! -name SHA256SUMS \
      ! -name SHA256SUMS.sig \
      -print0 \
      | sort -z
  )
  ((${#checksum_inputs[@]} > 0)) \
    || fail 'signed repository has no files to checksum'
  sha256sum -- "${checksum_inputs[@]}" >SHA256SUMS
  sha256sum --check --strict SHA256SUMS
  gpg \
    --batch \
    --yes \
    --local-user "$FINGERPRINT" \
    --detach-sign \
    --output SHA256SUMS.sig \
    SHA256SUMS
  gpg --batch --verify SHA256SUMS.sig SHA256SUMS
)

find "$OUTPUT_ROOT" -type d -exec chmod 0755 {} +
find "$OUTPUT_ROOT" -type f -exec chmod 0644 {} +

unexpected_entry="$(
  find "$OUTPUT_ROOT" ! -type d ! -type f -print -quit
)"
[[ -z "$unexpected_entry" ]] \
  || fail "repository contains an unsupported entry: $unexpected_entry"
linked_file="$(
  find "$OUTPUT_ROOT" -type f -links +1 -print -quit
)"
[[ -z "$linked_file" ]] \
  || fail "repository contains a hard-linked file: $linked_file"

kill_agent
trap - EXIT

printf '%s\n' \
  "Signed public-alpha repository ready: $OUTPUT_ROOT" \
  "Release: $RELEASE_TAG" \
  "Signing fingerprint: $FINGERPRINT" \
  "Packages: ${#signed_packages[@]}"
