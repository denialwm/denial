#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"

if (($# != 2)); then
  printf 'Usage: generate-denial-package-copyright PACKAGE OUTPUT\n' >&2
  exit 2
fi

package_name="$1"
output="$2"

append_license() {
  local label="$1"
  local source="$2"
  printf '\n------------------------------------------------------------------------\n'
  printf '%s\n' "$label"
  printf '%s\n' '------------------------------------------------------------------------'
  cat -- "$source"
  printf '\n'
}

case "$package_name" in
  denial)
    {
      printf '%s\n' \
        'Upstream-Name: Denial' \
        'Source: https://github.com/denialwm/denial' \
        'Upstream-Contact: Doctor Logix <doctor.logix@gmail.com>' \
        '' \
        'This file contains verbatim copies of the distribution licenses for' \
        'the Denial runtime and the visual assets distributed with it.'
      append_license 'Denial project license' "$ROOT/LICENSE"
      append_license 'GNU General Public License version 3' \
        "$ROOT/LICENSES/GPL-3.0-only.txt"
      append_license 'Creative Commons Attribution-ShareAlike 4.0' \
        "$ROOT/LICENSES/CC-BY-SA-4.0.txt"
      append_license 'SIL Open Font License 1.1' \
        "$ROOT/dart_shell/assets/fonts/OFL.txt"
    } >"$output"
    ;;
  denial-flutter-engine)
    {
      printf '%s\n' \
        'Upstream-Name: Denial Flutter Engine' \
        'Source: https://github.com/denialwm/flutter' \
        'Upstream-Contact: Doctor Logix <doctor.logix@gmail.com>' \
        '' \
        'This file contains verbatim copies of the Flutter Engine license and' \
        'the notices and licenses for its bundled third-party components.'
      append_license 'Flutter Engine license' \
        "$ROOT/prebuilt/flutter-engine/linux-x64-release/LICENSE.flutter"
      append_license 'Flutter Engine third-party licenses and notices' \
        "$ROOT/prebuilt/flutter-engine/linux-x64-release/LICENSE.third_party"
    } >"$output"
    ;;
  *)
    printf 'generate-denial-package-copyright: unsupported package: %s\n' \
      "$package_name" >&2
    exit 2
    ;;
esac

chmod 0644 "$output"
