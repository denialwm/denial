#!/usr/bin/env python3
"""Assemble relocatable release-only plugin build inputs; never compile an engine.

Run after denial-flutter-engine prepare-app-build. No installed path or source
checkout is modified. The destination must be new so a mapped compiler cannot
be overwritten. Flutter's writable cache is provisioned per user by the manager.
"""
import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import stat
import subprocess
import sys
from urllib.parse import unquote, urljoin, urlparse


def digest(file):
    with file.open('rb') as stream:
        return hashlib.file_digest(stream, 'sha256').hexdigest()


COMPILER_INPUTS = [
    'gen_snapshot', 'font-subset', 'impellerc', 'icudtl.dat',
    'flutter_patched_sdk', 'flutter_linux', 'libflutter_linux_gtk.so',
    'shader_lib', 'gen/const_finder.dart.snapshot',
]


DISPOSABLE_INPUTS = (
    '.git', '.dart_tool', 'build', '*.d', '*.pyc', '__pycache__',
    'pubspec_overrides.yaml', '.flutter-plugins*',
    # Ignored local cursor reference; its license forbids redistribution.
    'yangyang_xuanling',
)


def input_digest(path, *, copied=False):
    """The same complete, sorted tree encoding as ManagerStore.treeDigest."""
    if not path.is_dir():
        return digest(path)
    result = hashlib.sha256()
    entries = []
    def visit(directory):
        children = list(directory.iterdir())
        ignored = shutil.ignore_patterns(*DISPOSABLE_INPUTS)(
            str(directory), [entry.name for entry in children]) if copied else set()
        for entry in children:
            if entry.name in ignored:
                continue
            entries.append(entry)
            if entry.is_dir() and not entry.is_symlink():
                visit(entry)
    visit(path)
    # Dart sorts full path strings, not pathlib's component tuples. A sibling
    # ui.dart must sort before ui/compositing.dart ('.' precedes '/').
    for entry in sorted(entries, key=str):
        result.update(str(entry.relative_to(path)).encode() + b'\0')
        if entry.is_symlink():
            value = f'link:{os.readlink(entry)}\n'
        elif entry.is_file():
            value = f'file:{digest(entry)}\n'
        else:
            value = 'directory\n'
        result.update(value.encode())
    return result.hexdigest()


def checkout_identity(path):
    def git(*args):
        return subprocess.check_output(['git', '-C', str(path), *args])
    changes = hashlib.sha256(git('diff', '--binary', 'HEAD'))
    untracked = git('ls-files', '-z', '--others', '--exclude-standard')
    for name in sorted(filter(None, untracked.split(b'\0'))):
        changes.update(name + b'\0')
        changes.update(input_digest(path / os.fsdecode(name)).encode())
    dirty = bool(git('status', '--porcelain=v1', '--untracked-files=normal'))
    return {'path': str(path), 'revision': git('rev-parse', 'HEAD').decode().strip(),
            'dirty_sha256': changes.hexdigest() if dirty else None}


def development_provenance(root, flutter, engine, platform, version):
    """Attest an up-to-date canonical release graph, not arbitrary cached bytes."""
    expected_flutter = Path(os.environ.get(
        'DENIAL_FLUTTER_SOURCE_ROOT', '/mnt/exty/denial-flutter-fork-3.44.7')).resolve()
    expected_skia = Path(os.environ.get(
        'DENIAL_SKIA_SOURCE_ROOT', '/mnt/exty/denial-skia-fork-3.44.7')).resolve()
    if bool(os.environ.get('DENIAL_FLUTTER_SOURCE_ROOT')) != bool(
            os.environ.get('DENIAL_SKIA_SOURCE_ROOT')):
        raise ValueError('relocated development forks must be set together')
    if flutter != expected_flutter:
        raise ValueError('development kit must use the canonical Flutter checkout')
    skia = (flutter / 'engine/src/flutter/third_party/skia').resolve()
    if skia != expected_skia:
        raise ValueError('development kit must use the canonical Skia checkout')
    sources = {'flutter': checkout_identity(flutter), 'skia': checkout_identity(skia),
               'denial': checkout_identity(root)}
    if version['frameworkRevision'] != sources['flutter']['revision']:
        raise ValueError('Flutter metadata must declare its actual checkout revision')
    graph = (engine / 'build.ninja').read_text()
    match = re.search(r'^  command = .* --root=([^ ]+) .*', graph, re.M)
    if not match or (engine / match[1]).resolve() != (flutter / 'engine/src').resolve():
        raise ValueError('release graph was not generated from the canonical Flutter tree')
    arguments = (engine / 'args.gn').read_text()
    def gn(name):
        values = re.findall(r'^' + name + r'\s*=\s*(.+)$', arguments, re.M)
        return values[-1].strip().strip('"') if values else None
    cpu = {'linux-x64': 'x64', 'linux-arm64': 'arm64'}[platform]
    for name, wanted in {'host_cpu': cpu, 'target_cpu': cpu, 'target_os': 'linux',
                         'is_debug': 'false', 'flutter_runtime_mode': 'release',
                         'dart_runtime_mode': 'release'}.items():
        if gn(name) != wanted:
            raise ValueError(f'development kit requires native release {name}={wanted}')
    for name, wanted in {'engine_version': sources['flutter']['revision'],
                         'skia_version': sources['skia']['revision']}.items():
        if gn(name) != wanted:
            raise ValueError(f'release graph has stale {name}')
    # Only inspect the existing graph. A missing/stale prerequisite is a scoped
    # build decision for the caller, never an implicit engine/compiler rebuild.
    ready = subprocess.check_output([
        '/usr/bin/ninja', '-n', '-C', str(engine), 'libflutter_engine.so',
        'gen_snapshot', 'flutter_patched_sdk/platform_strong.dill',
        'flutter/sky/packages/sky_engine:sky_engine',
        'gen/const_finder.dart.snapshot', 'font-subset', 'impellerc',
        'libflutter_linux_gtk.so'], text=True)
    if not ready.rstrip().endswith('ninja: no work to do.'):
        raise ValueError('development release compiler graph needs work; prepare only its required targets')
    checksum = root / f'prebuilt/flutter-engine/{platform}-release/libflutter_engine.so.local.sha256'
    engine_sha = digest(engine / 'libflutter_engine.so')
    if not checksum.is_file() or checksum.read_text().split()[0] != engine_sha:
        raise ValueError('development engine differs from its local checksum')
    header = subprocess.check_output(['readelf', '-h', str(engine / 'libflutter_engine.so')],
                                    text=True, env={**os.environ, 'LC_ALL': 'C'})
    machine = {'linux-x64': 'Advanced Micro Devices X86-64', 'linux-arm64': 'AArch64'}[platform]
    if not re.search(r'Machine:\s+' + re.escape(machine) + r'\s*$', header, re.M):
        raise ValueError('development engine ELF architecture differs from target')
    notes = subprocess.check_output(['readelf', '-n', str(engine / 'libflutter_engine.so')],
                                    text=True, env={**os.environ, 'LC_ALL': 'C'})
    build_id = re.search(r'Build ID: ([0-9a-f]+)', notes)
    if not build_id:
        raise ValueError('development engine lacks its ELF build identity')
    return {'schema': 1, 'mode': 'development', 'sources': sources,
            'framework_revision': sources['flutter']['revision'],
            'engine_sha256': engine_sha, 'engine_build_id': build_id[1],
            'platform': platform, 'engine_target': engine.name,
            'args_gn_sha256': digest(engine / 'args.gn'),
            'compiler_inputs': {name: input_digest(engine / name, copied=True) for name in COMPILER_INPUTS},
            'sky_engine_sha256': input_digest(engine / 'gen/dart-pkg/sky_engine', copied=True),
            'dart_sdk_version': (flutter / 'bin/cache/dart-sdk/version').read_text().strip(),
            'frontend_server_sha256': digest(flutter / 'bin/cache/dart-sdk/bin/snapshots/frontend_server_aot.dart.snapshot')}


DEVELOPMENT_ONLY_TREES = {
    'benchmark', 'benchmarks', 'doc', 'docs', 'example', 'examples', 'test', 'tests',
}


def copy(source, destination, *, omit_development=False):
    destination.parent.mkdir(parents=True, exist_ok=True)
    if source.is_dir():
        source_root = source.resolve()
        disposable = shutil.ignore_patterns(*DISPOSABLE_INPUTS)

        def ignored(directory, names):
            result = set(disposable(directory, names))
            if omit_development and Path(directory).resolve() == source_root:
                result.update(DEVELOPMENT_ONLY_TREES.intersection(names))
            return result

        shutil.copytree(source, destination, ignore=ignored)
    else:
        shutil.copy2(source, destination)


def link(source, destination):
    destination.parent.mkdir(parents=True, exist_ok=True)
    destination.symlink_to(os.path.relpath(source, destination.parent),
                           target_is_directory=source.is_dir())


def prune_compiled_tool_dependency(package):
    """Retain Pub's package marker and notices after snapshot compilation."""
    # Nix store sources are read-only. These are private output copies, so make
    # their directories writable while reducing the compiled dependency tree.
    for path in [package, *package.rglob('*')]:
        if not path.is_symlink():
            path.chmod(path.stat().st_mode | stat.S_IWUSR)
    for child in package.iterdir():
        if child.is_symlink():
            child.unlink()
        elif child.is_dir() and child.name.lower() not in {
                'copying', 'license', 'licenses', 'notice'}:
            shutil.rmtree(child)
    # Flutter validates every configured tool dependency as a package before
    # each command. The manifest is required; an empty package URI root keeps
    # the generated package configuration structurally complete.
    (package / 'lib').mkdir(exist_ok=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--flutter-root', type=Path, required=True)
    parser.add_argument('--provenance', choices=['locked-release', 'development'],
                        default='locked-release',
                        help='Development attests canonical local release inputs; default enforces SOURCE_LOCK')
    parser.add_argument('--engine-root', type=Path, required=True)
    parser.add_argument(
        '--engine-source-root',
        type=Path,
        help='Engine source used when generated SDK packages are unavailable',
    )
    parser.add_argument('--engine-target', default='denial_host_release')
    parser.add_argument('--platform', choices=['linux-x64', 'linux-arm64'], required=True)
    parser.add_argument('--output', type=Path, required=True)
    parser.add_argument('--source-root', type=Path,
                        default=Path(__file__).resolve().parent.parent)
    parser.add_argument('--source-revision', help='Packager-supplied source identity without a Git checkout')
    parser.add_argument(
        '--flutter-revision',
        help='Packager-attested Flutter revision when SDK metadata is synthetic',
    )
    args = parser.parse_args()
    if args.provenance == 'development' and (
            args.flutter_revision is not None or args.source_revision is not None or
            os.environ.get('CI', '').lower() in {'1', 'true'}):
        parser.error('development provenance is for local checkouts, not CI or packager attestations')
    root = args.source_root.resolve()
    flutter = args.flutter_root.resolve()
    engine = args.engine_root.resolve() / 'out' / args.engine_target
    output = args.output.absolute()
    if output.exists():
        parser.error('destination already exists; use a new build directory')
    lock = json.loads((root / 'prebuilt/flutter-engine/SOURCE_LOCK.json').read_text())
    version_file = flutter / 'bin/cache/flutter.version.json'
    if not version_file.is_file():
        parser.error(f'Flutter version metadata is missing: {version_file}')
    version = json.loads(version_file.read_text())
    locked_flutter_revision = lock['flutter']['revision']
    provenance = None
    if args.provenance == 'development':
        try:
            provenance = development_provenance(root, flutter, engine, args.platform, version)
        except (ValueError, OSError, subprocess.CalledProcessError) as error:
            parser.error(str(error))
    elif (args.flutter_revision is not None and
            args.flutter_revision != locked_flutter_revision):
        parser.error('packager Flutter revision differs from SOURCE_LOCK.json')
    if (provenance is None and version['frameworkRevision'] != locked_flutter_revision and
            args.flutter_revision != locked_flutter_revision):
        parser.error('Flutter revision differs from SOURCE_LOCK.json')
    release = root / f'prebuilt/flutter-engine/{args.platform}-release'
    expected = (provenance['engine_sha256'] if provenance else
                (release / 'libflutter_engine.so.sha256').read_text().split()[0])
    if digest(engine / 'libflutter_engine.so') != expected:
        parser.error('local engine differs from the pinned release engine')
    output.mkdir(parents=True)
    runtime = output / 'runtime'
    for path in ['packages/denial_sdk', 'packages/denial_flutter_sdk',
                 'plugins/denial_top_bar', 'plugins/denial_desktop', 'plugins/denial_launcher', 'plugins/denial_clock', 'plugins/denial_pets',
                 'plugins/builtins.yaml', 'protocol/generated/dart', 'LICENSE',
                 'prebuilt/flutter-engine/SOURCE_LOCK.json']:
        copy(root / path, runtime / path, omit_development=True)
    for name in ['LICENSE.flutter', 'LICENSE.third_party']:
        copy(release / name, runtime / f'prebuilt/flutter-engine/{args.platform}-release' / name)
    if provenance:
        (runtime / f'prebuilt/flutter-engine/{args.platform}-release/libflutter_engine.so.sha256').write_text(
            f'{expected}  libflutter_engine.so\n')
    else:
        copy(
            release / 'libflutter_engine.so.sha256',
            runtime / f'prebuilt/flutter-engine/{args.platform}-release/libflutter_engine.so.sha256')
    copy(engine / 'libflutter_engine.so', runtime / f'prebuilt/flutter-engine/{args.platform}-release/libflutter_engine.so')
    generation = re.search(r'FLUTTER_ENGINE_ABI: &str = "([^"]+)"',
                           (root / 'compositor/src/lib.rs').read_text()).group(1)
    identity = {
        'schema': 1, 'flutter_generation': generation,
        'required_native_capabilities': ['pluginActionsV1'],
        'source_revision': args.source_revision or subprocess.check_output(
            ['git', '-C', str(root), 'rev-parse', 'HEAD'], text=True).strip(),
        'engine_source_lock_sha256': digest(root / 'prebuilt/flutter-engine/SOURCE_LOCK.json'),
        'source_sha256': hashlib.sha256(json.dumps({
            str(file.relative_to(runtime)): digest(file)
            for file in sorted(runtime.rglob('*')) if file.is_file()
        }, sort_keys=True).encode()).hexdigest(),
    }
    if provenance:
        identity['build_provenance'] = provenance
    (runtime / '.denial-ui-source.json').write_text(json.dumps(identity, indent=2) + '\n')
    sdk = output / 'flutter'
    dart_version = (flutter / 'bin/cache/dart-sdk/version').read_text().strip()
    dart_major, dart_minor, *_ = map(int, dart_version.split('.')[:3])
    dart_constraint = f'>={dart_major}.{dart_minor}.0 <{dart_major + 1}.0.0'
    for path in ['AUTHORS', 'LICENSE', 'PATENT_GRANT', 'bin/internal',
                 'bin/cache/artifacts/material_fonts',
                 'packages/flutter/lib', 'packages/flutter/pubspec.yaml', 'packages/flutter/LICENSE',
                 'packages/flutter_localizations/lib', 'packages/flutter_localizations/pubspec.yaml',
                 'packages/flutter_test/lib', 'packages/flutter_test/pubspec.yaml',
                 'packages/flutter_tools/bin', 'packages/flutter_tools/lib',
                 'packages/flutter_tools/templates', 'packages/flutter_tools/static',
                 'packages/flutter_tools/pubspec.yaml']:
        copy(flutter / path, sdk / path)
    for package in ['sky_engine', 'flutter_gpu']:
        # Analysis must see Denial's dart:ui additions, not the upstream SDK's
        # cached declarations. These are generated by the locked release build.
        if package == 'sky_engine':
            package_source = engine / 'gen/dart-pkg' / package
        else:
            package_source = flutter / 'bin/cache/pkg' / package
            if not package_source.exists() and args.engine_source_root is not None:
                package_source = args.engine_source_root.resolve() / 'src/flutter/lib/gpu'
        if not package_source.exists():
            parser.error(f'Flutter SDK package is missing: {package}')
        copy(package_source, sdk / 'bin/cache/pkg' / package)
    # Android tooling is not required for release Linux shell compilation.
    if (flutter / 'bin/cache/artifacts/gradle_wrapper').exists():
        copy(flutter / 'bin/cache/artifacts/gradle_wrapper',
             sdk / 'bin/cache/artifacts/gradle_wrapper')
    for file in (flutter / 'bin/cache').iterdir():
        if file.is_file() and (file.suffix in ['.stamp', '.json'] or file.name == 'engine.realm'):
            copy(file, sdk / 'bin/cache' / file.name)
    # Nixpkgs gives its immutable Flutter wrapper a synthetic framework
    # revision. The explicit packager attestation above ties that wrapper to
    # SOURCE_LOCK.json; publish the actual revision in the relocatable kit so
    # every later plugin plan and build can verify it normally.
    if provenance is None:
        version['frameworkRevision'] = locked_flutter_revision
        version['repositoryUrl'] = lock['flutter']['repository']
    version_target = sdk / 'bin/cache/flutter.version.json'
    version_replacement = version_target.with_suffix('.json.new')
    version_replacement.write_text(json.dumps(version, indent=2) + '\n')
    version_replacement.replace(version_target)
    # Vendor a relative package configuration, then compile the tool once. Running
    # flutter_tools.dart directly recompiles the entire tool on every Pub/version
    # invocation, which dominates otherwise cached plugin changes.
    config_path = flutter / 'packages/flutter_tools/.dart_tool/package_config.json'
    config = json.loads(config_path.read_text())
    for package in config['packages']:
        source = Path(unquote(urlparse(urljoin(config_path.as_uri(), package['rootUri'])).path))
        target = sdk / 'packages/flutter_tools' if package['name'] == 'flutter_tools' else output / 'tool-packages' / package['name']
        if package['name'] != 'flutter_tools':
            copy(source, target, omit_development=True)
        package['rootUri'] = os.path.relpath(target, sdk / 'packages/flutter_tools/.dart_tool') + '/'
    config.pop('pubCache', None)
    config.pop('flutterRoot', None)
    target_config = sdk / 'packages/flutter_tools/.dart_tool/package_config.json'
    target_config.parent.mkdir(parents=True)
    target_config.write_text(json.dumps(config, indent=2) + '\n')
    subprocess.run([
        str(flutter / 'bin/cache/dart-sdk/bin/dart'),
        '--snapshot-kind=kernel',
        f'--snapshot={sdk / "bin/cache/flutter_tools.snapshot"}',
        f'--packages={target_config}',
        str(sdk / 'packages/flutter_tools/bin/flutter_tools.dart'),
    ], check=True)
    # The snapshot now contains dependency code. Flutter only needs each root's
    # pubspec for its cache self-check; retaining sources would add tens of MiB.
    for package in (output / 'tool-packages').iterdir():
        prune_compiled_tool_dependency(package)
    wrapper = sdk / 'bin/flutter'
    wrapper.write_text(f'''#!/bin/sh
set -eu
FLUTTER_ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
export FLUTTER_ROOT
exec "$FLUTTER_ROOT/bin/cache/dart-sdk/bin/dart" \\
  --packages="$FLUTTER_ROOT/packages/flutter_tools/.dart_tool/package_config.json" \\
  "$FLUTTER_ROOT/bin/cache/flutter_tools.snapshot" \\
  --local-engine-src-path="$FLUTTER_ROOT/../engine" \\
  --local-engine={args.engine_target} --local-engine-host={args.engine_target} "$@"
''')
    wrapper.chmod(0o755)
    target_engine = output / 'engine/out' / args.engine_target
    for path in COMPILER_INPUTS:
        copy(engine / path, target_engine / path)
    (target_engine / 'libflutter_engine.so').symlink_to(
        f'../../../runtime/prebuilt/flutter-engine/{args.platform}-release/libflutter_engine.so')
    # Local-engine shader lookup and static analysis also consult Flutter cache.
    # Keep one immutable copy of these compiler inputs and link the cache view to
    # it; the complete kit is copied as a unit into each user's writable cache.
    for path in ['shader_lib', 'font-subset', 'impellerc', 'icudtl.dat']:
        link(target_engine / path,
             sdk / f'bin/cache/artifacts/engine/{args.platform}' / path)
    link(target_engine / 'gen/const_finder.dart.snapshot',
         sdk / f'bin/cache/artifacts/engine/{args.platform}/const_finder.dart.snapshot')
    # Fingerprint the entire shipped input set, including dirty development inputs.
    files = {str(file.relative_to(output)): digest(file)
             for file in sorted(output.rglob('*')) if file.is_file() and not file.is_symlink()}
    links = {str(file.relative_to(output)): os.readlink(file)
             for file in sorted(output.rglob('*')) if file.is_symlink()}
    manifest = {'schema': 1, 'platform': args.platform, 'engineTarget': args.engine_target,
                'dartVersion': dart_version,
                'dartConstraint': dart_constraint,
                'identity': identity, 'files': files, 'links': links}
    if provenance:
        # Detect source/output movement during copying and tool compilation.
        if development_provenance(root, flutter, engine, args.platform, version) != provenance:
            sys.exit('development sources/compiler changed while preparing the kit; retain it and retry in a new directory')
    encoded = json.dumps(manifest, sort_keys=True, indent=2) + '\n'
    (output / 'kit.json').write_text(encoded)
    print(f'Prepared plugin build inputs at {output} ({hashlib.sha256(encoded.encode()).hexdigest()})')


if __name__ == '__main__':
    main()
