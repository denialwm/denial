#!/usr/bin/env bash
set -euo pipefail

readonly RUNNER_PARENT='/srv/denial-builder/runner'
readonly RUNNER_INSTANCE="${RUNNER_PARENT}/current"

if ((EUID != 0)); then
  printf 'denial-actions-runner-cleanup: must run as root\n' >&2
  exit 1
fi

if [[ "$(readlink -f -- "$RUNNER_PARENT")" != "$RUNNER_PARENT" ]]; then
  printf 'denial-actions-runner-cleanup: unexpected runner parent\n' >&2
  exit 1
fi

if [[ -L "$RUNNER_INSTANCE" ]]; then
  rm -f -- "$RUNNER_INSTANCE"
elif [[ -d "$RUNNER_INSTANCE" ]]; then
  shopt -s dotglob nullglob
  instance_entries=("$RUNNER_INSTANCE"/*)
  if ((${#instance_entries[@]})); then
    rm -rf --one-file-system -- "${instance_entries[@]}"
  fi

  # ExecStopPost runs before systemd tears down the service mount namespace.
  # The directory can still be a transient bind-mount root at that point, but
  # its credential-bearing contents are gone. A later operator cleanup removes
  # the now-empty directory after the namespace has disappeared.
  rmdir -- "$RUNNER_INSTANCE" 2>/dev/null || true
elif [[ -e "$RUNNER_INSTANCE" ]]; then
  printf 'denial-actions-runner-cleanup: instance is not a directory\\n' >&2
  exit 1
fi
