#!/usr/bin/env bash
set -euo pipefail

die() {
  printf 'denial-session: %s\n' "$*" >&2
  exit 1
}

launcher_path="$(readlink -f -- "${BASH_SOURCE[0]}")" \
  || die 'could not resolve the installed launcher path'
launcher_bin="$(dirname -- "$launcher_path")"
package_prefix="$(dirname -- "$launcher_bin")"
readonly launcher_path launcher_bin package_prefix
readonly DEFAULT_BUNDLE="$package_prefix/lib/denial/flutter"
readonly DENIALD="$launcher_bin/deniald"
readonly DENIALCTL="$launcher_bin/denialctl"

installed_config() {
  local override="$1"
  local system_path="$2"
  local packaged_path="$3"
  local configured="${!override:-}"

  if [[ -n "$configured" ]]; then
    [[ "$configured" == /* ]] \
      || die "$override must be an absolute path: $configured"
    printf '%s\n' "$configured"
  elif [[ -e "$system_path" || -L "$system_path" ]]; then
    printf '%s\n' "$system_path"
  else
    printf '%s\n' "$packaged_path"
  fi
}

CONFIG_FILE="$(installed_config \
  DENIAL_SESSION_CONFIG \
  /etc/denial/session.conf \
  "$package_prefix/etc/denial/session.conf")"
SYSTEM_OUTPUT_CONFIG="$(installed_config \
  DENIAL_SYSTEM_OUTPUT_CONFIG \
  /etc/denial/outputs.conf \
  "$package_prefix/etc/denial/outputs.conf")"
readonly CONFIG_FILE SYSTEM_OUTPUT_CONFIG

# The shell and Settings app inherit exact package-relative paths. Development
# can still override them explicitly, while regular installations never depend
# on a distribution choosing /usr/bin as its prefix.
export DENIAL_COMPOSITOR_BINARY="${DENIAL_COMPOSITOR_BINARY:-$DENIALD}"
export DENIAL_CONTROL_TOOL="${DENIAL_CONTROL_TOOL:-$DENIALCTL}"
export DENIAL_SETTINGS_BINARY="${DENIAL_SETTINGS_BINARY:-$launcher_bin/denial-settings}"

discover_user_systemctl() {
  local candidate resolved

  candidate="$(command -v systemctl 2>/dev/null)" || return 1
  [[ "$candidate" == /* && -x "$candidate" ]] || return 1
  resolved="$(readlink -f -- "$candidate")" || return 1
  [[ -x "$resolved" ]] || return 1
  "$resolved" --user show-environment >/dev/null 2>&1 || return 1
  printf '%s\n' "$resolved"
}

default_user_output_config() {
  local config_home="${XDG_CONFIG_HOME:-}"
  if [[ -z "$config_home" ]]; then
    [[ -n "${HOME:-}" ]] \
      || die 'HOME is unset and XDG_CONFIG_HOME was not provided'
    config_home="$HOME/.config"
  fi
  [[ "$config_home" == /* ]] \
    || die "XDG_CONFIG_HOME must be an absolute path: $config_home"
  printf '%s/denial/outputs.conf\n' "${config_home%/}"
}

default_user_output_state() {
  local state_home="${XDG_STATE_HOME:-}"
  if [[ -z "$state_home" ]]; then
    [[ -n "${HOME:-}" ]] \
      || die 'HOME is unset and XDG_STATE_HOME was not provided'
    state_home="$HOME/.local/state"
  fi
  [[ "$state_home" == /* ]] \
    || die "XDG_STATE_HOME must be an absolute path: $state_home"
  printf '%s/denial/outputs.conf\n' "${state_home%/}"
}

is_writable_output_config() {
  local target="$1"
  local parent

  [[ ! -L "$target" && -f "$target" && -r "$target" && -w "$target" ]] \
    || return 1
  parent="$(dirname -- "$target")"
  [[ -d "$parent" && -w "$parent" && -x "$parent" ]]
}

sync_declarative_output_state() {
  local source="$1"
  local target="$2"
  local parent
  local snapshot
  local state_temp=''
  local snapshot_temp=''

  parent="$(dirname -- "$target")"
  snapshot="$target.declarative-source"
  [[ -f "$source" && -r "$source" ]] \
    || die "declarative output configuration is not a readable regular file: $source"
  [[ ! -L "$target" ]] \
    || die "writable output state must not be a symbolic link: $target"
  [[ ! -L "$snapshot" ]] \
    || die "output state source snapshot must not be a symbolic link: $snapshot"

  (
    umask 077
    mkdir -p -- "$parent"
    if [[ ! -f "$target" || ! -f "$snapshot" ]] \
      || ! cmp -s -- "$source" "$snapshot"; then
      state_temp="$(mktemp -- "$parent/.outputs.conf.XXXXXX")"
      snapshot_temp="$(mktemp -- "$parent/.outputs.conf.source.XXXXXX")"
      trap 'rm -f -- "${state_temp:-}" "${snapshot_temp:-}"' EXIT
      install -m 600 -- "$source" "$state_temp"
      install -m 600 -- "$source" "$snapshot_temp"
      mv -fT -- "$state_temp" "$target"
      state_temp=''
      mv -fT -- "$snapshot_temp" "$snapshot"
      snapshot_temp=''
      trap - EXIT
    fi
  ) || die "could not synchronize declarative output configuration into writable state: $target"
}

resolve_output_config() {
  local configured="${DENIAL_OUTPUT_CONFIG:-}"
  local source
  local state
  local user_config

  user_config="$(default_user_output_config)"
  if [[ -n "$configured" ]]; then
    [[ "$configured" == /* ]] \
      || die "DENIAL_OUTPUT_CONFIG must be an absolute path: $configured"
    source="$configured"
  elif [[ -e "$user_config" || -L "$user_config" ]]; then
    source="$user_config"
  else
    source="$SYSTEM_OUTPUT_CONFIG"
  fi

  if is_writable_output_config "$source"; then
    printf '%s\n' "$source"
    return
  fi

  state="$(default_user_output_state)"
  sync_declarative_output_state "$source" "$state"
  printf '%s\n' "$state"
}

validate_output_state() {
  local target="$1"
  local parent

  [[ ! -L "$target" ]] \
    || die "writable output state must not be a symbolic link: $target"
  [[ -f "$target" && -r "$target" && -w "$target" ]] \
    || die "output state is not a readable and writable regular file: $target"
  parent="$(dirname -- "$target")"
  [[ -d "$parent" && -w "$parent" && -x "$parent" ]] \
    || die "output state directory must be writable for persistent display changes: $parent"
}

card_has_connected_output() {
  local sys_card="$1"
  local status
  for status in "$sys_card"-*/status; do
    [[ -r "$status" ]] || continue
    if [[ "$(< "$status")" == connected ]]; then
      return 0
    fi
  done
  return 1
}

card_device() {
  local sys_card="$1"
  local name="${sys_card##*/}"
  local device="/dev/dri/$name"
  [[ -c "$device" ]] || return 1
  readlink -f -- "$device"
}

automatic_drm_device() {
  local sys_card
  local boot_vga

  for sys_card in /sys/class/drm/card[0-9]*; do
    [[ -e "$sys_card" && "${sys_card##*/}" =~ ^card[0-9]+$ ]] || continue
    boot_vga="$sys_card/device/boot_vga"
    if [[ -r "$boot_vga" ]] \
      && [[ "$(< "$boot_vga")" == 1 ]] \
      && card_has_connected_output "$sys_card"; then
      card_device "$sys_card"
      return
    fi
  done

  for sys_card in /sys/class/drm/card[0-9]*; do
    [[ -e "$sys_card" && "${sys_card##*/}" =~ ^card[0-9]+$ ]] || continue
    if card_has_connected_output "$sys_card"; then
      card_device "$sys_card"
      return
    fi
  done

  for sys_card in /sys/class/drm/card[0-9]*; do
    [[ -e "$sys_card" && "${sys_card##*/}" =~ ^card[0-9]+$ ]] || continue
    boot_vga="$sys_card/device/boot_vga"
    if [[ -r "$boot_vga" ]] && [[ "$(< "$boot_vga")" == 1 ]]; then
      card_device "$sys_card"
      return
    fi
  done

  for sys_card in /sys/class/drm/card[0-9]*; do
    [[ -e "$sys_card" && "${sys_card##*/}" =~ ^card[0-9]+$ ]] || continue
    if card_device "$sys_card"; then
      return
    fi
  done

  return 1
}

resolve_drm_device() {
  local configured="${DENIAL_DRM_DEVICE:-}"
  local resolved
  if [[ -n "$configured" ]]; then
    resolved="$(readlink -f -- "$configured")" \
      || die "configured DRM device does not exist: $configured"
    [[ -c "$resolved" ]] \
      || die "configured DRM device is not a character device: $resolved"
    printf '%s\n' "$resolved"
    return
  fi

  automatic_drm_device \
    || die 'no usable DRM card was found below /sys/class/drm'
}

resolve_render_device() {
  local configured="${DENIAL_RENDER_DEVICE:-}"
  local resolved
  [[ -n "$configured" ]] || return 0
  resolved="$(readlink -f -- "$configured")" \
    || die "configured render device does not exist: $configured"
  [[ -c "$resolved" ]] \
    || die "configured render device is not a character device: $resolved"
  printf '%s\n' "$resolved"
}

drm_kernel_driver() {
  local device="$1"
  local driver
  driver="$(readlink -f -- "/sys/class/drm/${device##*/}/device/driver" 2>/dev/null)" \
    || return 1
  [[ -n "$driver" ]] || return 1
  printf '%s\n' "${driver##*/}"
}

should_enable_software_rendering() {
  [[ "$1" == vmwgfx && -z "${LIBGL_ALWAYS_SOFTWARE+x}" ]]
}

if [[ -r "$CONFIG_FILE" ]]; then
  # This is a root-owned, shell-compatible machine configuration.
  # shellcheck source=/dev/null
  source "$CONFIG_FILE"
fi

shell_profile="${DENIAL_SHELL_PROFILE-${DENIA_SHELL_PROFILE-desktop}}"
case "$shell_profile" in
  mobile | desktop) ;;
  *) die "DENIAL_SHELL_PROFILE must be mobile or desktop, got: $shell_profile" ;;
esac
export DENIAL_SHELL_PROFILE="$shell_profile"
export DENIA_SHELL_PROFILE="$shell_profile"

flutter_renderer="${DENIAL_FLUTTER_RENDERER-${DENIA_FLUTTER_RENDERER-}}"
case "$flutter_renderer" in
  '' | skia | impeller) ;;
  *) die "DENIAL_FLUTTER_RENDERER must be skia or impeller, got: $flutter_renderer" ;;
esac

no_predecessor="${DENIAL_NO_PREDECESSOR-${DENIA_NO_PREDECESSOR-}}"
export DENIAL_NO_PREDECESSOR="$no_predecessor"
export DENIA_NO_PREDECESSOR="$no_predecessor"

xwayland_scale_mode="${DENIAL_XWAYLAND_SCALE_MODE:-fractional}"
case "$xwayland_scale_mode" in
  fractional | integer) ;;
  *) die "DENIAL_XWAYLAND_SCALE_MODE must be fractional or integer, got: $xwayland_scale_mode" ;;
esac
export DENIAL_XWAYLAND_SCALE_MODE="$xwayland_scale_mode"

# Qt only consults the desktop Settings portal when its portal-backed platform
# theme provider is selected. Choose that provider for a Denial session while
# preserving an explicit inherited or machine-configured override, including
# an explicitly empty value.
qt_platform_theme="${QT_QPA_PLATFORMTHEME-xdgdesktopportal}"
export QT_QPA_PLATFORMTHEME="$qt_platform_theme"

bundle="${DENIAL_FLUTTER_BUNDLE:-$DEFAULT_BUNDLE}"
output_config="$(resolve_output_config)"
validate_output_state "$output_config"
if [[ "${1:-}" == --print-output-config ]]; then
  printf '%s\n' "$output_config"
  exit 0
fi
drm_device="$(resolve_drm_device)"
render_device="$(resolve_render_device)"
effective_render_device="${render_device:-$drm_device}"
render_driver="$(drm_kernel_driver "$effective_render_device" || true)"
software_rendering=0
mesa_rendering='hardware/default'
if should_enable_software_rendering "$render_driver"; then
  software_rendering=1
  mesa_rendering='software (automatic vmwgfx compatibility)'
elif [[ -n "${LIBGL_ALWAYS_SOFTWARE+x}" ]]; then
  mesa_rendering="environment override (LIBGL_ALWAYS_SOFTWARE=${LIBGL_ALWAYS_SOFTWARE})"
fi
systemctl_bin="$(discover_user_systemctl || true)"
if [[ -n "$systemctl_bin" ]]; then
  session_lifecycle='systemd user manager'
else
  session_lifecycle='launcher process'
fi
readonly systemctl_bin session_lifecycle

[[ -f "$DENIALD" && -x "$DENIALD" ]] \
  || die "missing compositor beside the session launcher: $DENIALD"
[[ -f "$DENIALCTL" && -x "$DENIALCTL" ]] \
  || die "missing control client beside the session launcher: $DENIALCTL"
if [[ -n "$systemctl_bin" ]]; then
  "$systemctl_bin" --user cat denial-session.target >/dev/null 2>&1 \
    || die 'denial-session.target is not available to the systemd user manager'
fi
[[ -f "$bundle/data/icudtl.dat" ]] || die "missing Flutter ICU data below $bundle"
[[ -f "$bundle/lib/libapp.so" ]] || die "missing Flutter application below $bundle"
[[ -f "$bundle/lib/libflutter_engine.so" ]] \
  || die "missing Flutter engine below $bundle"
command -v Xwayland >/dev/null 2>&1 \
  || die 'Xwayland is required for X11 applications'

if [[ "${1:-}" == --check ]]; then
  printf 'ok  %-16s %s\n' 'compositor' "$DENIALD"
  printf 'ok  %-16s %s\n' 'control client' "$DENIALCTL"
  if [[ -n "$systemctl_bin" ]]; then
    printf 'ok  %-16s %s (%s)\n' \
      'session lifecycle' "$session_lifecycle" denial-session.target
  else
    printf 'ok  %-16s %s\n' 'session lifecycle' "$session_lifecycle"
  fi
  printf 'ok  %-16s %s\n' 'Flutter bundle' "$bundle"
  printf 'ok  %-16s %s\n' 'output config' "$output_config"
  printf 'ok  %-16s %s\n' 'DRM device' "$drm_device"
  printf 'ok  %-16s %s\n' 'render device' "$effective_render_device"
  printf 'ok  %-16s %s\n' 'render driver' "${render_driver:-unknown}"
  printf 'ok  %-16s %s\n' 'Mesa rendering' "$mesa_rendering"
  printf 'ok  %-16s %s\n' 'shell profile' "$DENIAL_SHELL_PROFILE"
  printf 'ok  %-16s %s\n' 'Flutter renderer' "${flutter_renderer:-impeller (default)}"
  printf 'ok  %-16s %s\n' 'Xwayland scale' "$xwayland_scale_mode"
  printf 'ok  %-16s %s\n' \
    'Qt platform theme' "${qt_platform_theme:-toolkit default (explicit)}"
  printf 'ok  %-16s %s\n' 'Xwayland' "$(command -v Xwayland)"
  exit 0
fi

[[ -z "${WAYLAND_DISPLAY:-}" ]] \
  || die 'a Wayland compositor is already active; log out before starting Denial'

denial_args=(
  --device "$drm_device"
  --output-config "$output_config"
  --wayland
  --flutter-bundle "$bundle"
)
if [[ -n "$render_device" ]]; then
  denial_args+=(--render-device "$render_device")
fi
if [[ -n "$flutter_renderer" ]]; then
  denial_args+=(--flutter-renderer "$flutter_renderer")
fi
if [[ "$software_rendering" == 1 ]]; then
  denial_args+=(--software-rendering)
fi
if [[ -n "${DENIAL_FLUTTER_DEBUG_BUNDLE:-}" ]]; then
  [[ "$DENIAL_FLUTTER_DEBUG_BUNDLE" == /* ]] \
    || die "DENIAL_FLUTTER_DEBUG_BUNDLE must be absolute: $DENIAL_FLUTTER_DEBUG_BUNDLE"
  denial_args+=(--flutter-debug-bundle "$DENIAL_FLUTTER_DEBUG_BUNDLE")
fi
if [[ -n "${DENIAL_FLUTTER_UI_WORKSPACE:-}" ]]; then
  [[ "$DENIAL_FLUTTER_UI_WORKSPACE" == /* ]] \
    || die "DENIAL_FLUTTER_UI_WORKSPACE must be absolute: $DENIAL_FLUTTER_UI_WORKSPACE"
  denial_args+=(--flutter-ui-workspace "$DENIAL_FLUTTER_UI_WORKSPACE")
fi

unset DISPLAY WAYLAND_DISPLAY HYPRLAND_INSTANCE_SIGNATURE SWAYSOCK I3SOCK
unset NO_COLOR WLR_DRM_DEVICES AQ_DRM_DEVICES
export RUST_BACKTRACE="${RUST_BACKTRACE:-1}"
export RUST_LOG="${DENIAL_RUST_LOG:-deniald=info,smithay=warn}"

denial_pid=''

stop_graphical_session() {
  if [[ -n "$systemctl_bin" ]]; then
    "$systemctl_bin" --user stop graphical-session.target >/dev/null 2>&1 || true
  fi
}

terminate_denial() {
  # The display manager can signal the launcher and compositor together.
  # Ignore re-entrant termination while the child performs its bounded KMS
  # handoff; restoring SIG_DFL from inside Bash's active trap can make Bash
  # resend that same signal to itself before wait returns.
  trap '' HUP INT TERM
  if [[ -n "$denial_pid" ]] && kill -0 "$denial_pid" 2>/dev/null; then
    kill -TERM "$denial_pid" 2>/dev/null || true
    wait "$denial_pid" 2>/dev/null || true
  fi
  exit 143
}

trap stop_graphical_session EXIT
trap terminate_denial HUP INT TERM

"$DENIALD" "${denial_args[@]}" "$@" &
denial_pid=$!
set +e
wait "$denial_pid"
denial_status=$?
set -e
denial_pid=''
exit "$denial_status"
