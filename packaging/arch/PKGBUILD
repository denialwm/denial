# Maintainer: Doctor Logix <doctor.logix@gmail.com>

pkgname=denial
pkgver="${DENIAL_PACKAGE_VERSION:-0}"
pkgrel="${DENIAL_PACKAGE_RELEASE:-1}"
pkgdesc='Flutter-native Wayland compositor and desktop shell'
arch=('x86_64')
url='https://github.com/denialwm/denial'
license=(
  'GPL-3.0-or-later'
  'CC-BY-SA-4.0'
  'GPL-3.0-only'
  'OFL-1.1'
)
_flutter_generation='3.44.7.denial1'
depends=(
  'adobe-source-han-sans-cn-fonts'
  'bash'
  'coreutils'
  'ddcutil'
  'denial-flutter-engine'
  "denial-flutter-engine-abi=${_flutter_generation}"
  'dbus'
  'glibc'
  'gtk3'
  'libgcc'
  'libglvnd'
  'libinput'
  'libpulse'
  'libxkbcommon'
  'mesa'
  'pam'
  'rtkit'
  'seatd'
  'systemd-libs'
  'xkeyboard-config'
  'xdg-desktop-portal'
  'xdg-desktop-portal-gtk'
  'xdg-desktop-portal-wlr'
  'xorg-xwayland'
  'zenity'
)
optdepends=(
  'denial-ui-development: live Flutter UI editing and hot reload'
  'iwd: Wi-Fi controls without NetworkManager'
  'lact: AMD GPU performance controls'
  'networkmanager: Wi-Fi and network controls through NetworkManager'
  'pipewire-pulse: desktop audio controls'
  'power-profiles-daemon: system power profiles'
  'sddm: graphical login and session selection'
  'upower: battery and power status'
)
conflicts=('denial-git')
backup=(
  'etc/denial/outputs.conf'
  'etc/denial/session.conf'
  'etc/xdg/xdg-desktop-portal-wlr/Denial'
)
options=('!strip' '!debug')
source=(
  'denial-session'
  "denial-session.target::file://$startdir/../denial-session.target"
  'denial.desktop'
  'dev.denial.Settings.desktop'
  'denial-portal.service'
  'denial.portal'
  'denial-portals.conf'
  'org.freedesktop.impl.portal.desktop.denial.service'
  'outputs.conf'
  'session.conf'
  'xdg-desktop-portal-wlr-Denial'
)
sha256sums=(
  'd3807fd0d955b9f9922a1d068613a64085c5f37f7fadecb22b4b0e38854bb4df'
  'f4672dd57973a65c6b91def4e97a2824da0a69f02132301c625d6177799f207b'
  'b4fa50a715fdf36737a72241596c307534cb8665d42b8a947b28df54ab04a0b1'
  'b9ef447d94ad8f1ac041462d25e2f86b12c7da52ef67f4df725bfb374f74ea3c'
  'e0b01affe089a35821475cba9f8e2d982e0abbeafcdfe320fa43411d77c82390'
  'b50dc233ee7e74c6c1fefbcfe03ed79b030ee5bd4369e19ff21199daa8159e0f'
  'e9e98058ed0831f659d811d4901a9f9dd508c7aeaf33decab3fffd5464ace2d1'
  '4a60d3ff767caf9d84c1a35b0d76d04e9e135cbabc384d1daac3f358398760de'
  '7c3abc34d9250bcaeb3822c93479ef3c75069c6d234ce2a7f3baf598588fa016'
  '7b2ca14a61e49e5e099da3dbba23db13fc466bd9fa7f0d8903f8fc0d678bdc58'
  '3b4e3a52dff1a2ece31d122bd7220ddee2bdbaeb73ebe24ed9bd8c350580cd30'
)

package() {
  local repository_root="${DENIAL_PACKAGE_SOURCE_ROOT:-$(realpath "$startdir/../..")}"
  local cache_root="${XDG_CACHE_HOME:-$HOME/.cache}"
  local binary="${DENIAL_PACKAGE_BINARY:-$cache_root/denial/pc-build/rust/release/deniald}"
  local control_binary="${DENIAL_PACKAGE_CONTROL_BINARY:-$cache_root/denial/pc-build/rust/release/denialctl}"
  local portal_binary="${DENIAL_PACKAGE_PORTAL_BINARY:-$cache_root/denial/pc-build/rust/release/denial-portal}"
  local bundle="${DENIAL_PACKAGE_BUNDLE:-$repository_root/dart_shell/build/linux/x64/release/bundle}"
  local settings_bundle="${DENIAL_PACKAGE_SETTINGS_BUNDLE:-$repository_root/settings_app/build/linux/x64/release/bundle}"
  local payload_root="${DENIAL_PACKAGE_PAYLOAD_ROOT:-}"
  local runtime_version_file="${DENIAL_PACKAGE_RUNTIME_VERSION_FILE:-}"
  local runtime_version

  install_runtime_version() {
    [[ -n "$runtime_version_file" ]] || return 0
    if [[ ! -f "$runtime_version_file" ]]; then
      error "Denial runtime-version file is missing: $runtime_version_file"
      return 1
    fi
    runtime_version="$(<"$runtime_version_file")"
    if [[ ! "$runtime_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
      error "Denial runtime version is invalid: $runtime_version"
      return 1
    fi
    install -Dm644 "$runtime_version_file" \
      "$pkgdir/usr/share/denial/version"
  }

  if [[ -n "$payload_root" ]]; then
    if [[ ! -d "$payload_root" ]]; then
      error "Denial promotion payload is missing: $payload_root"
      return 1
    fi
    cp -a --no-preserve=ownership -- "$payload_root/." "$pkgdir/"
    install_runtime_version
    return
  fi

  if [[ ! -x "$binary" ]]; then
    error "Denial compositor is missing: $binary"
    error "Build through tools/denial-pc arch-package."
    return 1
  fi
  if [[ ! -x "$control_binary" ]]; then
    error "Denial control client is missing: $control_binary"
    error "Build through tools/denial-pc arch-package."
    return 1
  fi
  if [[ ! -x "$portal_binary" ]]; then
    error "Denial portal backend is missing: $portal_binary"
    error "Build through tools/denial-pc arch-package."
    return 1
  fi
  for required in \
    "$bundle/data/flutter_assets/AssetManifest.bin" \
    "$bundle/lib/libapp.so" \
    "$settings_bundle/denial-settings" \
    "$settings_bundle/data/flutter_assets/AssetManifest.bin" \
    "$settings_bundle/lib/libapp.so" \
    "$settings_bundle/lib/libflutter_linux_gtk.so"; do
    if [[ ! -f "$required" ]]; then
      error "Flutter bundle component is missing: $required"
      error "Build through tools/denial-pc arch-package."
      return 1
    fi
  done

  install -Dm755 "$binary" "$pkgdir/usr/bin/deniald"
  install -Dm755 "$control_binary" "$pkgdir/usr/bin/denialctl"
  install -Dm755 "$portal_binary" "$pkgdir/usr/bin/denial-portal"
  install -Dm755 "$srcdir/denial-session" "$pkgdir/usr/bin/denial-session"
  install -Dm644 "$srcdir/denial-session.target" \
    "$pkgdir/usr/lib/systemd/user/denial-session.target"
  install -Dm644 "$srcdir/denial-portal.service" \
    "$pkgdir/usr/lib/systemd/user/denial-portal.service"

  install -dm755 \
    "$pkgdir/usr/lib/denial/flutter/data" \
    "$pkgdir/usr/lib/denial/flutter/lib"
  cp -a -- "$bundle/data/flutter_assets" \
    "$pkgdir/usr/lib/denial/flutter/data/flutter_assets"
  chmod -R u=rwX,go=rX \
    "$pkgdir/usr/lib/denial/flutter/data/flutter_assets"
  install -m755 "$bundle/lib/libapp.so" \
    "$pkgdir/usr/lib/denial/flutter/lib/libapp.so"

  install -dm755 "$pkgdir/usr/lib/denial/settings"
  cp -a -- "$settings_bundle/." "$pkgdir/usr/lib/denial/settings/"
  chmod -R u=rwX,go=rX "$pkgdir/usr/lib/denial/settings"
  ln -s ../lib/denial/settings/denial-settings \
    "$pkgdir/usr/bin/denial-settings"

  install -Dm644 "$srcdir/denial.desktop" \
    "$pkgdir/usr/share/wayland-sessions/denial.desktop"
  install -Dm644 "$srcdir/dev.denial.Settings.desktop" \
    "$pkgdir/usr/share/applications/dev.denial.Settings.desktop"
  install -Dm644 "$srcdir/denial-portals.conf" \
    "$pkgdir/usr/share/xdg-desktop-portal/denial-portals.conf"
  install -Dm644 "$srcdir/denial.portal" \
    "$pkgdir/usr/share/xdg-desktop-portal/portals/denial.portal"
  install -Dm644 "$srcdir/org.freedesktop.impl.portal.desktop.denial.service" \
    "$pkgdir/usr/share/dbus-1/services/org.freedesktop.impl.portal.desktop.denial.service"
  install -Dm644 "$srcdir/xdg-desktop-portal-wlr-Denial" \
    "$pkgdir/etc/xdg/xdg-desktop-portal-wlr/Denial"
  install -Dm644 "$srcdir/outputs.conf" "$pkgdir/etc/denial/outputs.conf"
  install -Dm644 "$srcdir/session.conf" "$pkgdir/etc/denial/session.conf"

  install -Dm644 "$repository_root/README.md" \
    "$pkgdir/usr/share/doc/denial/README.md"
  "$repository_root/tools/generate-denial-package-copyright" \
    denial "$pkgdir/usr/share/doc/denial/copyright"
  install -Dm644 "$repository_root/docs/man/denialctl.1" \
    "$pkgdir/usr/share/man/man1/denialctl.1"
  install -Dm644 "$repository_root/docs/man/deniald.1" \
    "$pkgdir/usr/share/man/man1/deniald.1"
  install -Dm644 "$repository_root/docs/man/denial-session.1" \
    "$pkgdir/usr/share/man/man1/denial-session.1"
  install -Dm644 "$repository_root/docs/man/denial-portal.1" \
    "$pkgdir/usr/share/man/man1/denial-portal.1"
  install -Dm644 \
    "$repository_root/dart_shell/assets/wallpapers/ATTRIBUTION.md" \
    "$pkgdir/usr/share/doc/denial/WALLPAPERS.md"
  install -Dm644 \
    "$repository_root/dart_shell/assets/cursors/BIBATA_MODERN_ICE.md" \
    "$pkgdir/usr/share/doc/denial/CURSORS.md"
  install -Dm644 \
    "$repository_root/dart_shell/assets/cursors/bibata_modern_ice.sha256" \
    "$pkgdir/usr/share/doc/denial/BIBATA_MODERN_ICE.sha256"
  install -Dm644 "$repository_root/dart_shell/assets/fonts/README.md" \
    "$pkgdir/usr/share/doc/denial/FONTS.md"
  install -Dm644 \
    "$repository_root/dart_shell/assets/fonts/JetBrainsMono.sha256" \
    "$pkgdir/usr/share/doc/denial/JETBRAINS_MONO.sha256"
  install -Dm644 \
    "$repository_root/third_party/bibata/Bibata_Cursor-v2.0.7-source.tar.gz" \
    "$pkgdir/usr/share/doc/denial/sources/Bibata_Cursor-v2.0.7-source.tar.gz"
  install -Dm644 "$repository_root/LICENSES/CC-BY-SA-4.0.txt" \
    "$pkgdir/usr/share/licenses/denial/CC-BY-SA-4.0.txt"
  install -Dm644 "$repository_root/LICENSES/GPL-3.0-only.txt" \
    "$pkgdir/usr/share/licenses/denial/GPL-3.0-only.txt"
  install -Dm644 "$repository_root/dart_shell/assets/fonts/OFL.txt" \
    "$pkgdir/usr/share/licenses/denial/OFL-1.1.txt"
  install -Dm644 "$repository_root/LICENSE" \
    "$pkgdir/usr/share/licenses/denial/LICENSE"
  install_runtime_version
}
