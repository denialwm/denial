#!/bin/sh
set -e

if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ] \
  && command -v deb-systemd-invoke >/dev/null 2>&1; then
  # Removal and upgrades must invalidate cached user-unit definitions without
  # stopping the active graphical session.
  deb-systemd-invoke --user daemon-reload >/dev/null || true
fi

exit 0
