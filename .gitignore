/compositor/target/
/compositor/flutter-engine/target/
/tools/xtask/target/
/tools/flutter-embedder-bindings/target/
/dart_shell/.dart_tool/
/dart_shell/build/
/dart_shell/.flutter-plugins
/dart_shell/.flutter-plugins-dependencies
/.denial-ui-source.json

# Local credentials and environment overrides.
/.env

# Locally rebuilt Flutter Embedder library. Its sources, build recipe, and
# expected checksum are tracked; the generated architecture-specific binary
# is not.
/prebuilt/flutter-engine/*/libflutter_engine.so

# In-tree makepkg output. Denial's packaging tool normally places all of this
# under its external build root, but direct makepkg invocations must not dirty
# the source checkout.
/packaging/arch/src/
/packaging/arch/pkg/
/packaging/arch/*.pkg.tar.*
/packaging/arch/*.src.tar.*
/packaging/arch/flutter-engine/src/
/packaging/arch/flutter-engine/pkg/
/packaging/arch/flutter-engine/*.pkg.tar.*
/packaging/arch/flutter-engine/*.src.tar.*
/packaging/arch/ui-development/src/
/packaging/arch/ui-development/pkg/
/packaging/arch/ui-development/*.pkg.tar.*
/packaging/arch/ui-development/*.src.tar.*

# Local-only cursor reference; its license prohibits redistribution.
/dart_shell/assets/cursors/yangyang_xuanling/
/profiling

# Local profiling bytecode and retained engine comparison artifacts.
/tools/__pycache__/
/prebuilt/flutter-engine/*/libflutter_engine.so.before-*
