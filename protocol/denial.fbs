// Denial custom platform bridge protocol.
//
// Generated code is committed. Bump protocol_version only for an intentional
// incompatible change. Never reuse a removed field id.

namespace Denial.Wire;

enum ObjectKind : ubyte {
  RootSurface = 0,
  Surface = 1
}

// The backing source for a logical desktop window. LocalFlutter windows have
// normal Denial identity, geometry and lifecycle, but their content is built
// by the embedded Dart shell instead of sampled from a client surface tree.
enum WindowContentKind : ubyte {
  SurfaceTree = 0,
  LocalFlutter = 1
}

// SurfaceLayer describes one node of the ordered surface tree belonging to a
// logical window. Popup roots remain part of their owning window instead of
// being exposed as synthetic top-level windows.
enum SurfaceRole : ubyte {
  Root = 0,
  Subsurface = 1,
  Popup = 2
}

// A window can carry alpha outside its visible content (for example client-side
// shadows) without being meaningfully translucent. Keep that distinct from
// content translucency so the shell does not allocate a full-window backdrop
// filter for decoration-only alpha.
enum WindowOpacityClass : ubyte {
  ContentTranslucent = 0,
  BorderAlphaOnly = 1,
  FullyOpaque = 2
}

enum WindowRequestKind : ubyte {
  ListWindows = 0,
  GetDisplayLayout = 1,
  CloseWindow = 2,
  FocusWindow = 3,
  ConfigureWindow = 4,
  CreateLocalWindow = 5,
  ConfigureSystemBar = 6
}

enum WindowResponseKind : ubyte {
  Windows = 0,
  DisplayLayout = 1
}

enum WindowEventKind : ubyte {
  WindowsChanged = 0,
  Activated = 1,
  Action = 2
}

enum WindowActionKind : ubyte {
  Minimize = 0,
  Maximize = 1,
  Restore = 2,
  ToggleMaximize = 3,
  ToggleFullscreen = 4
}

enum ShellActionKind : ubyte {
  Applications = 0,
  Overview = 1,
  WindowSwitcherNext = 2,
  WindowSwitcherEnd = 3,
  Clipboard = 4,
  ScreenshotRegion = 5,
  ScreenshotTextureReady = 6,
  ScreenshotDone = 7,
  ClientPointerPressed = 8,
  Wallpaper = 9,
  WindowSwitcherPrevious = 10,
  OpenSettings = 11,
  Dashboard = 12
}

enum KeyboardCommandKind : ubyte {
  Text = 0,
  Key = 1
}

enum SettingsRequestKind : ubyte {
  ReadDocument = 0,
  WriteDocument = 1,
  ReadKeyboard = 2,
  ConfigureKeyboard = 3,
  ReadShortcuts = 4,
  ValidateShortcut = 5,
  AddShortcut = 6,
  UpdateShortcut = 7,
  RemoveShortcut = 8,
  RestoreShortcuts = 9,
  ReadInputDevices = 10,
  ConfigureTouchpad = 11
}

enum SettingsResponseKind : ubyte {
  Document = 0,
  Keyboard = 1,
  Shortcuts = 2,
  ShortcutValidation = 3,
  InputDevices = 4
}

enum ShortcutActionKind : ubyte {
  Shutdown = 0,
  OpenApplications = 1,
  OpenOverview = 2,
  ToggleVerticalMaximize = 3,
  WindowSwitcher = 4,
  OpenClipboard = 5,
  CaptureRegion = 6,
  CloseWindow = 7,
  MinimizeWindow = 8,
  ToggleMaximize = 9,
  ToggleFullscreen = 10,
  ReleasePointer = 11,
  LockScreen = 12,
  VolumeUp = 13,
  VolumeDown = 14,
  VolumeMute = 15,
  BrightnessUp = 16,
  BrightnessDown = 17,
  NextKeyboardLayout = 18,
  PreviousKeyboardLayout = 19,
  OpenSettings = 20,
  OpenDashboard = 21,
  MinimizeAllWindows = 22
}

enum ShortcutInputKind : ubyte {
  Key = 0,
  Gesture = 1
}

enum ShortcutInputCategory : ubyte {
  Modifier = 0,
  Navigation = 1,
  Editing = 2,
  Punctuation = 3,
  Function = 4,
  Media = 5,
  Hardware = 6,
  Special = 7,
  Gesture = 8
}

enum ShortcutValidationKind : ubyte {
  Valid = 0,
  Conflict = 1,
  Invalid = 2
}

enum DesktopNotificationEventKind : ubyte {
  Added = 0,
  Replaced = 1,
  Closed = 2
}

enum DesktopNotificationUrgency : ubyte {
  Low = 0,
  Normal = 1,
  Critical = 2
}

enum DesktopNotificationCommandKind : ubyte {
  Dismiss = 0,
  InvokeAction = 1,
  InvokeDefault = 2
}

enum XEmbedTrayEventKind : ubyte {
  Added = 0,
  Updated = 1,
  Removed = 2
}

enum XEmbedTrayCommandKind : ubyte {
  Activate = 0,
  SecondaryActivate = 1,
  ContextMenu = 2
}

enum SystemBarSide : ubyte {
  Left = 0,
  Right = 1,
  Top = 2,
  Bottom = 3,
  Hidden = 4
}

struct WireRect {
  x:double;
  y:double;
  width:double;
  height:double;
}

struct WirePoint {
  x:double;
  y:double;
}

struct WireSize {
  width:double;
  height:double;
}

// InputLayout.flags:
//   bit 0: Flutter captures the keyboard
//   bit 1: Flutter shell is exclusive
//   bit 2: Flutter observes client pointer presses without consuming them
// InputWindowRegion.flags:
//   bit 0: visible
//   bit 1: hit-test disabled
//   bit 2: compositor geometry is locked
// Receivers ignore unknown input flag bits. A newer sender must not leave an
// older compositor stuck on its previous input snapshot.
struct InputWindowRegion {
  object_id:ulong;
  surface_id:ulong;
  window_id:ulong;
  rect:WireRect;
  source_rect:WireRect;
  z:int;
  flags:uint;
}

table InputLayout {
  epoch:ulong;
  flags:uint;
  shell_regions:[WireRect];
  windows:[InputWindowRegion];
  // All sampled surfaces currently visible in Flutter. This is intentionally
  // independent from hit-test regions: a negative-z subsurface can be visible
  // without ever being the input target.
  visible_surface_ids:[ulong];
  // Compositor-owned software-keyboard surfaces. Touching these regions must
  // preserve the active client editor instead of behaving like an outside tap.
  software_keyboard_regions:[WireRect];
}

table SurfaceLayer {
  surface_id:ulong;
  parent_surface_id:ulong;
  // Zero for the top-level surface tree. For a popup and all of its
  // subsurfaces this identifies the popup root used for input routing.
  popup_root_surface_id:ulong;
  role:SurfaceRole = Root;
  // Zero means the protocol node is mapped but does not currently have a
  // sampleable buffer. Keeping the node preserves popup input geometry.
  texture_id:ulong;
  width:uint;
  height:uint;
  surface_x:double;
  surface_y:double;
  surface_width:double;
  surface_height:double;
  texture_source_x:double;
  texture_source_y:double;
  texture_source_width:double;
  texture_source_height:double;
  transform:uint;
  scale_120:uint = 120;
  composition_order:uint;
  // Appended for wire compatibility. This combines the committed
  // alpha-modifier and compositor-surface opacity for this wl_surface.
  opacity:float = 1.0;
  // True only when the complete logical surface is guaranteed opaque.
  // Older senders default false so receivers conservatively keep effects.
  opaque:bool;
}

table Window {
  object_id:ulong;
  object_kind:ObjectKind = RootSurface;
  surface_id:ulong;
  window_id:ulong;
  texture_id:ulong;
  title:string;
  app_id:string;
  width:uint;
  height:uint;
  surface_x:double;
  surface_y:double;
  surface_width:double;
  surface_height:double;
  texture_source_x:double;
  texture_source_y:double;
  texture_source_width:double;
  texture_source_height:double;
  geometry_x:double;
  geometry_y:double;
  geometry_width:double;
  geometry_height:double;
  monitor_id:long = -1;
  transform:uint;
  scale_120:uint = 120;
  status_color_argb:uint;
  has_status_color:bool;
  // The content coordinate space used by every SurfaceLayer position.
  content_x:double;
  content_y:double;
  content_width:double;
  content_height:double;
  surfaces:[SurfaceLayer];
  // Appended for wire compatibility: older senders/receivers default false.
  pinned:bool;
  // X11 menus, tooltips and override-redirect popups are logical top-level
  // objects only because XWayland cannot attach them to an owning surface.
  // The shell must present them immediately, like native xdg_popup surfaces.
  suppress_animations:bool;
  // Appended for wire compatibility: older senders/receivers retain Denial's
  // original server-side frame policy.
  server_side_decorated:bool = true;
  // Opacity for the legacy primary-texture path. Surface-aware receivers use
  // the value carried by each SurfaceLayer instead.
  opacity:float = 1.0;
  // Appended for wire compatibility. SurfaceTree preserves the existing
  // Wayland/X11 behavior; LocalFlutter selects a trusted in-bundle app by
  // app_id and never treats texture_id == 0 as its discriminator.
  content_kind:WindowContentKind = SurfaceTree;
  // Appended for wire compatibility. Older senders conservatively default to
  // content translucency, preserving the previous blur behavior.
  opacity_class:WindowOpacityClass = ContentTranslucent;
}

table WindowSnapshot {
  windows:[Window];
  // Windows already published to the Flutter runtime that this one replaced.
  // The replacement shell reconstructs them without replaying their entrance;
  // windows mapped after the replacement are intentionally absent.
  // Appended for wire compatibility: older senders/receivers default empty.
  restored_window_ids:[ulong];
}

table DisplayOutput {
  monitor_id:long;
  name:string;
  logical_rect:WireRect;
  pixel_size:WireSize;
  source_rect:WireRect;
  scale:double = 1.0;
  refresh_rate:double = 60.0;
}

table DisplayLayout {
  epoch:ulong;
  global_origin:WirePoint;
  logical_size:WireSize;
  pixel_size:WireSize;
  engine_scale:double = 1.0;
  ticker_monitor_id:long = -1;
  system_bar_monitor_id:long = -1;
  system_bar_side:SystemBarSide = Left;
  outputs:[DisplayOutput];
  // Appended for wire compatibility: older senders/receivers keep a zero
  // thickness, which hides the shell system bar and reserves no work area.
  system_bar_thickness:double = 0.0;
  // Appended for wire compatibility: logical pixels of breathing room between
  // a maximized window and every output edge that does not carry the system
  // bar. Zero keeps maximized windows flush with the output edges.
  maximize_padding:double = 0.0;
  // Appended for wire compatibility. Each listed output hosts an independent
  // copy of the system bar. Older senders expose the first output through
  // system_bar_monitor_id only.
  system_bar_monitor_ids:[long];
}

table WindowRequest {
  kind:WindowRequestKind = ListWindows;
  window_id:ulong;
  geometry:WireRect;
  // CreateLocalWindow only. The app ID selects a builder registered in the
  // embedded shell; no executable name or Dart code crosses this boundary.
  app_id:string;
  title:string;
  // ConfigureSystemBar only. At least one unique live monitor is required;
  // the native compositor remains authoritative over the resolved layout.
  system_bar_side:SystemBarSide = Top;
  system_bar_monitor_ids:[long];
  // ConfigureWindow.flags bit 0 requests an exact compositor-owned viewport.
  // The native compositor ignores client size hints and retains this geometry
  // across client-authored maximize/fullscreen requests until a later normal
  // ConfigureWindow releases it.
  flags:uint;
}

table WindowResponse {
  kind:WindowResponseKind = Windows;
  success:bool = true;
  windows:WindowSnapshot;
  display_layout:DisplayLayout;
  error:string;
}

table WindowEvent {
  kind:WindowEventKind = WindowsChanged;
  window_id:ulong;
  action:WindowActionKind = Minimize;
}

table ShellAction {
  action:ShellActionKind = Applications;
  monitor_id:long = -1;
  has_monitor_id:bool;
  texture_id:long;
}

// Rust-authoritative software cursor state. Flutter cursor intents and
// Wayland set_cursor requests both resolve through this message.
table CursorShape {
  shape:string;
}

// Native pointer position updates that do not participate in Flutter hit
// testing. These keep Rust authoritative while a Wayland client, an xdg-popup
// seat grab, or drag-and-drop bypasses normal Flutter pointer routing.
table CursorPosition {
  x:double;
  y:double;
}

// Native-authoritative editor and software-keyboard state. An active editor
// is the protocol-level answer to whether the focused control accepts text;
// input_panel_visible additionally respects explicit client show/hide hints.
// Content metadata lets future keyboard layouts select text, number, URL,
// email, and password arrangements without inferring from application names.
table TextInputState {
  active:bool;
  input_panel_visible:bool;
  // True only for Denial's protocol-free focused-seat fallback. Consumers
  // may restrict that fallback without weakening real text-input clients.
  legacy:bool;
  content_hint:uint;
  content_purpose:uint;
}

// KeyboardCommand.flags: bit 0 means Ctrl is held; bit 1 is key press; bit 2
// is key release. Neither phase bit means a complete tap. Press and release
// are mutually exclusive, and modifiers are carried only by complete taps.
table KeyboardCommand {
  kind:KeyboardCommandKind = Text;
  text:string;
  key:string;
  flags:uint;
}

table KeyboardLayout {
  layout:string;
  variant:string;
  // Native XKB's human-readable group name. Requests leave this empty;
  // responses fill it from the keymap that is actually active on the seat.
  display_name:string;
}

table KeyboardConfiguration {
  layouts:[KeyboardLayout];
  options:[string];
  repeat_delay_ms:uint = 600;
  // Zero disables repeat, matching wl_keyboard.repeat_info.
  repeat_rate_hz:uint = 25;
  active_layout:uint;
}

table ShortcutDenialActionTarget {
  action:ShortcutActionKind = Shutdown;
}

table ShortcutSpawnTarget {
  // Program followed by its exact argument vector.
  command:[string];
  // Optional standard desktop-file ID. When present, Denial applies that
  // application's environment scope before exec without guessing from argv.
  desktop_file_id:string;
}

table ShortcutSpawnShTarget {
  // One command passed verbatim to `sh -c`.
  command:string;
}

union ShortcutTarget {
  ShortcutDenialActionTarget,
  ShortcutSpawnTarget,
  ShortcutSpawnShTarget
}

table ShortcutBinding {
  // Canonical shortcut text is the binding's unique identity.
  shortcut:string;
  target:ShortcutTarget;
}

table ShortcutInput {
  canonical:string;
  kind:ShortcutInputKind = Key;
  category:ShortcutInputCategory = Editing;
  aliases:[string];
}

table ShortcutConfiguration {
  shortcuts:[ShortcutBinding];
  supported_actions:[ShortcutActionKind];
  supported_inputs:[ShortcutInput];
}

table ShortcutValidation {
  kind:ShortcutValidationKind = Valid;
  canonical:string;
  conflict:ShortcutBinding;
  error:string;
}

table InputDeviceCapabilities {
  has_touchpad:bool;
  touchpad:TouchpadConfiguration;
}

table TouchpadConfiguration {
  tap_to_click_enabled:bool = true;
  natural_scroll_enabled:bool;
  scroll_speed_factor:double = 1.0;
}

table SettingsRequest {
  kind:SettingsRequestKind = ReadDocument;
  expected_revision:ulong;
  // WriteDocument only. Keyboard is native-owned and ignored if echoed here.
  document:string;
  // ConfigureKeyboard only.
  keyboard:KeyboardConfiguration;
  // ValidateShortcut, AddShortcut and UpdateShortcut.
  shortcut:ShortcutBinding;
  // The current canonical identity for editing/removing a binding. Validation
  // uses it to exclude the row currently being edited from conflict checks.
  existing_shortcut:string;
  // ConfigureTouchpad only.
  touchpad:TouchpadConfiguration;
}

table SettingsResponse {
  kind:SettingsResponseKind = Document;
  success:bool = true;
  revision:ulong;
  document:string;
  keyboard:KeyboardConfiguration;
  error:string;
  shortcuts:ShortcutConfiguration;
  shortcut_validation:ShortcutValidation;
  input_devices:InputDeviceCapabilities;
}

table DesktopNotificationAction {
  key:string;
  label:string;
}

table DesktopNotificationImageData {
  width:uint;
  height:uint;
  row_stride:uint;
  has_alpha:bool;
  bits_per_sample:ubyte = 8;
  channels:ubyte;
  data:[ubyte];
}

// Normalized org.freedesktop.Notifications data. Unknown D-Bus hints stay on
// the native side rather than crossing the bridge as arbitrary variants.
table DesktopNotification {
  id:uint;
  sender:string;
  app_name:string;
  app_icon:string;
  summary:string;
  body:string;
  actions:[DesktopNotificationAction];
  urgency:DesktopNotificationUrgency = Normal;
  category:string;
  desktop_entry:string;
  image_path:string;
  image_data:DesktopNotificationImageData;
  resident:bool;
  transient:bool;
  suppress_sound:bool;
  action_icons:bool;
  sound_name:string;
  sound_file:string;
  x:int;
  y:int;
  has_position:bool;
  progress:int;
  has_progress:bool;
  expire_timeout_ms:int = -1;
}

table DesktopNotificationEvent {
  kind:DesktopNotificationEventKind = Added;
  notification:DesktopNotification;
  notification_id:uint;
  close_reason:uint;
}

table DesktopNotificationCommand {
  kind:DesktopNotificationCommandKind = Dismiss;
  notification_id:uint;
  action_key:string;
}

// A bounded snapshot of one legacy XEmbed icon hosted inside Xwayland. Pixels
// are premultiplied RGBA8888 so Flutter never has to sample an off-screen X11
// surface directly.
table XEmbedTrayIcon {
  window_id:uint;
  title:string;
  width:uint;
  height:uint;
  rgba:[ubyte];
}

table XEmbedTrayEvent {
  kind:XEmbedTrayEventKind = Added;
  window_id:uint;
  icon:XEmbedTrayIcon;
}

table XEmbedTrayCommand {
  kind:XEmbedTrayCommandKind = Activate;
  window_id:uint;
  x:int;
  y:int;
}

// Effective, fully resolved visual state from the embedded shell. This is not
// user-editable settings data: Flutter owns wallpaper accent extraction while
// deniald remains authoritative for publishing the result to desktop clients.
table ThemeState {
  // Opaque sRGB packed as 0x00RRGGBB. The high byte must remain zero.
  accent_srgb:uint;
}

union Payload {
  InputLayout,
  WindowSnapshot,
  DisplayLayout,
  WindowRequest,
  WindowResponse,
  WindowEvent,
  ShellAction,
  CursorShape,
  KeyboardCommand,
  CursorPosition,
  DesktopNotificationEvent,
  DesktopNotificationCommand,
  SettingsRequest,
  SettingsResponse,
  TextInputState,
  XEmbedTrayEvent,
  XEmbedTrayCommand,
  ThemeState
}

table Envelope {
  protocol_version:ushort = 1;
  sequence:ulong;
  request_id:ulong;
  payload:Payload;
}

root_type Envelope;
file_identifier "DENW";
file_extension "denw";
