 void RasterCache::Clear() {
   cache_.clear();
   picture_metrics_ = {};
   layer_metrics_ = {};
+  audit_unique_display_lists_.clear();
+  audit_forced_display_lists_.clear();
+}
+
+void RasterCache::RecordDisplayListAudit(uint64_t unique_id,
+                                         bool is_complex,
+                                         bool will_change,
+                                         bool accepted,
+                                         unsigned int complexity_score) const {
+  if (!audit_enabled_) {
+    return;
+  }
+  audit_display_list_observations_++;
+  audit_unique_display_lists_.insert(unique_id);
+  if (is_complex) {
+    audit_forced_observations_++;
+    audit_forced_display_lists_.insert(unique_id);
+  }
+  if (accepted) {
+    audit_display_list_accepted_++;
+  } else if (will_change) {
+    audit_display_list_rejected_will_change_++;
+  } else if (complexity_score > 0) {
+    audit_display_list_rejected_cost_++;
+  } else {
+    audit_display_list_rejected_other_++;
+  }
+}
+
+void RasterCache::ReportAuditAndReset() const {
+  FML_LOG(INFO) << "Denial render_audit source=engine event=raster_cache"
+                << " frames=" << audit_frames_
+                << " dl_observations=" << audit_display_list_observations_
+                << " dl_unique_ids=" << audit_unique_display_lists_.size()
+                << " dl_forced_observations=" << audit_forced_observations_
+                << " dl_forced_unique_ids="
+                << audit_forced_display_lists_.size()
+                << " dl_accepted=" << audit_display_list_accepted_
+                << " dl_rejected_cost=" << audit_display_list_rejected_cost_
+                << " dl_rejected_will_change="
+                << audit_display_list_rejected_will_change_
+                << " dl_rejected_other=" << audit_display_list_rejected_other_
+                << " mark_seen=" << audit_mark_seen_
+                << " new_entries=" << audit_new_entries_
+                << " picture_creations=" << audit_picture_creations_
+                << " forced_picture_creations="
+                << audit_forced_picture_creations_
+                << " layer_creations=" << audit_layer_creations_
+                << " draw_hits=" << audit_draw_hits_
+                << " draw_misses=" << audit_draw_misses_
+                << " forced_draw_hits=" << audit_forced_draw_hits_
+                << " forced_draw_misses=" << audit_forced_draw_misses_
+                << " evictions=" << audit_evictions_
+                << " image_evictions=" << audit_image_evictions_
+                << " live_entries=" << cache_.size()
+                << " picture_images=" << picture_metrics_.total_count()
+                << " picture_bytes=" << picture_metrics_.total_bytes()
+                << " layer_images=" << layer_metrics_.total_count()
+                << " layer_bytes=" << layer_metrics_.total_bytes();
+
+  audit_frames_ = 0;
+  audit_display_list_observations_ = 0;
+  audit_forced_observations_ = 0;
+  audit_display_list_accepted_ = 0;
+  audit_display_list_rejected_cost_ = 0;
+  audit_display_list_rejected_will_change_ = 0;
+  audit_display_list_rejected_other_ = 0;
+  audit_mark_seen_ = 0;
+  audit_new_entries_ = 0;
+  audit_picture_creations_ = 0;
+  audit_forced_picture_creations_ = 0;
+  audit_layer_creations_ = 0;
+  audit_draw_hits_ = 0;
+  audit_draw_misses_ = 0;
+  audit_forced_draw_hits_ = 0;
+  audit_forced_draw_misses_ = 0;
+  audit_evictions_ = 0;
+  audit_image_evictions_ = 0;
+  audit_unique_display_lists_.clear();
+  audit_forced_display_lists_.clear();
 }
 
