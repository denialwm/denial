From 5097a648e9bbb1d4a7fdf06a2a6d7bef3c9dd414 Mon Sep 17 00:00:00 2001
From: Doctor Logix <doctor.logix@gmail.com>
Date: Sat, 25 Jul 2026 12:06:55 +0200
Subject: [PATCH] Use highp coordinates for partial DMSAA loads

Use high-precision vertex positions, texture coordinates, and transforms in Ganesh's internal GL copy program. Mediump precision cannot address individual pixels across Denial's wide atlas and shifts partial dynamic-MSAA preservation loads.
---
 src/gpu/ganesh/gl/GrGLGpu.cpp | 28 ++++++++++++++++------------
 1 file changed, 16 insertions(+), 12 deletions(-)

diff --git a/engine/src/flutter/third_party/skia/src/gpu/ganesh/gl/GrGLGpu.cpp b/engine/src/flutter/third_party/skia/src/gpu/ganesh/gl/GrGLGpu.cpp
index a080eec57ede8eccb1eea103f5fed895d7108e52..cb15b26a425f6cb39218de16b1a46a594f146270 100644
--- a/engine/src/flutter/third_party/skia/src/gpu/ganesh/gl/GrGLGpu.cpp
+++ b/engine/src/flutter/third_party/skia/src/gpu/ganesh/gl/GrGLGpu.cpp
@@ -3322,12 +3322,17 @@ bool GrGLGpu::createCopyProgram(GrTexture* srcTex) {
         return false;
     }
 
-    GrShaderVar aVertex("a_vertex", SkSLType::kHalf2, GrShaderVar::TypeModifier::In);
-    GrShaderVar uTexCoordXform("u_texCoordXform", SkSLType::kHalf4,
-                               GrShaderVar::TypeModifier::Uniform);
-    GrShaderVar uPosXform("u_posXform", SkSLType::kHalf4, GrShaderVar::TypeModifier::Uniform);
+    // Partial dynamic-MSAA loads copy an arbitrary native-device rectangle.
+    // Mediump coordinates cannot address individual pixels on wide targets:
+    // around 1.0, binary16 steps are five pixels apart on a 5120px atlas.
+    // Keep color math at its normal precision, but use highp for the geometry,
+    // texture coordinates and transforms that define this exact 1:1 copy.
+    GrShaderVar aVertex("a_vertex", SkSLType::kFloat2, GrShaderVar::TypeModifier::In);
+    GrShaderVar uTexCoordXform(
+            "u_texCoordXform", SkSLType::kFloat4, GrShaderVar::TypeModifier::Uniform);
+    GrShaderVar uPosXform("u_posXform", SkSLType::kFloat4, GrShaderVar::TypeModifier::Uniform);
     GrShaderVar uTexture("u_texture", samplerType);
-    GrShaderVar vTexCoord("v_texCoord", SkSLType::kHalf2, GrShaderVar::TypeModifier::Out);
+    GrShaderVar vTexCoord("v_texCoord", SkSLType::kFloat2, GrShaderVar::TypeModifier::Out);
     GrShaderVar oFragColor("o_FragColor", SkSLType::kHalf4, GrShaderVar::TypeModifier::Out);
 
     SkString vshaderTxt;
@@ -3348,13 +3353,12 @@ bool GrGLGpu::createCopyProgram(GrTexture* srcTex) {
     vshaderTxt.append(";");
 
     vshaderTxt.append(
-        // Copy Program VS
-        "void main() {"
-          "v_texCoord = half2(a_vertex.xy * u_texCoordXform.xy + u_texCoordXform.zw);"
-          "sk_Position.xy = a_vertex * u_posXform.xy + u_posXform.zw;"
-          "sk_Position.zw = half2(0, 1);"
-        "}"
-    );
+            // Copy Program VS
+            "void main() {"
+            "v_texCoord = float2(a_vertex.xy * u_texCoordXform.xy + u_texCoordXform.zw);"
+            "sk_Position.xy = a_vertex * u_posXform.xy + u_posXform.zw;"
+            "sk_Position.zw = float2(0, 1);"
+            "}");
 
     SkString fshaderTxt;
     if (shaderCaps->fNoPerspectiveInterpolationSupport) {
